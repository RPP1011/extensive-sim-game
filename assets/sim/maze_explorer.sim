// maze_explorer — one Adventurer agent random-walks a 4×4 maze of
// rooms until it reaches the key room. The maze topology is
// declared as a top-level `table` (the proper "world data" home for
// static lookups — rooms are NOT agents). Authored as a single
// 16-element initializer instead of the 16-arm nested if-else the
// pre-table version baked into the kernel.
//
// Outcome: ticks-to-key on a deterministic seed. The pin runs the
// step loop until `found_key == 1` and asserts a tick budget;
// determinism is verified by re-running and pinning the same
// tick_found value.
//
// Schema (single Adventurer agent):
//   * current_room: u32 — room id 0..15 the Adventurer occupies.
//   * found_key: u32 — 0 while searching, 1 after reaching key
//     room. Gates the per-tick rule so it's a no-op once done.
//   * tick_found: u32 — the tick on which found_key flipped 0→1.
//
// Per-tick:
//   1. Look up current room's door bitmap via tables.maze_doors(...)
//   2. Roll a uniform direction (rng.action() % 4)
//   3. If door open in that direction, move; else stay (bump wall)
//   4. If new room == key room, latch found_key + tick_found
//
// Maze layout (4×4 grid; → is "has door to", * = key room):
//
//   0(0,0) ─── 1(1,0) ─── 2(2,0) ─── 3(3,0)
//     │          │                      │
//   4(0,1)    5(1,1) ─── 6(2,1)      7(3,1)
//     │          │                      │
//   8(0,2)    9(1,2)    10(2,2)     11(3,2)
//                │          │           │
//  12(0,3) ── 13(1,3) ── 14(2,3) ─── 15(3,3)*
//
//   Shortest path 0 → 15: 0→1→2→3→7→11→15 (6 steps).
//
// Door encoding: bit 0=N (room−4), 1=S (room+4), 2=E (room+1), 3=W (room−1).
// Symmetric: if A has door D to B, B has door (D̄) to A.

event Tick { }

entity Adventurer : Agent { }

field current_room: u32
field found_key: u32
field tick_found: u32

// World data — door bitmaps per room (room_id → exit bitmap).
// Table values match the diagram above; comments call out each
// room's open sides for at-a-glance verification.
//
//   0:  E|S            = 6        8:  N              = 1
//   1:  W|E|S          = 14       9:  N|S            = 3
//   2:  W|E            = 12       10: S              = 2
//   3:  W|S            = 10       11: N|S            = 3
//   4:  N|S            = 3        12: E              = 4
//   5:  N|E|S          = 7        13: N|E|W          = 13
//   6:  W              = 8        14: N|W            = 9
//   7:  N|S            = 3        15: N              = 1
table maze_doors: u32[16] = [
  6, 14, 12, 10,
  3,  7,  8,  3,
  1,  3,  2,  3,
  4, 13,  9,  1,
]

config maze {
  // Slot id of the key room. The per-tick rule reads this to know
  // when to latch.
  key_room: u32 = 15,
}

@phase(per_agent)
physics Explore {
  on Tick {} where (
    self.alive
    && self.found_key == 0u
  ) {
    let doors = tables.maze_doors(self.current_room);
    let dir = rng.action() % 4u;
    // Direction → door-bit mapping (nested else because the DSL
    // surface doesn't accept `else if` chains today).
    let bit = if (dir == 0u) {
      1u  // N
    } else {
      if (dir == 1u) {
        2u  // S
      } else {
        if (dir == 2u) {
          4u  // E
        } else {
          8u  // W
        }
      }
    };
    if ((doors & bit) != 0u) {
      let next_room = if (dir == 0u) {
        self.current_room - 4u
      } else {
        if (dir == 1u) {
          self.current_room + 4u
        } else {
          if (dir == 2u) {
            self.current_room + 1u
          } else {
            self.current_room - 1u
          }
        }
      };
      agents.set_current_room(self, next_room);
      if (next_room == config.maze.key_room) {
        agents.set_found_key(self, 1u);
        agents.set_tick_found(self, world.tick);
      }
    }
  }
}
