// tom_probe — Theory-of-Mind end-to-end probe (post-fix shape).
//
// **Outcome target: (a) FULL FIRE.** Per-(observer, subject) belief
// flag bitset is materialized as a `pair_map`-storage
// `view beliefs_flags(...) -> u32`. Each tick every alive Knower
// emits a `BeliefAcquired` event with `fact_bit = 1`; the view's
// bit-OR accumulator (`self |= b`) folds them into
// `beliefs_flags(self, self)`. The runtime reads back the primary
// storage and asserts the diagonal converged to `1u` while every
// off-diagonal slot stayed `0u`.
//
// Sidesteps the AST-level `BeliefsAccessor` + `theory_of_mind.
// believes_knows` namespace gaps by routing belief mutations through
// regular events + view-fold infrastructure (P6: events ARE the
// mutation channel). The pre-fix version of this file probed those
// AST surfaces directly and dropped at lower time — see git history
// for the discovery shape and `docs/superpowers/notes/2026-05-04-
// tom-probe.md` for the gap chain.
//
// Compiler extensions this fixture exercises (all landed by the same
// PR that flipped this fixture's outcome):
//   1. `view <name>(...) -> u32` return type plumbed through
//      `populate_view_bodies_and_signatures` → `view_signatures.
//      result == CgTy::U32`.
//   2. `|=` self-update operator accepted at parse + resolve + view
//      lower (alongside the existing `+=` family).
//   3. `pair_map` storage hint composes a 2-D index
//      `local_obs * cfg.second_key_pop + local_sub` per the existing
//      predator_focus fold-body shape.
//   4. WGSL emit branches on `view_signatures.result` — `u32` views
//      use `atomicOr(&storage[idx], rhs)` (commutative + associative
//      → P11 trivial); `f32` views keep the existing CAS+add loop.
//
// Wave 3 ToM Phase 2 — multi-field BeliefState SoA.
// ----------------------------------------------------------------
// The single-u32 `beliefs` view from Phase 1 is now `beliefs_flags`;
// the `_flags` suffix names the bit-OR slot in the multi-field
// BeliefState (per `docs/spec/ability_dsl_test_sims.md` spy_network).
// The other 5 fields (`last_known_pos`, `last_known_creature_type`,
// `last_seen_tick`, `confidence`, `suspicion`) are stored
// runtime-side as parallel SoA columns by `tom_probe_runtime` —
// Phase 2 is a storage + read-accessor slice (no new writer verbs;
// those land in Phase 3 alongside the spec's `agents.beliefs(o, s).
// <field>` struct-then-field access syntax). The Phase 1 fold path
// is unchanged: only `beliefs_flags` carries an event-fold writer
// today, and the runtime exposes `beliefs_pos()`, `beliefs_type()`,
// `beliefs_tick()`, `beliefs_confidence()`, `beliefs_suspicion()`
// reader methods plus test-only setters that pre-seed each column
// for the `belief_state_soa_pin.rs` regression pin.
//
// The 5 other-field views are NOT declared as `@materialized` views
// in this fixture for Phase 2 — declaring them would produce 5
// extra fold kernels with no producers (the writer verbs that emit
// the corresponding `EffectScryApplied` / `EffectObserveApplied`
// events land in Phase 3). The runtime allocates the buffers
// directly so the SoA isolation property can be exercised today,
// and the spec's `agents.beliefs_<field>(observer, subject)`
// view-call lowering is deferred to Phase 3 alongside the writer
// verbs that need to address those buffers from kernels.

event Tick { }

// Per-event belief acquisition record. Each emission OR's `fact_bit`
// into `beliefs_flags(observer, subject)`. `fact_bit` is pre-shifted
// by the producer (e.g. `1u << fact_id`) so the view body itself
// doesn't need shift-arithmetic — matches the bare-bones u32
// accumulator shape the probe targets.
@replayable
@gpu_amenable
event BeliefAcquired {
  observer: AgentId,
  subject:  AgentId,
  fact_bit: u32,
}

entity Knower : Agent {
  pos: vec3,
  vel: vec3,
}

// Per-(observer, subject) belief flag bitset (`flags` slot of the
// BeliefState SoA). Storage = `pair_map`, so the fold body indexes
// `view_storage_primary[observer * agent_cap + subject]`. With
// agent_cap = N the storage is N×N×u32. Initial 0 (no beliefs);
// clamp covers the full u32 range (the bit-OR accumulator can never
// exceed 0xFFFFFFFFu). Renamed from `beliefs` → `beliefs_flags` in
// Wave 3 ToM Phase 2 to disambiguate from the 5 other BeliefState
// fields living runtime-side (see header).
@materialized(on_event = [BeliefAcquired], storage = pair_map)
view beliefs_flags(observer: Agent, subject: Agent) -> u32 {
  initial: 0,
  on BeliefAcquired { observer: o, subject: s, fact_bit: b } { self |= b }
  clamp: [0, 4294967295],
}

// Producer: every alive Knower emits one `BeliefAcquired { self,
// self, 1 }` per tick. The view's bit-OR fold turns this into
// "beliefs_flags(i, i) has bit 0 set" after the first tick — and
// stays that way (bit-OR is idempotent on a bit that's already
// set). The off-diagonal `beliefs_flags(i, j != i)` cells stay at 0
// forever because no event with (observer=i, subject=j) is ever
// emitted.
//
// FULL FIRE observable (asserted by tom_probe_app):
//   - beliefs_flags[i * N + i] == 1u for every i in 0..N
//   - beliefs_flags[i * N + j] == 0u for every i != j
physics WhatIBelieve @phase(per_agent) {
  on Tick {} where (self.alive) {
    emit BeliefAcquired { observer: self, subject: self, fact_bit: 1 }
  }
}

// Wave 3 ToM Phase 3.7 — DSL-authored demo rule
// `ApplyTickBeliefStamp` was retired in Phase 3.8 (this commit). The
// rule unilaterally stamped `beliefs_last_seen_tick[i*N+i] = 1` every
// tick from the unconditional `BeliefAcquired` producer fanout, which
// clashes with the `observe_round_trip_pin` per-cell isolation
// assertion (every off-target cell stays 0 between observe calls).
// Pre-3.8 the rule was effectively dead at runtime — the hand-written
// `OBSERVE_WGSL` const triggered naga validation
// (`name 'target' is a reserved keyword`), causing
// `TomProbeState::new()` to panic, the round-trip test caught it via
// `try_new()` and skipped with "no wgpu adapter". With the
// hand-written kernel retired in favour of the .sim-authored consumers
// below, the demo rule would fire and break the regression pin's
// isolation invariant. The 3 chronicle-driven consumers below
// (ApplyObserveBeliefUpdate / ApplyScryBeliefUpdate /
// ApplyRevealBeliefUpdate) supersede it: they write the BeliefState
// SoA only when an explicit observe / scry / reveal verb fires.

// Wave 3 ToM Phase 3.8 — chronicle-event consumer rules that retire
// the hand-written WGSL kernels in `tom_probe_runtime/src/lib.rs`
// (`OBSERVE_WGSL` / `SCRY_WGSL` / `REVEAL_WGSL`). The 3 chronicle
// event kinds are engine-aliased (EffectObserveApplied=64,
// EffectScryApplied=65, EffectRevealApplied=66 in
// `dsl_ast::engine_events`); the runtime's `observe()`, `scry()`,
// `reveal()` methods now write a synthetic 10-word chronicle record
// into `event_ring` via `EventRing::append_chronicle_record()` and
// dispatch THESE consumer kernels instead of the retired
// hand-written-WGSL pipelines.
//
// Field-position contract (matches the chronicle dispatcher's
// `apply_event_to_chronicle_record` shape, see
// `crates/dsl_compiler/src/cpu_chronicle_reference.rs`):
//   * EffectObserveApplied: actor=slot 2 (observer), target=slot 3,
//     target_observer=slot 4 (unused — single-observer self).
//   * EffectScryApplied: actor=slot 2 (caster), subject=slot 3,
//     target_observer=slot 4 (the source observer), subject_idx=slot 5.
//   * EffectRevealApplied: actor=slot 2 (caster), subject=slot 3,
//     subject_idx=slot 4 (= subject; redundant on the wire).

@replayable
event EffectObserveApplied {
  actor: AgentId,
  target: AgentId,
  target_observer: u32,
}

@replayable
event EffectScryApplied {
  actor: AgentId,
  subject: AgentId,
  target_observer: u32,
  subject_idx: u32,
}

@replayable
event EffectRevealApplied {
  actor: AgentId,
  subject: AgentId,
  subject_idx: u32,
}

// Observe consumer — agent A learns agent T's current state. Reads
// target T's CURRENT pos / creature_type from the agent SoA (via the
// engine's `agents.pos(t)` / `agents.creature_type(t)` accessors) and
// stamps:
//   * beliefs_pos[a * N + t]        ← agents.pos(t)
//   * beliefs_creature_type[a * N + t] ← agents.creature_type(t)
//   * beliefs_last_seen_tick[a * N + t] ← world.tick (= cfg.tick;
//     but the chronicle event payload is the tick the dispatcher
//     wrote, which is the consume tick — same value)
//   * beliefs_confidence[a * N + t] ← 255 (q8 max — fresh observation)
// Leaves beliefs_flags (Phase 1 bit-OR slot) and beliefs_suspicion
// (Phase 4 deception channel) unchanged.
physics ApplyObserveBeliefUpdate @phase(post) {
  on EffectObserveApplied { actor: a, target: t, target_observer: _ } {
    agents.set_beliefs_pos(a, t, agents.pos(t));
    agents.set_beliefs_creature_type(a, t, agents.creature_type(t));
    agents.set_beliefs_last_seen_tick(a, t, world.tick);
    agents.set_beliefs_confidence(a, t, 255);
  }
}

// Scry consumer — caster A reads agent O's belief row about subject S
// and copies the 6-column tuple verbatim into A's row about S. The
// `o` binder comes from the chronicle's `target_observer` (slot 4)
// — NOT from the `subject` field (slot 3, = `s` here, redundant with
// the explicit `subject_idx` slot 5 alias).
physics ApplyScryBeliefUpdate @phase(post) {
  on EffectScryApplied { actor: a, subject: _, target_observer: o, subject_idx: s } {
    agents.set_beliefs_pos(a, s, agents.beliefs_pos(o, s));
    agents.set_beliefs_creature_type(a, s, agents.beliefs_creature_type(o, s));
    agents.set_beliefs_last_seen_tick(a, s, agents.beliefs_last_seen_tick(o, s));
    agents.set_beliefs_confidence(a, s, agents.beliefs_confidence(o, s));
    agents.set_beliefs_suspicion(a, s, agents.beliefs_suspicion(o, s));
    agents.set_beliefs_flags(a, s, agents.beliefs_flags(o, s));
  }
}

// Reveal consumer — caster A broadcasts its beliefs about subject S
// to one observer slot (= chronicle event's `actor`+`target_observer`
// pair, fanned out by the runtime side as one event per (caster,
// observer) pair from the AOE-style multi-target dispatch). The
// runtime queues N synthetic events (one per observer slot in
// 0..agent_count) — the consumer body sees them as N separate
// EffectRevealApplied events, each writing its own observer cell.
//
// Field-binding note: `target` (slot 3) is reused as the observer
// destination (so the 4-payload chronicle stays the same physical
// shape as a 1-target reveal), and `subject_idx` (slot 4) carries
// the subject id. `actor` (slot 2) is the caster (source row).
physics ApplyRevealBeliefUpdate @phase(post) {
  on EffectRevealApplied { actor: a, subject: o, subject_idx: s } {
    agents.set_beliefs_pos(o, s, agents.beliefs_pos(a, s));
    agents.set_beliefs_creature_type(o, s, agents.beliefs_creature_type(a, s));
    agents.set_beliefs_last_seen_tick(o, s, agents.beliefs_last_seen_tick(a, s));
    agents.set_beliefs_confidence(o, s, agents.beliefs_confidence(a, s));
    agents.set_beliefs_suspicion(o, s, agents.beliefs_suspicion(a, s));
    agents.set_beliefs_flags(o, s, agents.beliefs_flags(a, s));
  }
}

// -------------------------------------------------------------------
// Wave 3 ToM Phase 4 — deception verbs (Decoy / EraseBelief).
// -------------------------------------------------------------------
//
// Two engine-aliased event types whose dispatch arms write the
// corresponding chronicle records (kinds 68/69 — see
// `dsl_ast::engine_events::ENGINE_EVENT_KIND_IDS`); the consumer rules
// below mirror Phase 3.8's authoring shape (`@phase(post)` runs after
// the producer kernels, reads the chronicle event ring, mutates the
// BeliefState SoA via the existing `agents.set_beliefs_<field>`
// setters).
//
// Disguise (kind 67) ships its dispatcher arm + chronicle record + pin
// in this slice — the per-agent SoA columns and observe-consumer
// integration are deferred (the chronicle record carries the packed
// payload but no consumer rule reads it from the .sim today). See
// `disguise_chronicle_pin.rs` for the dispatcher-side pin.

// Decoy — caster A writes attacker-controlled belief values into
// observer T's row about `subject_idx`. The chronicle event payload
// carries:
//   * actor=slot 2 (caster A — informational only; the consumer doesn't
//     read agent SoA, all values come from the event payload),
//   * target=slot 3 (the OBSERVER whose row gets clobbered),
//   * subject_idx=slot 4 (the agent slot the belief is ABOUT — distinct
//     from `target`),
//   * fake_pos=slot 5 (packed (x_q8, y_q8, z_q8, fake_type) quartet —
//     the consumer unpacks bytes via shift/mask to f32 q8-decoded pos
//     coords + a u8 fake_type).
//
// The consumer writes 4 cells of target's belief row about subject_idx:
// `last_known_pos` (decoded from the packed quartet), `last_known_creature_type`
// (= fake_type byte), `last_seen_tick` (= world.tick, matching observe's
// "this is fresh" semantic), `confidence` (= 255 q8 max). Leaves the
// suspicion + flags slots unchanged — Decoy is a positional / identity
// fake, not a slander or knowledge claim.
@replayable
event EffectDecoyApplied {
  actor: AgentId,
  target: AgentId,
  subject_idx: u32,
  fake_pos: u32,
}

physics ApplyDecoyBeliefUpdate @phase(post) {
  on EffectDecoyApplied { actor: _, target: t, subject_idx: s, fake_pos: p } {
    // Unpack the 4 packed bytes from `p`. The mul-by-1.0 promotes
    // the u32 byte values to f32 via the existing `promote_int_to_f32`
    // path (the DSL's vec3 ctor requires f32 args; no surface
    // `f32(...)` cast builtin today). The high byte is the fake
    // creature_type (kept as u32 — the setter packs to a u8 byte).
    // 16777216 = 1<<24, 65536 = 1<<16, 256 = 1<<8.
    let fx = (p % 256) * 1.0;
    let fy = ((p / 256) % 256) * 1.0;
    let fz = ((p / 65536) % 256) * 1.0;
    let ft = (p / 16777216) % 256;
    agents.set_beliefs_pos(t, s, vec3(fx, fy, fz));
    agents.set_beliefs_creature_type(t, s, ft);
    agents.set_beliefs_last_seen_tick(t, s, world.tick);
    agents.set_beliefs_confidence(t, s, 255);
  }
}

// EraseBelief — caster A clears specific cells of observer T's row
// about `subject_idx` per the `fields` bitset. Each bit corresponds to
// one BeliefState column (bit 0 = pos, 1 = type, 2 = tick, 3 =
// confidence, 4 = suspicion, 5 = flags). The consumer body emits 6
// `if ((f & bit) != 0) { setter(0) }` blocks — one per column.
//
// Field binding mirrors Decoy: `target` (slot 3) is the OBSERVER whose
// row caster clears; `subject_idx` (slot 4) is the agent slot the
// belief is ABOUT; `fields` (slot 5) is the u8-in-u32 bitset.
@replayable
event EffectEraseBeliefApplied {
  actor: AgentId,
  target: AgentId,
  subject_idx: u32,
  fields: u32,
}

physics ApplyEraseBeliefUpdate @phase(post) {
  on EffectEraseBeliefApplied { actor: _, target: t, subject_idx: s, fields: f } {
    // Bit-test via modulo + division — the DSL parser doesn't accept
    // `u` integer suffixes (e.g. `1u`) on bare literals today, and
    // `&` bitwise-and with bare ints would force the rhs to f32 in
    // mixed contexts. `(f / N) % 2` is the bit-N extract analogue.
    if (f % 2 != 0) {
      agents.set_beliefs_pos(t, s, vec3(0.0, 0.0, 0.0));
    }
    if ((f / 2) % 2 != 0) {
      agents.set_beliefs_creature_type(t, s, 0);
    }
    if ((f / 4) % 2 != 0) {
      agents.set_beliefs_last_seen_tick(t, s, 0);
    }
    if ((f / 8) % 2 != 0) {
      agents.set_beliefs_confidence(t, s, 0);
    }
    if ((f / 16) % 2 != 0) {
      agents.set_beliefs_suspicion(t, s, 0);
    }
    if ((f / 32) % 2 != 0) {
      agents.set_beliefs_flags(t, s, 0);
    }
  }
}
