// belief_smoke_probe — Plan I end-to-end fixture for the `belief`
// primitive across all 10 landed slices: I.1 (parser + AST), I.2
// (resolver + signature validation), I.3 (CG lowering + PairMap
// inference), I.3a (single-key shape via param-count gate), I.3c
// (`@per_entity_ring` storage), I.4a (BeliefSocialMerge IR
// wiring — kernel body still a stub for I.4b).
//
// **What this fixture covers as of Plan I.4a (2026-05-16):**
//   * Pair-keyed propagation handler (`belief seen` → ViewFold op).
//   * Social-merge clause (`belief seen` → BeliefSocialMerge op,
//     stub WGSL body until I.4b).
//
// **MVP scope (today).** Pair-keyed `(observer: Agent, subject:
// Agent) -> u32` storage. Single-key beliefs are also supported
// (slice I.3a) but kept out of this smoke probe to keep the test
// focused on a single belief shape.
//
// **What the fixture proves end-to-end:**
//   1. `belief seen(observer, subject) -> u32` parses + resolves +
//      lowers without falling back to `view`.
//   2. The auto-emitted `view_storage_primary_buf` is sized for the
//      full pair-map shape (agent_count^2 u32 cells, mirroring the
//      tom_probe `pair_map` sizing pin).
//   3. The propagation handler fires on `SubjectSeen` events and
//      sets the matching `[observer, subject]` cell to a non-zero
//      value the host can read back.
//
// **Behavioural pin shape (smoke).** AGENT_COUNT = 4. Each tick every
// alive agent emits `SubjectSeen { observer: self, subject: 0, mark:
// 1u }`. After one tick the `[i, 0]` column should be set on every
// alive observer slot; cells off the column stay 0.

event Tick { }

event SubjectSeen {
  observer: Agent,
  subject: Agent,
  mark: u32,
}

entity Probe : Agent {
  // Implicit Agent payload (pos, alive, etc.). No extra fields needed
  // — the fixture's only job is to fold SubjectSeen records into the
  // belief's pair-keyed storage.
}

// Every alive agent emits one SubjectSeen against subject 0 per tick.
// Dispatches per-agent so each slot fires its own event.
@phase(per_agent)
physics EmitSeen {
  on Tick {} where (self.alive) {
    emit SubjectSeen {
      observer: self,
      subject: 0,
      mark: 1,
    }
  }
}

// AllyDied event drives the social-merge clause below — when an ally
// dies, every receiver bitwise-ORs the dying ally's seen-bitmap into
// their own. Models the dungeon_horde party-wide gossip pattern that
// I.6 will migrate.
event AllyDied {
  dead: Agent,
}

// The belief under test. Pair-keyed `(observer, subject) -> u32`
// bitmap with one propagation handler + one social-merge clause.
//
// * Propagation: every alive observer that emits SubjectSeen folds
//   the `mark` bit into their own [observer, subject] cell (slice I.3
//   ViewFold path).
//
// * Social-merge: when AllyDied fires with `dead: d`, every receiver
//   merges the dying ally's row into their own via bit_or — `seen[r,
//   *] |= seen[d, *]` for every r (I.4a IR wiring; the actual
//   per-cell dispatch is stubbed until I.4b lands).
@materialized(on_event = [SubjectSeen], storage = pair_map)
belief seen(observer: Agent, subject: Agent) -> u32 {
  initial: 0,
  on SubjectSeen { observer: o, subject: s, mark: m }
    where (o == observer) && (s == subject)
    { self |= m }
  on AllyDied { dead: d } merge from d: bit_or
  clamp: [0, 4294967295],
}
