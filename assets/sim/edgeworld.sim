// edgeworld — zero-player survival world sim. Phase 0: a band of
// Survivors forage FoodNodes against rising hunger; food regrows;
// starvation kills. FoodNode is declared `: Agent` (not `: Item`)
// so survivors can read/deplete its quantity via the spatial-
// neighbour SoA-read pattern proven in detective_investigation.sim
// (the Item-SoA cross-entity field read is still a gap — see
// foraging_colony.sim:59-67).
//
// Entity decl order is alphabetical → FoodNode = 0, Survivor = 1,
// Wolf = 2. Wolf MUST sort after Survivor so the existing
// creature_type == 1 (Survivor) guards stay valid.

event Tick { }

// WolfSpotted — emitted by a Survivor (Perceive) when it sees an alive
// Wolf inside its perception ring. The `observer` field is the spotting
// survivor's own slot; the `threats` belief folds +1.0 into
// `threats(observer)` for every WolfSpotted whose observer matches.
// Modelled on assassination_threat_test.sim::ThreatSighted (a perception
// rule emitting a replayable/gpu_amenable event that a decaying belief
// folds over). Phase 2 Task 1: belief RISE + DECAY only, no behaviour
// wiring (Task 2 gates Flee on this belief).
@replayable @gpu_amenable
event WolfSpotted {
  observer: AgentId,
}

// Born — emitted by a well-fed breeder Survivor (Reproduce) when it elects
// to revive its pre-linked offspring slot. `parent` is the breeder's own
// slot; `child` is the breeder's unique `engaged_with` offspring slot. The
// BornRevive @phase(post) consumer flips the child's alive 0→1 and seeds it.
// Modelled exactly on trade_caravans.sim::Born / BornRevive (the proven
// revive-via-engaged_with path).
@replayable @gpu_amenable
event Born {
  parent: AgentId,
  child:  AgentId,
}

entity FoodNode : Agent {
  pos: vec3,
  vel: vec3,
}

entity Survivor : Agent {
  pos: vec3,
  vel: vec3,
}

entity Wolf : Agent {
  pos: vec3,
  vel: vec3,
}

config edgeworld {
  // Hunger units added per tick per survivor. At 0.05/tick a
  // survivor that never eats crosses the starvation threshold
  // (1.0) in 20 ticks.
  hunger_rate:     f32 = 0.05,
  // Starvation threshold — hunger at or above this kills.
  hunger_max:      f32 = 1.0,
  // Hunger removed per eat tick (survivor side). Bounded per tick (the
  // survivor lowers its own hunger by this much each eat) so a survivor
  // seeded far above the starvation threshold cannot be pulled back
  // under 1.0 in time — those over-hungry survivors are the overshoot
  // and are culled in the opening ticks (the boom/bust crash). The
  // depth of the cull is set by how many seeded survivors start above
  // what `n_food * eat_amount` can rescue per tick.
  eat_amount:      f32 = 0.12,
  // Food quantity consumed per eat tick (FoodNode side). Below
  // eat_amount so the recovered larder feeds the surviving remnant
  // efficiently and sustains it at carrying capacity after the crash.
  eat_cost:        f32 = 0.10,
  // FoodNode regrowth per tick. Tuned so the larder (n_food nodes)
  // recovers to a level that stably sustains the post-crash remnant —
  // higher (~0.015) keeps everyone alive (no crash), lower (~0.013)
  // lets even the remnant slowly starve to extinction; 0.014 is the
  // stable-remnant edge.
  regrow_rate:     f32 = 0.014,
  // FoodNode quantity ceiling.
  food_max:        f32 = 5.0,
  // Spatial perception radius for eating (matches @spatial below).
  eat_radius:      f32 = 1.5,
  // SeekFood movement: fraction of the (food - self) vector a hungry
  // survivor steps each tick toward the first food in perception. Kept
  // gentle so the surviving remnant drifts toward — but does not all
  // collapse onto — the same food pixel, keeping the rendered remnant
  // legible as distinct dots rather than one stacked blob. (Eating in
  // Phase 0 is effectively position-independent — the spatial-neighbour
  // query spans the compact world — so survivors need not converge to
  // feed.)
  move_speed:      f32 = 0.15,
  // Idle wander magnitude (reserved; Phase 0 steering is deterministic).
  wander_scale:    f32 = 0.05,
  // Spatial perception radius for spotting food to walk toward.
  perceive_radius: f32 = 12.0 @runtime,
  // Wolf hunger accrual per tick. A kill resets the wolf's hunger to 0
  // (WolfHunt), so wolves are genuinely coupled to prey: hunt or starve.
  //
  // HONEST TUNING NOTE. The structural tension in this fixed-population
  // (no-reproduction) ecosystem is that flee_speed (0.25) > wolf_move_speed
  // (0.18): once the seeded crowd is thinned, the surviving prey can out-run
  // a single pursuer, so the remnant is uncatchable and wolves get no more
  // kills after the opening feast. That means a wolf's survival to tick 600
  // is decided almost entirely by how long it can COAST on the feast kills.
  // At an aggressive rate (e.g. 0.02 — feed-or-die in 50 ticks) the wolves
  // starve by ~tick 80 and, with the prey remnant also thin, the world flips
  // to mutual extinction (degenerate). 0.0016 is the tuned edge: a wolf that
  // never feeds still dies in ~625 ticks (so the metabolic pressure is real
  // — the wolves are NOT immortal), but a wolf that lands a couple of feast
  // kills coasts to tick 600. That is what yields the stable mixed
  // equilibrium (prey remnant evading + foraging, pack persisting) the
  // dynamics/coexistence pins assert. The Phase-1 hack (0.0015) gave the
  // same coast but with NO world bounds, so the prey fled off-world and
  // starved in the wilderness — "wolves alive, prey extinct" was hollow.
  // The bounds (below) keep the prey on-world as a genuine evading remnant,
  // which is what makes the both-alive-at-600 result real rather than
  // cosmetic. True predator-driven oscillation would need prey
  // reproduction, which this fixture does not model.
  wolf_hunger_rate: f32 = 0.0016,
  // World bounds — a square arena [world_min, world_max] on the x/z plane
  // (the plane the seeder and render use: positions are [x, 0, z, 0] and
  // the render maps pos.x / pos.z). Every movement rule clamps the new
  // position component-wise into this box BEFORE set_pos, so no agent can
  // drift off-world. Wider than the seed cluster (the pins seed with
  // world_half ≈ 11, so survivors land inside ~0.7*11 ≈ 7.7 and wolves on
  // the rim ≈ 10.5) so there is room to maneuver inside the [-16,16] box —
  // fleeing prey hit the wall and must turn along it rather
  // than escaping to infinity, which is what makes the chase bounded and
  // forces real predator-prey contact instead of an unbounded off-world
  // flight + wilderness starvation.
  world_min: f32 = -16.0,
  world_max: f32 = 16.0,
  // Wolf movement speed (Task 2 pursuit; faster than survivors).
  wolf_move_speed:  f32 = 0.18,
  // Range within which a wolf kills a survivor (Task 2).
  kill_range:       f32 = 1.2,
  // Survivor flee speed when a wolf is near (Task 2).
  flee_speed:       f32 = 0.25,
  // Range at which a survivor notices a wolf and flees (Task 2).
  flee_range:       f32 = 5.0,
  // Phase 2 Task 2 — fear threshold on the decaying FEAR column.
  //
  // PATH B (hand-rolled fear column). DSL COVERAGE FINDING: reading the
  // decaying `threats` belief from a @phase(per_agent) PHYSICS rule does
  // NOT work — `threats.intensity_at(self)` lowers cleanly (no compile
  // error) but the ViewCall read is SILENTLY ELIDED from the physics
  // kernel: with the clause in Flee's where-guard, the emitted
  // fused_Flee.wgsl guard collapsed to `(alive && creature_type == 1)`
  // with zero references to any threats/view_storage binding (the
  // view-read prelude is only wired into SCORING kernels, not physics
  // kernels). This matches the `assassination_threat_test.sim` "no belief
  // read from physics rule" gap. So the belief's VALUE is not readable
  // where the gate needs it. We hand-roll the same decaying threat as a
  // free survivor f32 SoA column (`shield_hp`, unused by edgeworld) using
  // proven column reads/writes: Perceive RISES it +1.0/sighting, DecayFear
  // drains it *0.90/tick, and Flee/SeekFood gate on it crossing this
  // threshold. The `threats` belief stays live as the host-readable fear
  // signal for Task 3's render fear-tint (read via read_threats).
  //
  // With +1.0/sighting and 0.75 decay (Task 3 tuned 0.90 -> 0.75 so fear is
  // more responsive and re-settles to calm faster — the legible render cycle)
  // the column climbs 0 -> 0.75 -> 1.31 -> 2.06 (saturating at the steady
  // state f* = 0.75/(1-0.75) = 3.0); 1.5 lands the gate crossing on the 3rd-
  // 4th sighting tick (reaction lag), and once the wolf leaves it decays back
  // under 1.5 within ~2-3 ticks (lingering fear, then calm forage resumes).
  fear_threshold:   f32 = 1.5,
  // Phase 3 Task 1 — REPRODUCTION. A breeder only births while it is
  // well-fed (hunger strictly below this). Kept low so a hungry survivor
  // spends its food on itself, not offspring.
  birth_hunger_max: f32 = 0.3,
  // Birth cadence — a breeder fires Reproduce only on ticks divisible by
  // this, so a well-fed breeder revives its offspring once per period
  // (not every tick).
  birth_cooldown:   u32 = 60,
}

// Per-Survivor hunger accrual. creature_type == 1 is Survivor.
physics Hunger @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == 1) {
    let prev = agents.hunger(self);
    agents.set_hunger(self, prev + config.edgeworld.hunger_rate);
  }
}

// Per-Wolf hunger accrual. creature_type == 2 is Wolf. Wolves use
// their own (slower) rate so they don't starve before they can hunt.
physics WolfHunger @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == 2) {
    let p = agents.hunger(self);
    agents.set_hunger(self, p + config.edgeworld.wolf_hunger_rate);
  }
}

// Spatial-grid filter — body-form pattern (same as
// detective_investigation / predator_prey_real / trophic_3tier).
// The body-side `if` does the actual creature_type + quantity filter.
@spatial(radius = 1.5, kind = [Agent])
spatial_query nearby_food(self: AgentId, candidate: AgentId) =
  candidate != self

// Eat — each alive, hungry Survivor walks its 27-cell neighbourhood
// and feeds off any co-located FoodNode that still has quantity.
//
// EAT PATH: PRIMARY shape (direct in-loop neighbour write). The
// survivor lowers its OWN hunger (self-write, proven) AND directly
// depletes the FoodNode's `mana` quantity column via
// `agents.set_mana(candidate, ...)` from inside the spatial loop.
// (FoodNode quantity is repurposed onto the `mana` f32 SoA column —
// see Task 4 repurpose decision.)
physics Eat @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type == 1
                    && agents.hunger(self) > 0.0) {
    for candidate in spatial.nearby_food(self) {
      if (candidate.alive
          && candidate.creature_type == 0
          && agents.mana(candidate) >= config.edgeworld.eat_cost) {
        let h = agents.hunger(self);
        let new_h = if (h > config.edgeworld.eat_amount) { h - config.edgeworld.eat_amount } else { 0.0 };
        agents.set_hunger(self, new_h);
        let q = agents.mana(candidate);
        agents.set_mana(candidate, q - config.edgeworld.eat_cost);
      }
    }
  }
}

// Regrow — each alive FoodNode trickles its `mana` quantity back up
// per tick, capped at food_max.
physics Regrow @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == 0) {
    let q = agents.mana(self);
    let grown = q + config.edgeworld.regrow_rate;
    let capped = if (grown > config.edgeworld.food_max) { config.edgeworld.food_max } else { grown };
    agents.set_mana(self, capped);
  }
}

// Wider spatial-grid filter for SeekFood — same body-form pattern as
// nearby_food, just a larger radius so survivors spot food before they
// are close enough to eat it.
@spatial(radius = 12.0, kind = [Agent])
spatial_query food_in_sight(self: AgentId, candidate: AgentId) =
  candidate != self

// SeekFood — each alive, hungry Survivor walks toward the first FoodNode
// it can see. Neighbour vec3 position is read via FIELD ACCESS
// (`candidate.pos`) — the proven form: `candidate.pos - self.pos` lowers
// to `agent_pos[per_pair_candidate] - agent_pos[agent_id]` and the
// `dir * move_speed` vec3 scalar-mul emits cleanly (same neighbour-pos
// arithmetic crowd_navigation.sim uses). Unnormalised steering
// (`dir * move_speed`) is fine for Phase 0; first-in-range (not nearest)
// is acceptable.
//
// DCE ANCHOR (Phase-0 finding): a spatial-loop rule whose ONLY write is
// the vec3 `agents.set_pos(self, …)` (or `set_vel`) is silently dropped
// — no kernel, no diagnostic — because the scheduler does not count a
// vec3 self-write as an observable effect. Pairing it with a recognised
// scalar/atomic self-write keeps the rule live and the `set_pos` store
// emits as `agent_pos[agent_id] = (agent_pos[agent_id] + local_3)`. The
// identity `set_hunger(self, agents.hunger(self))` is that anchor: it
// writes the current hunger back unchanged (Hunger runs in an earlier
// kernel stage, so this is a true no-op) purely to mark the rule as
// effectful. Remove it and SeekFood vanishes from the schedule. Carry
// this forward to Phase 1 — predators steering toward prey via `set_pos`
// in a spatial loop need the same anchor.
physics SeekFood @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type == 1
                    && agents.hunger(self) > 0.2
                    && agents.shield_hp(self) <= config.edgeworld.fear_threshold) {
    for candidate in spatial.food_in_sight(self) {
      if (candidate.alive
          && candidate.creature_type == 0
          && agents.mana(candidate) >= config.edgeworld.eat_cost) {
        let dir = candidate.pos - self.pos;
        let step = dir * config.edgeworld.move_speed;
        // Clamp the new position into the world box on the x/z plane
        // (the render's axes) BEFORE writing — keeps foragers on-world.
        let np = self.pos + step;
        let cx = clamp(np.x, config.edgeworld.world_min, config.edgeworld.world_max);
        let cz = clamp(np.z, config.edgeworld.world_min, config.edgeworld.world_max);
        agents.set_pos(self, vec3(cx, np.y, cz));
        agents.set_hunger(self, agents.hunger(self));
      }
    }
  }
}

// Starvation. When hunger crosses the max, the survivor dies.
//
// DEATH PATH: direct alive-clear (`agents.set_alive(self, false)`)
// from a per-agent physics rule — the PRIMARY shape. This is the
// channel forest_fire.sim's Reaper (line 194) and trophic_3tier.sim's
// EnergyDecay (line 282) already use: a `@phase(per_agent)` rule whose
// `where` reads self fields + hunger and clears alive. The compiler
// accepts it directly, so no hp-damage fallback / .ability file is
// needed. (Fixtures spell the bool literal `false`, not `0`.) The
// `self.alive` guard makes the clear idempotent — once dead the rule
// stops re-firing.
// creature_type != 0 → both Survivors (1) and Wolves (2) starve at the
// max; FoodNodes (0) never starve.
physics Starvation @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type != 0
                    && agents.hunger(self) >= config.edgeworld.hunger_max) {
    agents.set_alive(self, false);
  }
}

// Spatial-grid filter for wolf hunting — a 6-unit perception ring (well
// inside the 12-unit survivor SeekFood ring) so wolves spot and pursue
// nearby survivors. Body-form pattern: the body-side `if` does the
// creature_type + alive filter on the candidate.
@spatial(radius = 6.0, kind = [Agent])
spatial_query prey_in_sight(self: AgentId, candidate: AgentId) =
  candidate != self

// WolfHunt — each alive Wolf (creature_type 2) walks its perception ring
// and, for each alive Survivor (creature_type 1) it sees, either:
//   * KILLS it if within kill_range (direct neighbour `set_alive(candidate,
//     false)` — same neighbour-column-write path Eat uses on `set_mana`)
//     and resets its OWN hunger to 0.0 (it has fed); or
//   * PURSUES it otherwise, stepping toward the survivor at wolf_move_speed
//     via the proven neighbour-pos steering (`candidate.pos - self.pos`).
//
// DCE ANCHOR (carried from SeekFood): the pursue branch's only write is
// the vec3 `set_pos` — silently dead-code-eliminated unless paired with a
// recognised scalar self-write. The identity `set_hunger(self,
// agents.hunger(self))` is that anchor (WolfHunger runs in an earlier
// kernel stage, so writing the current hunger back is a true no-op that
// merely marks the rule effectful). The kill branch already carries a
// real scalar self-write (`set_hunger(self, 0.0)`), so only the else
// branch needs the anchor.
physics WolfHunt @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == 2) {
    for candidate in spatial.prey_in_sight(self) {
      if (candidate.alive && candidate.creature_type == 1) {
        let d = distance(self.pos, candidate.pos);
        if (d < config.edgeworld.kill_range) {
          agents.set_alive(candidate, false);
          agents.set_hunger(self, 0.0);
        } else {
          let dir = candidate.pos - self.pos;
          // Clamp the wolf's new position into the world box (x/z plane)
          // BEFORE writing — keeps the pack on-world chasing prey.
          let np = self.pos + dir * config.edgeworld.wolf_move_speed;
          let cx = clamp(np.x, config.edgeworld.world_min, config.edgeworld.world_max);
          let cz = clamp(np.z, config.edgeworld.world_min, config.edgeworld.world_max);
          agents.set_pos(self, vec3(cx, np.y, cz));
          agents.set_hunger(self, agents.hunger(self));
        }
      }
    }
  }
}

// Spatial-grid filter for survivor flight — a 6-unit perception ring (the
// mirror of prey_in_sight; identical signature). The body-side `if` does
// the creature_type + alive filter on the candidate wolf.
@spatial(radius = 6.0, kind = [Agent])
spatial_query threat_in_sight(self: AgentId, candidate: AgentId) =
  candidate != self

// Flee — each alive Survivor (creature_type 1) walks its perception ring
// and, for each alive Wolf (creature_type 2) within flee_range, steps
// directly AWAY from it at flee_speed (faster than wolf_move_speed so the
// survivor outpaces a single pursuer). Mirror of WolfHunt's pursue branch
// with the steering vector negated (away = self.pos - candidate.pos).
//
// DCE ANCHOR (carried from SeekFood/WolfHunt): the only write here is the
// vec3 `set_pos` — silently dead-code-eliminated unless paired with a
// recognised scalar self-write. The identity `set_hunger(self,
// agents.hunger(self))` is that anchor (Hunger runs in an earlier kernel
// stage, so writing the current hunger back is a true no-op that merely
// marks the rule effectful).
physics Flee @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type == 1
                    && agents.shield_hp(self) > config.edgeworld.fear_threshold) {
    for candidate in spatial.threat_in_sight(self) {
      if (candidate.alive && candidate.creature_type == 2) {
        let d = distance(self.pos, candidate.pos);
        if (d < config.edgeworld.flee_range) {
          let away = self.pos - candidate.pos;
          // Clamp the fleeing survivor's new position into the world box
          // (x/z plane) BEFORE writing — the wall is what bounds the chase:
          // a survivor driven into the corner can no longer escape off-world
          // and must turn along the edge, forcing real predator contact.
          let np = self.pos + away * config.edgeworld.flee_speed;
          let cx = clamp(np.x, config.edgeworld.world_min, config.edgeworld.world_max);
          let cz = clamp(np.z, config.edgeworld.world_min, config.edgeworld.world_max);
          agents.set_pos(self, vec3(cx, np.y, cz));
          agents.set_hunger(self, agents.hunger(self));
        }
      }
    }
  }
}

// Perceive — each alive Survivor (creature_type 1) walks its perception
// ring (reuse threat_in_sight, the same 6-unit ring Flee uses) and, for
// each alive Wolf (creature_type 2) it sees, emits a WolfSpotted record
// tagged with its OWN slot as the observer. The `threats` belief below
// folds those records into a per-survivor decaying threat level (the
// host-readable fear signal for Task 3's render fear-tint). This is the
// perception SOURCE. Task 2: it ALSO raises the hand-rolled FEAR column
// (shield_hp) +1.0 per sighting — the value the behaviour gates actually
// read, since the belief's value is not readable from a physics rule (see
// PATH B finding at the fear_threshold config). The column self-write is
// the observable scalar effect, so no DCE anchor is needed.
physics Perceive @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == 1) {
    for candidate in spatial.threat_in_sight(self) {
      if (candidate.alive && candidate.creature_type == 2) {
        emit WolfSpotted { observer: self }
        // PATH B fear RISE: in addition to the (host-readable, but
        // physics-unreadable) `threats` belief, raise the survivor's own
        // FEAR column by +1.0 per wolf sighting. This is the value the
        // behaviour gates read (proven self-write column), mirroring the
        // belief's +1.0 fold so the two track. This self-write also makes
        // the rule effectful without a DCE anchor.
        let f = agents.shield_hp(self);
        agents.set_shield_hp(self, f + 1.0);
      }
    }
  }
}

// DecayFear — drain each survivor's FEAR column by 25%/tick, matching the
// `threats` belief's @decay(rate = 0.75) (Task 3 tuned 0.90 -> 0.75 so fear
// re-settles to calm faster — the legible render fear-tint cycle). Runs every
// tick on every alive survivor (no spatial query). Pairs with Perceive's
// RISE: when a wolf is in sight fear climbs toward steady-state 3.0 (rise +1
// vs the 25% drain); once sightings stop it decays geometrically (lingering
// fear) back under fear_threshold within ~2-3 ticks, at which point Flee
// stops firing and SeekFood resumes. Proven scalar self-write column.
physics DecayFear @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == 1) {
    let f = agents.shield_hp(self);
    agents.set_shield_hp(self, f * 0.75);
  }
}

// threats — first-class decaying belief: a per-survivor threat level
// that RISES (+1.0) on every WolfSpotted whose observer matches this
// slot, and DECAYS by the @decay rate each tick BEFORE the fold runs.
// View name MUST be exactly `threats` (the scoring wire-up keys on it —
// Task 2 reads it). Single-Agent key → single-key (N cells) storage at
// view_storage_threats_primary_buf, read back like threat_stresstest_pin.
//
// DISPATCH CHOICE — this is the load-bearing decision for Task 1.
// The dodger_probe / threats_with_decay_probe `@dispatch(per_agent_event_scan)`
// shape does NOT read emitted events: its fold pair-scans (observer,
// source) agent slots and gates on the omniscient `agent_busy_with_ability_id`
// column — it ignores `emit WolfSpotted` entirely (verified: the
// generated fold_threats.wgsl never touches event_ring; it loops gid.x/gid.y
// over agent slots). To get a belief that genuinely RISES from spatial
// wolf SIGHTINGS (the Perceive emit), use the `@materialized(on_event=[...])`
// per-event dispatch instead — the same shape plague_city's
// `contagion_pressure(source: Agent) -> f32` and trade_market_probe's
// `trader_volume(buyer: Agent) -> f32` use: it dispatches per emitted
// event, reads the payload's `observer` field, and folds +1.0 into that
// observer's cell. @decay then drains it each tick. (Belief keyword +
// single-Agent f32 + @materialized + @decay all compose; see plague_city.)
@materialized(on_event = [WolfSpotted])
@decay(rate = 0.75, per = tick)
belief threats(observer: Agent) -> f32 {
  initial: 0.0,
  on WolfSpotted { observer: o } where (o == observer) { self += 1.0 }
  clamp: [0.0, 100.0],
}

// Reproduce — each alive, WELL-FED Survivor (creature_type 1, hunger below
// birth_hunger_max) emits a Born record on the cadence tick. The child slot
// is the breeder's own pre-linked offspring slot read from the engaged_with
// column (`agents.engaged_with(self)`) — proven in trade_caravans.sim::OnDied.
// Each breeder is wired 1:1 to a UNIQUE offspring slot at seed time, so no
// two breeders ever emit Born for the same child — the revive in BornRevive
// is allocation-race-free. `world.tick % birth_cooldown == 0` paces births.
physics Reproduce @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type == 1
                    && agents.hunger(self) < config.edgeworld.birth_hunger_max
                    && (world.tick % config.edgeworld.birth_cooldown == 0)) {
    let child = agents.engaged_with(self);
    emit Born { parent: self, child: child }
  }
}

// BornRevive — @phase(post) consumer of Born. Revives the offspring slot:
// alive 0→1 (the BIRTH path, mirroring trade_caravans.sim::BornRevive), and
// seeds the newborn at hunger 0 on the PARENT's position so it spawns in the
// fed cluster (foraging dynamics then apply to it like any survivor).
//
// DSL FINDINGS (Phase 3 Task 1, verified on-GPU):
//   * `agents.set_alive(c, true)` from a post consumer drives 0→1 (the
//     scalar write that anchors the kernel — vec3-only would be DCE'd).
//   * `agents.alive(c)` GATE in an `if` reads the NON-self child's alive
//     flag — proven in among_us.sim::ApplyWitness. Used here so a live
//     child is NOT reset/teleported each cadence tick (only dead slots
//     are (re)born). Without this gate a long cooldown still re-cradles a
//     live child harmlessly, but the gate makes it exact.
//   * `agents.pos(p)` reads the parent's vec3 in a post consumer + writes
//     the child's vec3 via `agents.set_pos(c, …)` — the cross-agent
//     pos read/write pattern proven in among_us.sim::ApplyWitness /
//     tom_probe.sim. creature_type is left as the seeded value (offspring
//     slots are seeded type 1 already), so no set_creature_type is needed.
@phase(post)
physics BornRevive {
  on Born { parent: p, child: c } {
    if (agents.alive(c) == false) {
      agents.set_alive(c, true);
      agents.set_hunger(c, 0.0);
      agents.set_pos(c, agents.pos(p));
    }
  }
}
