// duel_abilities — Wave 1 acceptance fixture for the .ability DSL pipeline.
//
// MIRRORS `assets/sim/duel_1v1.sim` shape (verb cascade + chronicle physics)
// but renames Strike/Spell/Heal -> Strike/ShieldUp/Mend so the verbs line up
// 1:1 with `assets/ability_test/duel_abilities/{Strike,ShieldUp,Mend}.ability`.
// The constants below are HAND-MIRRORED from those `.ability` files; the
// runtime crate's binding check asserts the registry lowering produces the
// same values, proving the .ability -> AbilityRegistry pipeline is correct
// end-to-end.
//
// Task #138 (2026-05-06) — Strike's verb body uses
// `apply_ability 1 by self target target` instead of the original inline
// `emit Damaged{...}`. The dispatcher writes EffectDamageApplied (kind=26)
// records that the new ApplyDamageFromChronicle physics rule re-emits as
// `Damaged` events, keeping the rest of the cascade (shield absorption,
// lifesteal, damage-modify, defeat handling) unchanged. The literal `1`
// is Strike's AbilityId in the registry — pinned at startup by
// `binding_check::STRIKE_EXPECTED_ABILITY_ID`.
//
// Task #138 follow-on (2026-05-07) — ShieldUp and Mend extended the same
// pattern: their verb bodies now dispatch via `apply_ability 2 by self
// target self` and `apply_ability 3 by self target self` respectively
// (self-cast, so the explicit `target self` matches the verb's
// own self-target gate). The dispatcher writes EffectShieldApplied
// (kind=28) and EffectHealApplied (kind=27) records that the new
// ApplyShieldFromChronicle / ApplyHealFromChronicle physics rules
// re-emit as the existing `Shielded` / `Healed` events so the rest of
// the cascade (ApplyShield / ApplyHeal SoA writes) keeps working
// unchanged. Slot ids pinned at startup via SHIELDUP_EXPECTED_ABILITY_ID
// = 2 and MEND_EXPECTED_ABILITY_ID = 3 in binding_check.rs.
//
// Task #138 follow-on (Daze, 2026-05-07) — Daze extends the pattern
// to a chance-gated, enemy-target verb: `apply_ability 8 by self
// target target`. The dispatcher writes EffectStunApplied (kind=29)
// records that the new ApplyStunFromChronicle physics rule re-emits
// as the existing `Stunned` events (ApplyStun's per-agent
// set_stun_expires_at_tick handler unchanged). The chance gate stays
// in the verb's `when` clause — the GPU dispatcher does not consult
// program.chances at the apply_ability arm today (registry-driven
// chance dispatch is later infrastructure). Slot id pinned at startup
// via DAZE_EXPECTED_ABILITY_ID = 8 in binding_check.rs.
//
// The remaining verbs (Bleed/Reap/Vampirize/Fortify) still use direct
// emit chronicles; expanding the apply_ability swap to them is followup
// — they need new engine EventKindId variants (SelfDamageApplied,
// ExecuteApplied, LifeStealApplied, DamageModifyApplied) that don't
// exist yet.
//
// CONSTANT TABLE (matches the .ability files exactly):
//   Strike   : cooldown 10 ticks (1s), range 5.0, damage 15.0, target enemy
//   ShieldUp : cooldown 40 ticks (4s), self-target, shield 50.0
//   Mend     : cooldown 30 ticks (3s), self-target, heal 25.0
//   Bleed    : cooldown 50 ticks (5s), self-target, self_damage 5.0
//             (Wave 2 piece N — first SelfDamage E2E demo. The verb
//              emits a Damaged event with target=self, reusing the
//              existing ApplyDamage chronicle with shield absorption.)
//   Reap     : cooldown 20 ticks (2s), range 5.0, execute 20, target enemy
//             (Wave 2 piece N — Execute E2E demo. Conditional-emit
//              gated on target.hp < reap_threshold; on fire emits
//              Defeated drained by the new ApplyDefeat chronicle.
//              Score 500 dominates every other verb when its finisher
//              gate is satisfied.)
//
// SHIELD MODELLING: `hot_shield_hp: Vec<f32>` lives in the agent SoA
// (`crates/engine/src/state/mod.rs`); the dsl_compiler exposes
// `agents.set_shield_hp` (see `cg/lower/physics.rs::agents_setter_field`)
// for chronicle writes. ShieldUp emits a `Shielded` event; ApplyShield
// adds the amount onto the target's shield_hp slot. Damage absorption
// (shield_hp drained before hp) is the natural next refinement to
// ApplyDamage but isn't required for this acceptance fixture — the
// binding-check still asserts the .ability lowered to
// `EffectOp::Shield(50.0)`.
//
// The runtime tick chain is the same shape as duel_1v1's, with #138's
// EffectDamageApplied → Damaged re-emit added between the verb chronicles
// and ApplyDamage:
//   1. clears
//   2. fused_mask_verb_Strike (PerPair, writes mask_0..7 for the 8 verbs)
//   3. scoring (PerAgent argmax over 8 rows -> ActionSelected)
//   4. physics_verb_chronicle_ShieldUp/Mend/Bleed/Reap/Vampirize/Fortify/Daze
//      (each gates on its own action_id and emits its event variant)
//   5. fused PerEvent: ApplyHeal+ApplyShield+ApplyDefeat+ApplyLifestealActivation+
//      ApplyDamageModActivation+ApplyStun+verb_chronicle_Strike (the apply_ability
//      arm reads agent_level/registry effect_kinds and writes
//      EffectDamageApplied chronicle records)
//   6. physics_ApplyDamageFromChronicle (#138, reads kind=26, emits Damaged kind=1)
//   7. physics_ApplyDamage  (drains Damaged with shield/lifesteal/damage-modify)
//   8. seed_indirect_0
//   9. fold_damage_dealt
//  10. fold_healing_done

event Tick { }

@replayable @gpu_amenable
event Damaged {
  source: AgentId,
  target: AgentId,
  amount: f32,
}

// Engine-side chronicle event written by the apply_ability dispatcher
// at hardcoded EventKindId 26 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// Task #138 — Strike's verb body is now `apply_ability 1 by self
// target target`, which writes EffectDamageApplied records into the
// event ring. The new ApplyDamageFromChronicle physics rule (declared
// below near the rest of the consumers) translates these records back
// into the existing `Damaged` event so the rest of the cascade
// (ApplyDamage's shield/lifesteal/damage-modify pipeline) works
// without modification.
@replayable @gpu_amenable
event EffectDamageApplied {
  actor: AgentId,
  target: AgentId,
  amount: f32,
}

// Engine-side chronicle event written by the apply_ability dispatcher
// at hardcoded EventKindId 27 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// Task #138 follow-on — Mend's verb body is now `apply_ability 3 by
// self target self`, which writes EffectHealApplied records into the
// event ring. The new ApplyHealFromChronicle physics rule (declared
// below near the rest of the consumers) translates these records
// back into the existing `Healed` event so the existing ApplyHeal
// cascade (per-agent set_hp) works without modification.
@replayable @gpu_amenable
event EffectHealApplied {
  actor: AgentId,
  target: AgentId,
  amount: f32,
}

// Engine-side chronicle event written by the apply_ability dispatcher
// at hardcoded EventKindId 28 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// Task #138 follow-on — ShieldUp's verb body is now `apply_ability 2
// by self target self`, which writes EffectShieldApplied records into
// the event ring. The new ApplyShieldFromChronicle physics rule
// (declared below near the rest of the consumers) translates these
// records back into the existing `Shielded` event so the existing
// ApplyShield cascade (per-agent set_shield_hp) works without
// modification.
@replayable @gpu_amenable
event EffectShieldApplied {
  actor: AgentId,
  target: AgentId,
  amount: f32,
}

// Engine-side chronicle event written by the apply_ability dispatcher
// at hardcoded EventKindId 29 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// Task #138 follow-on (Daze) — Daze's verb body is now `apply_ability
// 8 by self target target`, which writes EffectStunApplied records
// into the event ring. The new ApplyStunFromChronicle physics rule
// (declared below near the rest of the consumers) translates these
// records back into the existing `Stunned` event so the existing
// ApplyStun cascade (per-agent set_stun_expires_at_tick) keeps working
// unchanged.
//
// SHAPE NOTE: unlike the Damage/Heal/Shield triplet, the Stun
// chronicle's third payload word is `expires_at_tick` (= dispatcher's
// `tick + duration_ticks`), NOT `duration_ticks` and NOT `amount`.
// See `cg/emit/wgsl_body.rs` (Stun = 3 → kind 29 dispatcher arm) and
// `cpu_chronicle_reference.rs::apply_event_to_chronicle_record`. The
// existing `Stunned` event already carries `expires_at: u32`, so the
// re-emit physics rule can ferry the value verbatim — no
// duration↔expires conversion required.
@replayable @gpu_amenable
event EffectStunApplied {
  actor: AgentId,
  target: AgentId,
  expires_at_tick: u32,
}

// Engine-side chronicle event written by the apply_ability dispatcher
// at hardcoded EventKindId 39 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// Task #138 follow-on (Bleed, 2026-05-06) — Bleed's verb body is now
// `apply_ability 4 by self target self`, which writes
// EffectSelfDamageApplied records into the event ring. The new
// ApplyDamageFromSelfDamageChronicle physics rule (declared below near
// the rest of the consumers) translates these records back into the
// existing `Damaged` event so the existing ApplyDamage cascade (shield
// absorption, lifesteal, damage-modify) keeps working unchanged.
//
// SHAPE NOTE: same payload shape as EffectDamageApplied (actor +
// target + amount). For self-damage actor==target by convention; the
// dispatcher writes caster_slot into BOTH actor (slot 2) and target
// (slot 3) so the re-emit physics rule's `Damaged` event carries
// source==target and ApplyDamage drains it via the same shield/hp
// path it uses for a Strike landing.
@replayable @gpu_amenable
event EffectSelfDamageApplied {
  actor: AgentId,
  target: AgentId,
  amount: f32,
}

// Engine-side chronicle event written by the apply_ability dispatcher
// at hardcoded EventKindId 40 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// Task #138 follow-on (Vampirize, mirror of Bleed at `486eb08f`) —
// Vampirize's verb body is now `apply_ability 6 by self target self`,
// which writes EffectLifeStealApplied records into the event ring.
// The new ApplyLifestealFromChronicle physics rule (declared below
// near the rest of the consumers) translates these records back into
// the existing `SetLifesteal` event so the existing
// ApplyLifestealActivation cascade (which writes the per-agent
// lifesteal_frac_q8 + lifesteal_expires_at_tick SoA fields, then
// ApplyDamage's source lookup heals the source for
// `frac_q8/256 * bleed-through-damage` per Damaged event) keeps
// working unchanged.
//
// SHAPE NOTE: same payload shape as EffectSlowApplied — actor + target
// + expires_at_tick + fraction_q8. The dispatcher computes
// `expires_at_tick = tick + duration_ticks` so the engine event
// carries an absolute tick (matching what the original Vampirize verb
// body produced via `world.tick + config.combat.vampirize_dur`). For
// self-cast LifeSteal actor==target==caster by convention; the
// dispatcher writes caster_slot into BOTH actor (slot 2) and target
// (slot 3) so the re-emit physics rule can ferry both ids verbatim
// into the SetLifesteal event's `caster` field.
@replayable @gpu_amenable
event EffectLifeStealApplied {
  actor: AgentId,
  target: AgentId,
  expires_at_tick: u32,
  fraction_q8: i16,
}

// Engine-side chronicle event written by the apply_ability dispatcher
// at hardcoded EventKindId 41 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// Task #138 follow-on (Fortify, mirror of Vampirize at `60115f64`) —
// Fortify's verb body is now `apply_ability 7 by self target self`,
// which writes EffectDamageModifyApplied records into the event ring.
// The new ApplyDamageModFromChronicle physics rule (declared below
// near the rest of the consumers) translates these records back into
// the existing `SetDamageMod` event so the existing
// ApplyDamageModActivation cascade (which writes the per-agent
// damage_taken_mult_q8 + damage_taken_mult_expires_at_tick SoA fields,
// then ApplyDamage scales incoming damage by `mult_q8/256` while the
// buff is active) keeps working unchanged.
//
// SHAPE NOTE: same payload shape as EffectSlowApplied / EffectLifeStealApplied
// — actor + target + expires_at_tick + multiplier_q8. The dispatcher
// computes `expires_at_tick = tick + duration_ticks` so the engine
// event carries an absolute tick (matching what the original Fortify
// verb body produced via `world.tick + config.combat.fortify_dur`).
// For self-cast DamageModify actor==target==caster by convention; the
// dispatcher writes caster_slot into BOTH actor (slot 2) and target
// (slot 3) so the re-emit physics rule can ferry both ids verbatim
// into the SetDamageMod event's `target_agent` field.
@replayable @gpu_amenable
event EffectDamageModifyApplied {
  actor: AgentId,
  target: AgentId,
  expires_at_tick: u32,
  multiplier_q8: i16,
}

@replayable @gpu_amenable
event Healed {
  source: AgentId,
  target: AgentId,
  amount: f32,
}

@replayable @gpu_amenable
event Shielded {
  source: AgentId,
  target: AgentId,
  amount: f32,
}

@replayable @gpu_amenable
event Defeated {
  combatant: AgentId,
}

// Wave 2 piece N: LifeSteal E2E demo. Vampirize emits SetLifesteal as
// a state-set event; the new ApplyLifestealActivation chronicle drains
// it into the per-agent lifesteal_frac_q8 + lifesteal_expires_at_tick
// SoA fields. Once active, ApplyDamage's source lookup heals the source
// for `frac_q8/256 * bleed-through-damage` per Damaged event.
@replayable @gpu_amenable
event SetLifesteal {
  caster:     AgentId,
  frac_q8:    i16,
  expires_at: u32,
}

// Wave 2 piece N: DamageModify E2E demo. Fortify emits SetDamageMod
// as a state-set event; the new ApplyDamageModActivation chronicle
// drains it into the per-agent damage_taken_mult_q8 +
// damage_taken_mult_expires_at_tick SoA fields. Once active,
// ApplyDamage's TARGET lookup scales bleed-through damage by
// `mult_q8/256` before subtracting from hp.
@replayable @gpu_amenable
event SetDamageMod {
  target_agent: AgentId,
  mult_q8:      i16,
  expires_at:   u32,
}

// Wave 2 piece N: Stun E2E demo + FIRST cast-gate. Daze emits Stunned
// as a state-set event; the new ApplyStun chronicle drains it into the
// per-agent hot_stun_expires_at_tick SoA field. Every offensive verb's
// `when` clause now reads `agents.stun_expires_at_tick(self) <=
// world.tick` — agents whose stun window is active skip the verb.
@replayable @gpu_amenable
event Stunned {
  target_agent: AgentId,
  expires_at:   u32,
}

entity Combatant : Agent {
  pos: vec3,
  vel: vec3,
}

config combat {
  // Hand-mirrored from .ability files. Binding check in
  // crates/duel_abilities_runtime asserts these match the lowered
  // AbilityProgram values from assets/ability_test/duel_abilities/.
  strike_damage:    f32 = 30.0,   // Strike.ability: damage 30 (#85 retune)
  shieldup_amount:  f32 = 50.0,   // ShieldUp.ability: shield 50
  mend_amount:      f32 = 25.0,   // Mend.ability: heal 25
  cooldown_strike:  u32 = 10,     // Strike.ability: cooldown 1s == 10 ticks
  cooldown_shieldup: u32 = 40,    // ShieldUp.ability: cooldown 4s == 40 ticks
  cooldown_mend:    u32 = 30,     // Mend.ability: cooldown 3s == 30 ticks
  cooldown_bleed:   u32 = 50,     // Bleed.ability: cooldown 5s == 50 ticks
  bleed_amount:     f32 = 10.0,   // Bleed.ability: self_damage 5 + 5%·MaxHp; fixture MaxHp=100 → 5 + 5 = 10 (Wave 1.5#4 scaling, hand-mirrored)
  reap_threshold:   f32 = 20.0,   // Reap.ability: execute 20
  cooldown_reap:    u32 = 20,     // Reap.ability: cooldown 2s == 20 ticks
  strike_range:     f32 = 5.0,    // Strike.ability: range 5.0
  hp_low_threshold: f32 = 50.0,   // gate Mend on self-hp drop
  hp_bleed_floor:   f32 = 50.0,   // only Bleed when healthy enough to afford it
  vampirize_frac_q8: i16 = 128,   // Vampirize.ability: lifesteal 0.5 → q8 = 128
  vampirize_dur:     u32 = 50,    // Vampirize.ability: lifesteal duration 5s = 50 ticks
  cooldown_vampirize: u32 = 80,   // Vampirize.ability: cooldown 8s
  hp_vampire_floor:  f32 = 30.0,  // only Vampirize when hurt enough to want it
  fortify_mult_q8:   i16 = 128,   // Fortify.ability: damage_modify 0.5 → q8 = 128
  fortify_dur:       u32 = 50,    // Fortify.ability: damage_modify duration 5s = 50 ticks
  cooldown_fortify:  u32 = 80,    // Fortify.ability: cooldown 8s
  hp_fortify_floor:  f32 = 70.0,  // pre-emptive: Fortify when hurt-not-low (above hp_vampire_floor)
  // Wave 2 piece N — Stun E2E demo + first cast-gate. Daze writes
  // target.hot_stun_expires_at_tick = world.tick + daze_dur; every
  // offensive verb's `when` clause gates on
  // `agents.stun_expires_at_tick(self) <= world.tick`, so a stunned
  // agent cannot cast Strike/Bleed/Reap/Vampirize/Fortify/ShieldUp/Mend
  // (or even Daze) for the window.
  daze_dur:          u32 = 10,    // Daze.ability: stun 1s = 10 ticks
  cooldown_daze:     u32 = 40,    // Daze.ability: cooldown 4s
  hp_daze_floor:     f32 = 80.0,  // cast Daze pre-emptively when target healthy
}

// Strike — cooldown 10 ticks, range gate (range field stays declared but
// the .ability binding check is the load-bearing range assertion; runtime
// pair-field range checks aren't load-bearing for the 2-agent fixture).
//
// Score uses `target.hp` so the scoring kernel iterates pair candidates
// and binds `best_target` to the per_pair_candidate index. Without a
// pair-field reference, the scoring argmax leaves best_target =
// 0xFFFFFFFF and the chronicle's emitted Damaged event addresses an
// out-of-bounds slot — see duel_1v1.sim's Spell verb for the same
// pattern. Score formula: prefer low-HP targets (finisher-shape) while
// always being positive when target is alive (so Strike beats nothing
// when no enemies are in range).
verb Strike(self, target: Agent) =
  action StrikeAction
  when (self.alive
        // Wave 2 cast-gate (FIRST verb-status gate in the codebase):
        // a stunned agent cannot cast Strike. `agents.stun_expires_at_tick`
        // is the per-agent SoA field written by ApplyStun; the default
        // 0 means "never stunned" so the gate is a no-op until Daze
        // fires. See Daze verb + ApplyStun physics block below.
        && agents.stun_expires_at_tick(self) <= world.tick
        && target.alive
        && target != self
        && (world.tick % 10 == 0))
  // Task #138 — verb-body apply_ability dispatcher swap. Strike was
  // `emit Damaged { source: self, target: target, amount:
  // config.combat.strike_damage }`. The literal `1` is Strike's
  // AbilityId in the duel_abilities AbilityRegistry built from the
  // alphabetised .ability filenames in
  // `binding_check.rs::build_duel_abilities_registry` (Strike is the
  // first entry, lands at AbilityId(1)).
  //
  // The runtime extends the binding check to assert
  // `built.names.get("Strike") == AbilityId(1)` so any future drift
  // surfaces as a startup panic rather than silent wrong-ability
  // dispatch. See ApplyDamageFromChronicle below for the chronicle
  // re-emit that funnels EffectDamageApplied(kind=26) records back
  // into the existing `Damaged` cascade so shield_hp/lifesteal/
  // damage-modify all keep working unchanged.
  apply_ability 1 by self target target
  score (200.0 - target.hp)

// ShieldUp — self-cast, cooldown 40 ticks. Modelled as +50 HP via the
// `Shielded` event (see SHIELD MODELLING NOTE above). Score is high
// constant so it can win argmax over Strike's pair-field score
// (200 - target.hp, range 100..200) when ShieldUp's gates pass.
verb ShieldUp(self, target: Agent) =
  action ShieldUpAction
  when (self.alive
        // Wave 2 cast-gate: stunned agents cannot cast — uniform across
        // every verb so a Daze prevents ALL action this window.
        && agents.stun_expires_at_tick(self) <= world.tick
        && target == self
        && (world.tick % 40 == 0)
        && self.hp < 90.0)
  // Task #138 follow-on — verb-body apply_ability dispatcher swap.
  // ShieldUp was `emit Shielded { source: self, target: self, amount:
  // config.combat.shieldup_amount }`. The literal `2` is ShieldUp's
  // AbilityId in the duel_abilities AbilityRegistry built from the
  // alphabetised .ability filenames in
  // `binding_check.rs::build_duel_abilities_registry` (Strike=1,
  // ShieldUp=2, Mend=3, ...).
  //
  // `target self` mirrors the verb's existing `target == self` gate —
  // ShieldUp is self-cast so the dispatcher routes the EffectShieldApplied
  // chronicle's actor and target to the same slot. The runtime extends
  // the binding check to assert
  // `built.names.get("ShieldUp") == AbilityId(2)` so any drift surfaces
  // as a startup panic. See ApplyShieldFromChronicle below for the
  // chronicle re-emit that funnels EffectShieldApplied(kind=28) records
  // back into the existing `Shielded` cascade so ApplyShield's
  // shield_hp accumulation keeps working unchanged.
  apply_ability 2 by self target self
  score 250.0

// Mend — self-cast, cooldown 30 ticks. Only fires when HP is low.
// Highest constant so it dominates both Strike and ShieldUp when its
// HP-low gate passes.
verb Mend(self, target: Agent) =
  action MendAction
  when (self.alive
        // Wave 2 cast-gate: stunned agents cannot cast.
        && agents.stun_expires_at_tick(self) <= world.tick
        && target == self
        && (world.tick % 30 == 0)
        && self.hp < config.combat.hp_low_threshold)
  // Task #138 follow-on — verb-body apply_ability dispatcher swap.
  // Mend was `emit Healed { source: self, target: self, amount:
  // config.combat.mend_amount }`. The literal `3` is Mend's AbilityId
  // in the duel_abilities AbilityRegistry (Strike=1, ShieldUp=2,
  // Mend=3 — alphabetised filenames in build_duel_abilities_registry).
  //
  // `target self` matches the verb's existing `target == self` gate —
  // Mend is self-cast. The runtime extends the binding check to assert
  // `built.names.get("Mend") == AbilityId(3)` so any drift surfaces as
  // a startup panic. See ApplyHealFromChronicle below for the
  // chronicle re-emit that funnels EffectHealApplied(kind=27) records
  // back into the existing `Healed` cascade so ApplyHeal's per-agent
  // set_hp keeps working unchanged.
  apply_ability 3 by self target self
  score 300.0

// Bleed — Wave 2 piece N: first SelfDamage E2E demo. Self-cast,
// cooldown 50 ticks. Emits Damaged with target=self, drained by the
// existing ApplyDamage chronicle (shield absorption included). Only
// fires when HP is comfortably above the bleed amount so we don't
// accidentally suicide. Score is intentionally low (75.0) so Strike's
// pair-field score (200..100), ShieldUp (250.0), and Mend (300.0) all
// dominate when their gates pass — Bleed is the "nothing better to do
// with my action" floor.
verb Bleed(self, target: Agent) =
  action BleedAction
  when (self.alive
        // Wave 2 cast-gate: stunned agents cannot cast.
        && agents.stun_expires_at_tick(self) <= world.tick
        && target == self
        && (world.tick % 50 == 0)
        && self.hp > config.combat.hp_bleed_floor)
  // Task #138 follow-on (Bleed, 2026-05-06) — verb-body apply_ability
  // dispatcher swap. Bleed was `emit Damaged { source: self, target:
  // self, amount: config.combat.bleed_amount }`. The literal `4` is
  // Bleed's AbilityId in the duel_abilities AbilityRegistry built from
  // the source-order `names` list in
  // `binding_check.rs::build_duel_abilities_registry` (Strike=1,
  // ShieldUp=2, Mend=3, Bleed=4, ...).
  //
  // `target self` matches the verb's existing `target == self` gate —
  // Bleed is self-cast. The runtime extends the binding check to assert
  // `built.names.get("Bleed") == AbilityId(4)` so any drift surfaces as
  // a startup panic. The dispatcher writes EffectSelfDamageApplied
  // records (engine-aliased to kind=39) which the new
  // ApplyDamageFromSelfDamageChronicle physics rule re-emits as
  // Damaged so the existing ApplyDamage cascade (shield/lifesteal/
  // damage-modify) keeps working unchanged.
  //
  // SCALING NOTE: the .ability declares `+ 5% max_hp`, lowered to
  // scalings_per_effect[0] = (MaxHp, 0.05). The runtime apply path
  // (which runs CPU-side via apply_program) populates CasterStats
  // from per-agent SoA reads at cast-decide time. The GPU dispatcher
  // does NOT today consult scalings_per_effect at the apply_ability
  // arm — only the base `amount` (= 5.0) lands in the chronicle write.
  // The .sim verb's existing config.combat.bleed_amount (= 10.0,
  // hand-mirrored 5 + 5%·100) is no longer the load-bearing constant
  // because the verb stops emitting Damaged directly; the chronicle
  // amount is the EffectOp's base 5.0 until registry-driven scaling
  // dispatch lands. The `bleed_drains_caster_hp_when_selected`
  // runtime test relaxes its hp floor accordingly (still proves the
  // SelfDamage flow is wired end-to-end via the chronicle re-emit).
  apply_ability 4 by self target self
  score 75.0

// Reap — Wave 2 piece N: Execute E2E demo. Enemy-target, cooldown 20
// ticks (2s), gates on `target.hp < reap_threshold` so the verb only
// fires as a finisher. On fire, emits a Defeated event drained by the
// new ApplyDefeat chronicle.
//
// SCORING NOTE: the score formula MUST reference a pair-field (target.hp)
// so the scoring kernel iterates per_pair_candidate and binds best_target
// to the actual victim. Without a pair-field reference, best_target stays
// at the 0xFFFFFFFF sentinel and ApplyDefeat would write `set_alive(SENTINEL)`
// — same caveat the existing Strike verb documents. `1000 - target.hp`
// stays comfortably above Mend (300), ShieldUp (250), Strike (200..100),
// Bleed (75) for any target.hp ∈ [0, 100], so Reap dominates argmax
// whenever its finisher gate (target.hp < 20) is satisfied.
verb Reap(self, target: Agent) =
  action ReapAction
  when (self.alive
        // Wave 2 cast-gate: stunned agents cannot cast.
        && agents.stun_expires_at_tick(self) <= world.tick
        && target.alive
        && target != self
        && target.hp < config.combat.reap_threshold
        && (world.tick % config.combat.cooldown_reap == 0))
  emit Defeated { combatant: target }
  score (1000.0 - target.hp)

// Vampirize — Wave 2 piece N: LifeSteal E2E demo. Self-cast, cooldown
// 80 ticks (8s). Emits SetLifesteal to write the lifesteal SoA fields
// (frac_q8 = 128 = 0.5x, expires_at = world.tick + 50). Gated on
// `self.hp < hp_vampire_floor` so it only fires as a "panic drain" —
// when the caster is hurt enough that Mend alone won't save them.
//
// Score 350 sits ABOVE Mend (300) so when both Mend and Vampirize are
// eligible (self.hp ∈ (0, hp_low_threshold) ∩ (0, hp_vampire_floor)),
// Vampirize preempts Mend on the cooldown boundary. Strike's pair-field
// score (200..100) and ShieldUp (250) stay below.
verb Vampirize(self, target: Agent) =
  action VampirizeAction
  when (self.alive
        // Wave 2 cast-gate: stunned agents cannot cast.
        && agents.stun_expires_at_tick(self) <= world.tick
        && target == self
        && (world.tick % config.combat.cooldown_vampirize == 0)
        && self.hp < config.combat.hp_vampire_floor)
  // Task #138 follow-on (Vampirize, mirror of Bleed at `486eb08f`) —
  // verb-body apply_ability dispatcher swap. Vampirize was
  // `emit SetLifesteal { caster: self, frac_q8: config.combat.vampirize_frac_q8,
  //                      expires_at: world.tick + config.combat.vampirize_dur }`.
  // The literal `6` is Vampirize's AbilityId in the duel_abilities
  // AbilityRegistry built from the source-order `names` list in
  // `binding_check.rs::build_duel_abilities_registry` (Strike=1,
  // ShieldUp=2, Mend=3, Bleed=4, Reap=5, Vampirize=6, Fortify=7,
  // Daze=8).
  //
  // `target self` matches the verb's existing `target == self` gate —
  // Vampirize is self-cast. The runtime extends the binding check to
  // assert `built.names.get("Vampirize") == AbilityId(6)` so any drift
  // surfaces as a startup panic. The dispatcher writes
  // EffectLifeStealApplied records (engine-aliased to kind=40) which
  // the new ApplyLifestealFromChronicle physics rule re-emits as
  // SetLifesteal so the existing ApplyLifestealActivation cascade
  // keeps working unchanged.
  //
  // SCALING NOTE: Vampirize's `lifesteal 0.5 5s` has no explicit
  // scaling, so the chronicle write semantics are identical to the
  // hand-mirrored .sim emit — frac_q8=128, duration_ticks=50.
  // expires_at_tick = tick + 50 lands the same value as the original
  // `world.tick + config.combat.vampirize_dur`.
  apply_ability 6 by self target self
  score 350.0

// Fortify — Wave 2 piece N: DamageModify E2E demo. Self-cast, cooldown
// 80 ticks (8s). Emits SetDamageMod to write the damage_taken_mult SoA
// fields (mult_q8 = 128 = 0.5x, expires_at = world.tick + 50). Gated on
// `self.hp < hp_fortify_floor=70` so it fires PRE-EMPTIVELY when
// noticeably hurt — but not so low (< 30) that Vampirize takes over.
//
// Score 275 sits ABOVE ShieldUp (250) so it preempts when in the
// "hurt-not-low" band, but BELOW Mend (300) and Vampirize (350) so the
// healing/lifesteal verbs win when their lower-HP gates trigger.
// Strike's pair-field score (200..100) and Bleed (75) stay below.
verb Fortify(self, target: Agent) =
  action FortifyAction
  when (self.alive
        // Wave 2 cast-gate: stunned agents cannot cast.
        && agents.stun_expires_at_tick(self) <= world.tick
        && target == self
        && (world.tick % config.combat.cooldown_fortify == 0)
        && self.hp < config.combat.hp_fortify_floor)
  // Task #138 follow-on (Fortify, mirror of Vampirize at `60115f64`) —
  // verb-body apply_ability dispatcher swap. Fortify was
  // `emit SetDamageMod { target_agent: self, mult_q8: config.combat.fortify_mult_q8,
  //                      expires_at: world.tick + config.combat.fortify_dur }`.
  // The literal `7` is Fortify's AbilityId in the duel_abilities
  // AbilityRegistry built from the source-order `names` list in
  // `binding_check.rs::build_duel_abilities_registry` (Strike=1,
  // ShieldUp=2, Mend=3, Bleed=4, Reap=5, Vampirize=6, Fortify=7,
  // Daze=8).
  //
  // `target self` matches the verb's existing `target == self` gate —
  // Fortify is self-cast. The runtime extends the binding check to
  // assert `built.names.get("Fortify") == AbilityId(7)` so any drift
  // surfaces as a startup panic. The dispatcher writes
  // EffectDamageModifyApplied records (engine-aliased to kind=41)
  // which the new ApplyDamageModFromChronicle physics rule re-emits
  // as SetDamageMod so the existing ApplyDamageModActivation cascade
  // keeps working unchanged.
  //
  // SCALING NOTE: Fortify's `damage_modify 0.5 5s` has no explicit
  // scaling, so the chronicle write semantics are identical to the
  // hand-mirrored .sim emit — mult_q8=128, duration_ticks=50.
  // expires_at_tick = tick + 50 lands the same value as the original
  // `world.tick + config.combat.fortify_dur`.
  apply_ability 7 by self target self
  score 275.0

// Daze — Wave 2 piece N: Stun E2E demo + FIRST verb-status cast-gate.
// Enemy-target, cooldown 40 ticks (4s). Emits Stunned to write the
// target's hot_stun_expires_at_tick SoA field (= world.tick + 10 = 1s
// stun window). Gated on `target.hp > hp_daze_floor` so it's a
// pre-emptive crowd-control verb fired against healthy enemies (rather
// than wasted on a finisher candidate).
//
// Score formula: pair-field (200 - target.hp) so the scoring kernel
// iterates per_pair_candidate and binds best_target. Sits in the same
// 100..200 band as Strike — Strike (cooldown 10) and Daze (cooldown
// 40) won't both be eligible at every tick, so they don't directly
// contend; when they DO compete (every 40-tick boundary, target hp
// > 80), they tie at score=120 and the per-verb mask ordering decides.
//
// Cast-gate: Daze itself ALSO gates on
// `agents.stun_expires_at_tick(self) <= world.tick` — a stunned agent
// shouldn't be able to stun back, otherwise two Dazes would lock both
// agents indefinitely.
verb Daze(self, target: Agent) =
  action DazeAction
  when (self.alive
        // Cast-gate: stunned caster cannot cast Daze either (no
        // stun-back loop).
        && agents.stun_expires_at_tick(self) <= world.tick
        && target.alive
        && target != self
        && (world.tick % config.combat.cooldown_daze == 0)
        && target.hp > config.combat.hp_daze_floor
        // Wave 1.5#5 chance modifier — Daze.ability declares
        // `chance 50%`, lowered to program.chances[0] = Some(32768)
        // ((0.5 * 65535).round() rounds half-up). Hand-mirrored here
        // as `(rng.action() % 65536) < 32768`, which matches the
        // runtime gate shape `(per_agent_u32(...) & 0xFFFF) < q16`.
        //
        // Task #138 follow-on (Daze): the GPU apply_ability dispatcher
        // (cg/emit/wgsl_body.rs) writes one chronicle record per
        // non-empty effect slot UNCONDITIONALLY — it does NOT consult
        // program.chances[i] at the dispatcher arm. So the verb's
        // hand-mirrored chance gate stays load-bearing: it gates whether
        // the apply_ability emits at all this tick. Registry-driven
        // chance dispatch would push this into the dispatcher and let
        // the verb drop the gate; for now, the verb gate is the gate.
        && (rng.action() % 65536) < 32768)
  // Task #138 follow-on (Daze) — verb-body apply_ability dispatcher
  // swap. Daze was `emit Stunned { target_agent: target, expires_at:
  // world.tick + config.combat.daze_dur }`. The literal `8` is Daze's
  // AbilityId in the duel_abilities AbilityRegistry built from the
  // alphabetised .ability filenames in
  // `binding_check.rs::build_duel_abilities_registry` (alphabetised
  // file order: Bleed=4, Daze=8, Fortify=7, Mend=3, Reap=5, ShieldUp=2,
  // Strike=1, Vampirize=6 — but the runtime asserts pin Strike=1,
  // ShieldUp=2, Mend=3 and now Daze=8 explicitly, so any drift surfaces
  // as a startup panic).
  //
  // `target target` matches the verb's existing `target.alive &&
  // target != self` gate — Daze is enemy-target so the dispatcher
  // routes the EffectStunApplied chronicle's actor to self and target
  // to the verb's target. The runtime extends the binding check to
  // assert `built.names.get("Daze") == AbilityId(8)`. See
  // ApplyStunFromChronicle below for the chronicle re-emit that
  // funnels EffectStunApplied(kind=29) records back into the existing
  // `Stunned` cascade so ApplyStun's set_stun_expires_at_tick keeps
  // working unchanged.
  apply_ability 8 by self target target
  score (180.0 - target.hp)

// Task #138 — Strike's verb body now uses `apply_ability 1 by self
// target target` (see the Strike verb above). The dispatcher writes
// EffectDamageApplied chronicle records (engine-aliased to kind=26)
// instead of the source-declared Damaged event. This rule consumes
// those records and re-emits Damaged so the rest of the cascade
// (ApplyDamage with shield/lifesteal/damage-modify) keeps working
// unchanged.
//
// P6 caveat: this rule is PerEvent + emit-only (no AgentField writes)
// — does NOT trip P6, unlike ApplyDamage et al below.
@phase(post)
physics ApplyDamageFromChronicle {
  on EffectDamageApplied { actor: c, target: t, amount: a } {
    emit Damaged { source: c, target: t, amount: a }
  }
}

// Task #138 follow-on — ShieldUp's verb body now uses
// `apply_ability 2 by self target self` (see the ShieldUp verb above).
// The dispatcher writes EffectShieldApplied chronicle records
// (engine-aliased to kind=28) instead of the source-declared Shielded
// event. This rule consumes those records and re-emits Shielded so the
// rest of the cascade (ApplyShield with shield_hp accumulation) keeps
// working unchanged.
//
// P6 caveat: this rule is PerEvent + emit-only (no AgentField writes)
// — does NOT trip P6.
@phase(post)
physics ApplyShieldFromChronicle {
  on EffectShieldApplied { actor: c, target: t, amount: a } {
    emit Shielded { source: c, target: t, amount: a }
  }
}

// Task #138 follow-on — Mend's verb body now uses
// `apply_ability 3 by self target self` (see the Mend verb above).
// The dispatcher writes EffectHealApplied chronicle records
// (engine-aliased to kind=27) instead of the source-declared Healed
// event. This rule consumes those records and re-emits Healed so the
// rest of the cascade (ApplyHeal with per-agent set_hp) keeps working
// unchanged.
//
// P6 caveat: this rule is PerEvent + emit-only (no AgentField writes)
// — does NOT trip P6.
@phase(post)
physics ApplyHealFromChronicle {
  on EffectHealApplied { actor: c, target: t, amount: a } {
    emit Healed { source: c, target: t, amount: a }
  }
}

// Task #138 follow-on (Daze) — Daze's verb body now uses
// `apply_ability 8 by self target target` (see the Daze verb above).
// The dispatcher writes EffectStunApplied chronicle records
// (engine-aliased to kind=29) instead of the source-declared Stunned
// event. This rule consumes those records and re-emits Stunned so
// the rest of the cascade (ApplyStun with per-agent
// set_stun_expires_at_tick) keeps working unchanged.
//
// PAYLOAD NOTE: the chronicle's expires_at_tick word IS what the
// existing ApplyStun's `Stunned.expires_at` already speaks (the
// dispatcher pre-computes `tick + duration_ticks`), so the re-emit
// can ferry the value verbatim — no duration↔expires conversion.
// The Damage/Heal/Shield triplet's third payload is `amount: f32`,
// which is also a verbatim ferry. Stun is the first chronicle event
// in this fixture whose third payload is a TICK-DOMAIN u32 rather
// than an amount, but the re-emit shape is identical.
//
// P6 caveat: this rule is PerEvent + emit-only (no AgentField writes)
// — does NOT trip P6.
@phase(post)
physics ApplyStunFromChronicle {
  on EffectStunApplied { actor: _, target: t, expires_at_tick: e } {
    emit Stunned { target_agent: t, expires_at: e }
  }
}

// Task #138 follow-on (Bleed, 2026-05-06) — Bleed's verb body now uses
// `apply_ability 4 by self target self` (see the Bleed verb above).
// The dispatcher writes EffectSelfDamageApplied chronicle records
// (engine-aliased to kind=39) instead of the source-declared Damaged
// event. This rule consumes those records and re-emits Damaged with
// source==target==caster so the rest of the cascade (ApplyDamage with
// shield_hp absorption, lifesteal, damage-modify) keeps working
// unchanged — same shape as ApplyDamageFromChronicle but consuming
// kind=39 records instead of kind=26.
//
// PAYLOAD NOTE: same shape as EffectDamageApplied (actor + target +
// amount). The dispatcher writes caster_slot into BOTH actor (slot 2)
// and target (slot 3) for the SelfDamage arm, so this rule's pattern
// can ferry both ids verbatim into Damaged.
//
// P6 caveat: this rule is PerEvent + emit-only (no AgentField writes)
// — does NOT trip P6.
@phase(post)
physics ApplyDamageFromSelfDamageChronicle {
  on EffectSelfDamageApplied { actor: c, target: t, amount: a } {
    emit Damaged { source: c, target: t, amount: a }
  }
}

// Task #138 follow-on (Vampirize, mirror of Bleed at `486eb08f`) —
// Vampirize's verb body now uses `apply_ability 6 by self target self`
// (see the Vampirize verb above). The dispatcher writes
// EffectLifeStealApplied chronicle records (engine-aliased to kind=40)
// instead of the source-declared SetLifesteal event. This rule
// consumes those records and re-emits SetLifesteal so the rest of the
// cascade (ApplyLifestealActivation writing the per-agent SoA fields,
// then ApplyDamage's source lookup healing the source on subsequent
// damage) keeps working unchanged — same shape as
// ApplyDamageFromSelfDamageChronicle but consuming kind=40 records.
//
// PAYLOAD NOTE: same shape as EffectSlowApplied (actor + target +
// expires_at_tick + fraction_q8). The dispatcher writes caster_slot
// into BOTH actor (slot 2) and target (slot 3) for the LifeSteal arm
// (self-cast), so this rule's pattern reads `actor: c` and binds the
// caster id directly into the SetLifesteal `caster` field. The
// `expires_at_tick` field is already absolute (= tick + duration at
// chronicle-write time), so the re-emit ferries it verbatim into the
// `expires_at` field — no `world.tick + d` recomputation is needed
// (and recomputing would compound the offset since `world.tick` ==
// the chronicle-record's tick at re-emit time).
//
// P6 caveat: this rule is PerEvent + emit-only (no AgentField writes)
// — does NOT trip P6.
@phase(post)
physics ApplyLifestealFromChronicle {
  on EffectLifeStealApplied { actor: c, target: _, expires_at_tick: e, fraction_q8: f } {
    emit SetLifesteal { caster: c, frac_q8: f, expires_at: e }
  }
}

// Task #138 follow-on (Fortify, mirror of Vampirize at `60115f64`) —
// Fortify's verb body now uses `apply_ability 7 by self target self`
// (see the Fortify verb above). The dispatcher writes
// EffectDamageModifyApplied chronicle records (engine-aliased to
// kind=41) instead of the source-declared SetDamageMod event. This
// rule consumes those records and re-emits SetDamageMod so the rest
// of the cascade (ApplyDamageModActivation writing the per-agent SoA
// fields, then ApplyDamage scaling incoming bleed-through damage by
// `mult_q8/256` while the buff window is active) keeps working
// unchanged — same shape as ApplyLifestealFromChronicle but consuming
// kind=41 records.
//
// PAYLOAD NOTE: same shape as EffectSlowApplied / EffectLifeStealApplied
// (actor + target + expires_at_tick + multiplier_q8). The dispatcher
// writes caster_slot into BOTH actor (slot 2) and target (slot 3) for
// the DamageModify arm (self-cast), so this rule's pattern reads
// `actor: c` and binds the caster id directly into the SetDamageMod
// `target_agent` field. The `expires_at_tick` field is already absolute
// (= tick + duration at chronicle-write time), so the re-emit ferries
// it verbatim into the `expires_at` field — no `world.tick + d`
// recomputation is needed (and recomputing would compound the offset
// since `world.tick` == the chronicle-record's tick at re-emit time).
//
// P6 caveat: this rule is PerEvent + emit-only (no AgentField writes)
// — does NOT trip P6.
@phase(post)
physics ApplyDamageModFromChronicle {
  on EffectDamageModifyApplied { actor: c, target: _, expires_at_tick: e, multiplier_q8: m } {
    emit SetDamageMod { target_agent: c, mult_q8: m, expires_at: e }
  }
}

// Apply damage with shield_hp absorption.
//
// Real shield semantics: incoming damage drains shield_hp before any
// of it bleeds through to hp. With strike_damage retuned from 15 → 30
// (#85), the per-cycle math works: 50-shield ShieldUp absorbs ~1.6
// strikes; net dmg per 120-tick cycle ≈ 60 hp; combat resolves
// around tick 140. Uses pairwise `min()` — emits min_f32 in WGSL,
// resolved via the math-stdlib prelude wired in #84.
@phase(post)
physics ApplyDamage {
  on Damaged { source: src, target: t, amount: a } {
    let s = agents.shield_hp(t);
    let absorbed = min(s, a);
    let bleed_raw = a - absorbed;
    // Wave 2 piece N — DamageModify demo. Read TARGET's damage_taken
    // mult window and, if active, scale bleed-through damage by
    // `mult/256` before subtracting from hp. The SoA default is 256
    // (1.0×) — the expiry-tick gate keeps an EXPIRED buff from
    // applying. The DSL auto-promotes the i16-backed
    // `damage_taken_mult_q8` (read as i32) to f32 in mixed arithmetic
    // via promote_int_to_f32 (cg/lower/expr).
    let mult_q8 = agents.damage_taken_mult_q8(t);
    let mult_expires = agents.damage_taken_mult_expires_at_tick(t);
    let bleed = if (mult_expires > world.tick) {
      bleed_raw * mult_q8 / 256.0
    } else {
      bleed_raw
    };
    agents.set_shield_hp(t, s - absorbed);
    let new_hp = agents.hp(t) - bleed;
    agents.set_hp(t, new_hp);
    if (new_hp <= 0.0) {
      agents.set_alive(t, false);
      emit Defeated { combatant: t }
    }
    // Wave 2 piece N — LifeSteal demo. Read source's lifesteal window
    // and, if active, heal the source for `frac/256 * bleed`. The DSL
    // auto-promotes the i16-backed `lifesteal_frac_q8` (read as i32)
    // to f32 in mixed arithmetic via promote_int_to_f32 (cg/lower/expr).
    let src_frac = agents.lifesteal_frac_q8(src);
    let src_expires = agents.lifesteal_expires_at_tick(src);
    if (src_frac > 0 && src_expires > world.tick && bleed > 0.0) {
      let heal = bleed * src_frac / 256.0;
      emit Healed { source: src, target: src, amount: heal }
    }
  }
}

// Apply healing.
@phase(post)
physics ApplyHeal {
  on Healed { source: _, target: t, amount: a } {
    let new_hp = agents.hp(t) + a;
    agents.set_hp(t, new_hp);
  }
}

// Apply shield — writes the per-agent `shield_hp` SoA buffer (via the
// `set_shield_hp` setter wired in dsl_compiler/cg/lower/physics.rs).
// True shield semantics: shield_hp absorbs incoming damage before hp
// (the absorption side lives in ApplyDamage when we want to model it
// fully — for Wave 1 the shield_hp value just shows up in observability
// and the binding-check still asserts EffectOp::Shield(50.0) lowered).
@phase(post)
physics ApplyShield {
  on Shielded { source: _, target: t, amount: a } {
    let new_shield = agents.shield_hp(t) + a;
    agents.set_shield_hp(t, new_shield);
  }
}

// Apply defeat — drains Defeated events emitted by Reap (and by any
// other future verb that wants to kill outright). The existing
// ApplyDamage block already emits Defeated INLINE on its hp<=0 branch
// (and sets alive=false there), so this block + ApplyDamage's inline
// path both idempotently set alive=false. No write conflict — both
// write the same value.
@phase(post)
physics ApplyDefeat {
  on Defeated { combatant: c } {
    agents.set_alive(c, false);
  }
}

// Apply lifesteal activation — drains SetLifesteal events emitted by
// Vampirize and writes the per-agent lifesteal SoA (frac_q8 + expires
// timestamp). ApplyDamage reads these on each Damaged event to decide
// whether the source heals back a fraction of the damage they dealt.
@phase(post)
physics ApplyLifestealActivation {
  on SetLifesteal { caster: c, frac_q8: f, expires_at: e } {
    agents.set_lifesteal_frac_q8(c, f);
    agents.set_lifesteal_expires_at_tick(c, e);
  }
}

// Apply damage_modify activation — drains SetDamageMod events emitted
// by Fortify and writes the per-agent damage_taken_mult SoA (mult_q8 +
// expires timestamp). ApplyDamage reads these on each Damaged event to
// scale incoming bleed-through damage by `mult_q8/256`.
@phase(post)
physics ApplyDamageModActivation {
  on SetDamageMod { target_agent: t, mult_q8: m, expires_at: e } {
    agents.set_damage_taken_mult_q8(t, m);
    agents.set_damage_taken_mult_expires_at_tick(t, e);
  }
}

// Apply stun activation — drains Stunned events emitted by Daze and
// writes the per-agent hot_stun_expires_at_tick SoA field. Every
// offensive verb's `when` clause reads this field via
// `agents.stun_expires_at_tick(self)` and skips casting when the stun
// window is active. This is the FIRST cast-gate driven by a per-agent
// status SoA field in the codebase.
@phase(post)
physics ApplyStun {
  on Stunned { target_agent: t, expires_at: e } {
    agents.set_stun_expires_at_tick(t, e);
  }
}

// Per-source damage_dealt — observability view.
@materialized(on_event = [Damaged])
view damage_dealt(source: Agent) -> f32 {
  initial: 0.0,
  on Damaged { source: s, target: _, amount: a } { self += a }
  clamp: [0.0, 1000000.0],
}

// Per-source healing_done — observability view (covers BOTH Healed and
// Shielded so the per-tick observability stays comparable to duel_1v1).
@materialized(on_event = [Healed])
view healing_done(source: Agent) -> f32 {
  initial: 0.0,
  on Healed { source: s, target: _, amount: a } { self += a }
  clamp: [0.0, 1000000.0],
}
