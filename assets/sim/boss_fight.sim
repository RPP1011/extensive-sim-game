// boss_fight — first ASYMMETRIC RPG combat fixture.
//
// Composes the duel_1v1 verb cascade + creature_type discriminant
// + multi-event-kind ring into a real RPG-shaped encounter:
//
//   - 1 Boss   (slot 0,        HP=5000, two abilities)
//   - 5 Heroes (slots 1..=5,   HP=200,  two abilities each)
//
// The entity declarations Boss / Hero produce stable u32
// discriminants in EntityRef declaration order:
//   Boss = 0, Hero = 1
// The runtime sets `agent.creature_type[i]` to the corresponding
// discriminant at init so verb predicates `self.creature_type ==
// Boss` / `self.creature_type == Hero` route per-agent verbs to
// the right slot.
//
// SHAPE — four verbs, each gated on `self.creature_type ==
// <expected>` so per-tick only the relevant rules participate:
//
//   BossStrike   — cooldown 10 ticks. Boss-only. Damages picked
//                  hero (scoring iterates per-pair candidates and
//                  argmaxes valid hero targets).
//   BossSelfHeal — cooldown 50 ticks. Boss-only. Self-cast when
//                  self.hp < 1500. Restores 500 HP.
//   HeroAttack   — cooldown 3 ticks. Hero-only. Damages boss
//                  (scoring picks the boss as the only valid
//                  candidate).
//   HeroHeal     — cooldown 20 ticks. Hero-only. Self-cast.
//                  Restores 60 HP. (Picking lowest-HP ally would
//                  hit duel Gap E (target.hp in score routes
//                  through self in PerPair binder shadowing) —
//                  workaround: target == self, score constant.)
//
// HISTORICAL: per-pair mask previously hardcoded mask_k=1u
// (task-5.7), forcing `when` clauses to avoid the `target`
// binder. FIXED in cg/emit/kernel.rs:3356 — mask_k now uses
// cfg.agent_cap and `target` references in `when` clauses
// evaluate every candidate. Below the `when` clauses stay
// self-only by design (target validity is in the score
// expressions), but new authors may freely use `target.<field>`
// in `when` clauses. Target validity is enforced by score
// expressions that read `target.creature_type` and
// `target.alive` (the scoring kernel iterates EVERY candidate
// per actor and argmaxes — see kernel.rs:2790-2820).
//
// PROBE FOCUS — first asymmetric multi-creature-type combat. New
// surfaces vs duel_1v1:
//   1. `creature_type` SoA read in mask + scoring predicates
//      (the field is declared in the AgentSoA but no fixture
//      exercises it as an emit-gate today).
//   2. Non-self target scoring — Boss strikes one of 5 heroes,
//      heroes all strike the same Boss. Tests scoring's per-pair
//      candidate loop with N>2 candidates.
//   3. Multi-phase boss behavior — SelfHeal verb activates only
//      when boss HP is below threshold (composes the cooldown
//      gate with an HP threshold gate, like duel's Heal verb but
//      for Boss against a much higher HP pool).

event Tick { }

@replayable @gpu_amenable
event Damaged {
  source: AgentId,
  target: AgentId,
  amount: f32,
}

@replayable @gpu_amenable
event Healed {
  source: AgentId,
  target: AgentId,
  amount: f32,
}

// Engine-side chronicle event written by the apply_ability dispatcher
// at hardcoded EventKindId 26 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// Task #138 follow-on (boss_fight port, 2026-05-07) — BossStrike and
// HeroAttack verb bodies are now `apply_ability N by self target target`
// (BossStrike=1, HeroAttack=2), which writes EffectDamageApplied
// records into the event ring. The new ApplyDamageFromChronicle
// physics rule (declared below near ApplyDamage) translates these
// records back into the existing `Damaged` event so the rest of the
// cascade (ApplyDamage's per-agent hp decrement + Defeated emit)
// works without modification — same chronicle re-emit pattern the
// duel_abilities + duel_25v25 fixtures use for their damage verbs.
//
// HEALING is intentionally left on the original `emit Healed` path
// — the BossSelfHeal / HeroHeal verbs are out of scope for this
// asymmetric damage port.
@replayable @gpu_amenable
event EffectDamageApplied {
  actor: AgentId,
  target: AgentId,
  amount: f32,
}

// HeroStun control-status proof (boss_fight, 2026-05-07) — engine-side
// chronicle event written by the apply_ability dispatcher at hardcoded
// EventKindId 29 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// The new `verb HeroStun` (added below near HeroAttack) is now
// `apply_ability 3 by self target target`, which the dispatcher
// translates to a kind=29 EffectStunApplied record with
// `expires_at_tick = world.tick + 15` (the dispatcher pre-computes the
// absolute tick from EffectOp::Stun{duration_ticks=15}). The new
// `physics ApplyStunFromChronicle @phase(post)` rule below drains
// these records straight into the per-agent `stun_expires_at_tick` SoA
// via `agents.set_stun_expires_at_tick(t, e)`. First non-Damage
// EffectOp in this fixture — proves control-status dispatch lands in
// the asymmetric 1-vs-N RPG combat shape (heroes ganging up to lock
// the boss). Mirrors duel_25v25's ConcussiveCleave shape, single-target
// rather than AOE.
@replayable @gpu_amenable
event EffectStunApplied {
  actor: AgentId,
  target: AgentId,
  expires_at_tick: u32,
}

// HeroHeal apply_ability proof (boss_fight, 2026-05-07) — engine-side
// chronicle event written by the apply_ability dispatcher at hardcoded
// EventKindId 27 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// HeroHeal's verb body is `apply_ability 4 by self target target`,
// which the dispatcher translates to a kind=27 EffectHealApplied
// record carrying the registry-resident `EffectOp::Heal{ amount: 25.0 }`.
// The new `physics ApplyHealFromChronicle @phase(post)` rule below
// drains these records into a clamped
// `agents.set_hp(t, min(agents.hp(t) + amt, agents.max_hp(t)))` write.
// First Heal EffectOp in this fixture — proves the apply_ability
// dispatcher routes Heal effects through the chronicle path in the
// asymmetric 1-vs-N RPG combat shape (heroes healing each other when
// HP runs low). Mirrors duel_25v25's HealPulse shape, single-target
// per-pair rather than spatial.
@replayable @gpu_amenable
event EffectHealApplied {
  actor: AgentId,
  target: AgentId,
  amount: f32,
}

@replayable @gpu_amenable
event Defeated {
  combatant: AgentId,
}

// IMPORTANT — declaration order pins creature_type discriminants:
//   Boss = 0
//   Hero = 1
// Runtime initialises agent_creature_type[0] = 0 (Boss),
// agent_creature_type[1..6] = 1 (Hero).
entity Boss : Agent {
  pos: vec3,
  vel: vec3,
}

entity Hero : Agent {
  pos: vec3,
  vel: vec3,
}

config combat {
  // Boss abilities
  boss_strike_damage: f32 = 50.0,
  boss_heal_amount:   f32 = 400.0,
  boss_heal_threshold: f32 = 1500.0,
  // Hero abilities (tuned so 3-4 heroes alive can outpace boss
  // self-heal: per 50 ticks, 4 alive heroes deal 4 × 35 × 50/3 ≈
  // 2333 dmg vs +400 boss heal per 50 ticks ≈ net -1933 per cycle).
  hero_attack_damage: f32 = 35.0,
  hero_heal_amount:   f32 = 60.0,
  // Cooldown literals — kept for reference; today the .sim hardcodes
  // numeric ticks in the `when` clauses because `world.tick % config...`
  // would resolve `config.combat.<u32>` to f32 at lowering (per
  // diplomacy_probe Gap #3).
  cooldown_boss_strike: u32 = 10,
  cooldown_boss_heal:   u32 = 50,
  cooldown_hero_attack: u32 = 3,
  cooldown_hero_heal:   u32 = 20,
}

// ---------------------------------------------------------------------------
// Boss verbs
// ---------------------------------------------------------------------------

// BossStrike — Boss attacks a hero every 10 ticks. Score expression
// validates target type + alive (scoring kernel iterates all
// candidates; only candidates whose check returns the high score
// win argmax). Invalid candidates (other Boss / dead heroes / self)
// receive a sentinel-low score and never win.
//
// Score returns 1.0 when target is an alive Hero, -1000.0 otherwise.
// argmax across 6 candidates picks the first alive hero (deterministic
// — slot order). Hero damage is uniformly 50 per strike.
// Task #138 follow-on (boss_fight port, 2026-05-07) — BossStrike's
// verb body now uses `apply_ability 1 by self target target`.
// AbilityId(1) is BossStrike's slot in the boss_fight AbilityRegistry
// built by `crates/boss_fight_runtime/src/binding_check.rs::
// build_boss_fight_registry` (BossStrike registered first, HeroAttack
// second). The dispatcher writes EffectDamageApplied chronicle records
// (kind=26) carrying `config.combat.boss_strike_damage = 50.0` (the
// registry-resident program's `EffectOp::Damage { amount: 50.0 }`);
// `ApplyDamageFromChronicle` re-emits as Damaged so the existing
// ApplyDamage cascade keeps draining HP unchanged.
//
// CREATURE-TYPE GATE NOTE: the verb's `when` clause keeps
// `self.creature_type == Boss` because today's apply_ability `when`
// predicates can't reference creature_type — the body-side mask
// gate stays load-bearing for routing per-tick to Boss-only verbs.
verb BossStrike(self, target: Agent) =
  action BossStrikeAction
  when (self.alive
        && self.creature_type == Boss
        && (world.tick % 10 == 0))
  apply_ability 1 by self target target
  score (if (target.alive && target.creature_type == Hero) { 1.0 } else { -1000.0 })

// BossSelfHeal — Boss heals self when low. Target binder is unused
// in the emit (target = self structurally), but the verb still
// declares `target: Agent` so the mask routes through PerPair (the
// only way to access score / scoring on a verb today). Score is a
// large constant so SelfHeal beats BossStrike on the heal tick when
// the HP gate fires.
//
// HP gate is in `when` (self-only — historically the mask
// kernel's mask_k=1u hardcoding required this; FIXED, but
// keeping the self-only `when` clause anyway since target
// validity is in the score expression).
verb BossSelfHeal(self, target: Agent) =
  action BossSelfHealAction
  when (self.alive
        && self.creature_type == Boss
        && (world.tick % 50 == 0)
        && self.hp < config.combat.boss_heal_threshold)
  emit Healed { source: self, target: self, amount: config.combat.boss_heal_amount }
  score 100.0

// ---------------------------------------------------------------------------
// Hero verbs
// ---------------------------------------------------------------------------

// HeroAttack — every 3 ticks each Hero attacks the Boss. The score
// expression picks the boss (slot whose creature_type == Boss).
// Task #138 follow-on (boss_fight port, 2026-05-07) — HeroAttack's
// verb body now uses `apply_ability 2 by self target target`.
// AbilityId(2) is HeroAttack's slot in the boss_fight AbilityRegistry
// (BossStrike=1, HeroAttack=2 in registration order). The dispatcher
// writes EffectDamageApplied chronicle records (kind=26) carrying
// `config.combat.hero_attack_damage = 35.0` (the registry-resident
// program's `EffectOp::Damage { amount: 35.0 }`);
// `ApplyDamageFromChronicle` re-emits as Damaged so the existing
// ApplyDamage cascade keeps draining HP unchanged. Tests asymmetric
// damage routing alongside BossStrike — both verbs feed the same
// EffectDamageApplied chronicle channel, but the registry program
// for each carries its own per-side amount.
verb HeroAttack(self, target: Agent) =
  action HeroAttackAction
  when (self.alive
        && self.creature_type == Hero
        && (world.tick % 3 == 0))
  apply_ability 2 by self target target
  score (if (target.alive && target.creature_type == Boss) { 1.0 } else { -1000.0 })

// HeroStun — every 7 ticks each Hero stuns the Boss. HeroStun control-
// status proof (boss_fight, 2026-05-07) — first non-Damage offensive
// verb in this fixture. Hero-only (`self.creature_type == Hero` mask
// gate, same as HeroAttack). The verb's score expression mirrors
// HeroAttack's `target.creature_type == Boss` argmax — every alive
// Hero on its eligible cycle picks the Boss as its argmax target. The
// 7-tick cadence overlaps with HeroAttack's 3-tick cadence at ticks
// 0 and 21 (LCM(3,7) = 21); on those overlap ticks the scoring argmax
// picks HeroStun over HeroAttack because score base 2.0 > HeroAttack's
// 1.0. On pure-HeroStun ticks (% 7 == 0 with % 3 != 0, e.g. tick 7,
// 14), only HeroStun is eligible for heroes and lands as their argmax
// pick.
//
// Body: `apply_ability 3 by self target target`. AbilityId(3) is
// HeroStun's slot in the boss_fight AbilityRegistry built by
// `crates/boss_fight_runtime/src/binding_check.rs::
// build_boss_fight_registry` (BossStrike=1, HeroAttack=2, HeroStun=3
// in registration order). The dispatcher writes EffectStunApplied
// chronicle records (engine kind=29) carrying `expires_at_tick =
// world.tick + 15`; the new ApplyStunFromChronicle physics rule below
// (auto-fused with ApplyDamageFromChronicle by the lower pass) consumes
// them straight into the per-agent stun_expires_at_tick SoA via
// `agents.set_stun_expires_at_tick(t, e)`.
//
// COOLDOWN NOTE: same as BossStrike + HeroAttack — the registry-resident
// HeroStun program declares `cooldown_ticks: 0`; the per-tick gate
// stays in the verb-style `world.tick % 7 == 0` clause below since the
// GPU dispatcher does not consult program.cooldown_ticks at the
// apply_ability arm today.
verb HeroStun(self, target: Agent) =
  action HeroStunAction
  when (self.alive
        && self.creature_type == Hero
        && (world.tick % 7 == 0))
  apply_ability 3 by self target target
  // Score base 2.0 sits above HeroAttack's 1.0 so on overlap ticks
  // (every 21 ticks) the argmax picks HeroStun and the
  // EffectStunApplied chronicle fires.
  score (if (target.alive && target.creature_type == Boss) { 2.0 } else { -1000.0 })

// HeroHeal apply_ability proof (boss_fight, 2026-05-07) — every 7 ticks
// each Hero heals a same-team ally with low HP. Replaces the previous
// self-cast `emit Healed` shape with the chronicle-pipeline
// `apply_ability 4 by self target target` dispatch.
//
// AbilityId(4) is HeroHeal's slot in the boss_fight AbilityRegistry
// built by `crates/boss_fight_runtime/src/binding_check.rs::
// build_boss_fight_registry` (BossStrike=1, HeroAttack=2, HeroStun=3,
// HeroHeal=4 in registration order). The dispatcher writes
// EffectHealApplied chronicle records (engine kind=27) carrying the
// `EffectOp::Heal { amount: 25.0 }` payload; the new
// ApplyHealFromChronicle physics rule below consumes them straight
// into the per-agent hp SoA via `agents.set_hp(t, min(agents.hp(t)
// + amt, agents.max_hp(t)))` — clamped at the per-agent max_hp column
// (init 100.0 across all slots) so multiple healers racing on the same
// target can't drive hp above the ceiling.
//
// SCORE (per-pair argmax over candidates): pick the lowest-hp friendly
// hero with hp < 100.0. `target.hp < 100.0` gates out healthy heroes —
// when no hero ally is below the threshold the row returns -1000.0
// sentinel and the actor's argmax falls through to HeroAttack /
// HeroStun (this is HOW the existing `hero_stun_locks_boss` and the
// HP-movement tests stay green: at full hp every alive hero, HeroHeal
// is sentinel-suppressed and HeroStun's score 2.0 wins as before).
//
// `target != self` filters self-pair scoring (would otherwise be the
// dominant candidate for a low-hp self). `target.creature_type ==
// Hero` rules out the boss (heroes only heal heroes). `target.alive`
// keeps the row from picking a dead slot.
//
// COOLDOWN NOTE: same as BossStrike + HeroAttack + HeroStun — the
// registry-resident HeroHeal program declares `cooldown_ticks: 0`;
// the per-tick gate stays in the verb-style `world.tick % 7 == 0`
// clause below since the GPU dispatcher does not consult
// program.cooldown_ticks at the apply_ability arm today.
verb HeroHeal(self, target: Agent) =
  action HeroHealAction
  when (self.alive
        && self.creature_type == Hero
        && (world.tick % 7 == 0))
  apply_ability 4 by self target target
  // Lowest-hp friendly hero (only healthy heroes excluded; self can
  // self-heal — the lowest-hp hero will be the actor's own target if
  // it's the wounded one, since `target.hp < 100.0` qualifies it the
  // same way as any other below-threshold ally). The 1000.0 base keeps
  // the score safely above HeroStun's 2.0 / HeroAttack's 1.0 when a
  // wounded ally exists; sentinel -1000.0 cedes the argmax to those
  // rows when no ally needs healing.
  //
  // GAP NOTE: `target != self` originally filtered self-pair scoring
  // but trips the verb-expander binder shadowing — `self` lowers to
  // an undefined `local_3` in the scoring WGSL (same Gap E reported
  // in duel_1v1's Heal verb and mass_battle's Strike score). Working
  // around by allowing self-target: the lowest-hp hero is the
  // optimal heal target regardless of whether the caster IS that
  // hero, so dropping the filter is observationally equivalent for
  // this test (the wounded slot becomes the universal argmax pick
  // for every alive hero, including itself).
  score (if (target.alive
             && target.creature_type == Hero
             && target.hp < 100.0) { 1000.0 - target.hp } else { -1000.0 })

// ---------------------------------------------------------------------------
// Chronicle physics (mirrors duel_1v1 shape)
// ---------------------------------------------------------------------------

// Task #138 follow-on (boss_fight port, 2026-05-07) — BossStrike +
// HeroAttack verb bodies now use `apply_ability N by self target
// target`. The dispatcher writes EffectDamageApplied chronicle records
// (engine-aliased to kind=26) instead of the source-declared Damaged
// event. This rule consumes those records and re-emits Damaged so the
// rest of the cascade (ApplyDamage's per-agent hp decrement + Defeated
// emit) keeps working unchanged. Mirrors the chronicle re-emit shape
// duel_abilities + duel_25v25 use for their damage-dealing verbs.
//
// P6 caveat: this rule is PerEvent + emit-only (no AgentField writes)
// — does NOT trip P6, unlike ApplyDamage below.
@phase(post)
physics ApplyDamageFromChronicle {
  on EffectDamageApplied { actor: a, target: t, amount: amt } {
    emit Damaged { source: a, target: t, amount: amt }
  }
}

// HeroStun control-status proof (boss_fight, 2026-05-07) — chronicle
// consumer for the kind=29 EffectStunApplied records the new HeroStun
// verb writes. The dispatcher pre-computes `expires_at_tick =
// world.tick + duration_ticks` at chronicle-write time (see Stun arm in
// `cg/emit/wgsl_body.rs`), so this rule ferries the absolute tick
// verbatim into the per-agent `stun_expires_at_tick` SoA slot via
// `agents.set_stun_expires_at_tick(t, e)`. Mirror of duel_25v25's
// ApplyStunFromChronicle and mass_battle_100v100's same-name rule —
// fourth site of this single-rule shape (no Stunned re-emit since this
// fixture has no other Stunned consumer).
//
// AUTO-FUSION: this rule and ApplyDamageFromChronicle both run
// @phase(post) over the same event ring with non-overlapping kind tags
// (26 vs 29), so the lower pass folds them into ONE kernel
// (`physics_ApplyDamageFromChronicle_and_ApplyStunFromChronicle`) —
// same fusion duel_25v25 + mass_battle_100v100 surfaced.
//
// P6 caveat: this rule is PerEvent + writes an AgentField — TRIPS P6
// in the well_formed checker. boss_fight's build.rs already tolerates
// lower diagnostics (matches `lower_compilation_to_cg` on
// `DriverOutcome::Err` and falls through with the partial program), so
// the rule lowers regardless. Same tolerance pattern duel_abilities +
// duel_25v25 + mass_battle_100v100 use for their AgentField writes
// from chronicle physics.
@phase(post)
physics ApplyStunFromChronicle {
  on EffectStunApplied { actor: _, target: t, expires_at_tick: e } {
    agents.set_stun_expires_at_tick(t, e);
  }
}

// HeroHeal apply_ability proof (boss_fight, 2026-05-07) — chronicle
// consumer for the kind=27 EffectHealApplied records the new HeroHeal
// verb writes. Direct-SoA-write shape (matches ApplyStunFromChronicle
// above; mirrors duel_25v25's same-name rule). Clamps overflow with
// `min(hp + amt, max_hp)` so multiple healers racing on the same target
// can't drive hp above the per-agent ceiling.
//
// FUSION EXPECTATION (3-way): the lower pass already fused
// ApplyDamageFromChronicle (kind=26) + ApplyStunFromChronicle (kind=29)
// into a 2-way `_and_` kernel. This rule should auto-include into a
// 3-way fusion: same @phase(post), PerEvent over the same event ring,
// non-overlapping kind tag (27). The resulting kernel is
// `physics_ApplyDamageFromChronicle_and_ApplyHealFromChronicle_and_ApplyStunFromChronicle`
// (kernel-namer alphabetises; bindings grow by `agent_hp` +
// `agent_max_hp` reads). Same fusion duel_25v25 surfaced when adding
// HealPulse to its 2-way fusion.
//
// P6 caveat: this rule is PerEvent + writes an AgentField (hp) — TRIPS
// P6 in the well_formed checker. boss_fight's build.rs already
// tolerates lower diagnostics (matches `lower_compilation_to_cg` on
// `DriverOutcome::Err` and falls through with the partial program), so
// the rule lowers regardless. Same tolerance pattern duel_abilities +
// duel_25v25 + mass_battle_100v100 use for their AgentField writes
// from chronicle physics.
@phase(post)
physics ApplyHealFromChronicle {
  on EffectHealApplied { actor: _, target: t, amount: amt } {
    agents.set_hp(t, min(agents.hp(t) + amt, agents.max_hp(t)));
  }
}

// Apply damage. On Damaged event, reduce target HP. If <= 0, set
// alive = false and emit Defeated.
@phase(post)
physics ApplyDamage {
  on Damaged { source: _, target: t, amount: a } {
    let new_hp = agents.hp(t) - a;
    agents.set_hp(t, new_hp);
    if (new_hp <= 0.0) {
      agents.set_alive(t, false);
      emit Defeated { combatant: t }
    }
  }
}

// Apply healing. No HP cap clamp today (duel doesn't either).
@phase(post)
physics ApplyHeal {
  on Healed { source: _, target: t, amount: a } {
    let new_hp = agents.hp(t) + a;
    agents.set_hp(t, new_hp);
  }
}

// ---------------------------------------------------------------------------
// Observability views
// ---------------------------------------------------------------------------

// Per-source damage_dealt — accumulator for ability fire-counts
// (since each verb deals fixed damage, count = damage / amount).
@materialized(on_event = [Damaged])
view damage_dealt(source: Agent) -> f32 {
  initial: 0.0,
  on Damaged { source: s, target: _, amount: a } { self += a }
  clamp: [0.0, 1000000.0],
}

// Per-source healing_done — same shape.
@materialized(on_event = [Healed])
view healing_done(source: Agent) -> f32 {
  initial: 0.0,
  on Healed { source: s, target: _, amount: a } { self += a }
  clamp: [0.0, 1000000.0],
}
