// tactical_squad_5v5 — FIFTH real gameplay-shaped fixture (sequence:
// duel_1v1 → duel_25v25 → foraging_real → predator_prey_real → THIS).
//
// First sim aimed at the actual game's combat surface (Deterministic
// Tactical Orchestration RPG). Composition: 5 vs 5 with role split.
//   - Per team: 1 Tank + 1 Healer + 3 DPS
//   - 10 agents total, indexed: Red[0..5], Blue[5..10]
//
// ARCHITECTURAL DIFFERENTIATOR (vs duel_1v1 / duel_25v25):
//
// duel_1v1 had three verbs but TRIVIAL targeting (always self or
// self.target). The Spell verb's `score (50 - target.hp)` was
// pair-field but the duel only had two combatants — the per-pair
// argmax trivially picked "the other guy" every time.
//
// THIS sim actually USES pair-field scoring for target selection:
//   - DPS Snipe: argmax over `(200.0 - target.hp)` → picks lowest-HP enemy
//   - Healer Heal: argmax over `(200.0 - target.hp)` → picks lowest-HP ally
// The per-pair candidate enumeration is what differentiates the
// scoring kernel from a per-agent scan; this sim drives 10 actors ×
// 10 candidates per tick = 100 (actor, target) evaluations.
//
// ENCODING:
//   - `creature_type` discriminant carries the ROLE: Tank=0, Healer=1, Dps=2.
//     Three `entity X : Agent` declarations → declaration-order indices
//     0/1/2 (per the `IrExpr::Entity(EntityRef)` lowering in
//     `cg::lower::expr.rs:644`).
//   - `level` (u32 SoA) carries the TEAM: Red=0, Blue=1. The runtime
//     sets each agent's level slot at init.
//
// The verbs gate on `self.creature_type == <Role>` (only the matching
// role fires) AND `target.level != self.level` (enemies) or
// `target.level == self.level` (allies) — combining the two
// discriminants gives full role × team routing without needing a
// 6-entity-type Cartesian product.
//
// COMBAT EVENTS:
//   - `Damaged{source, target, amount}` — Strike + Snipe both emit
//   - `Healed {source, target, amount}` — Heal emits
//   - `Defeated{combatant}` — chronicle ApplyDamage emits when HP <= 0
//
// CYCLE WARNINGS (deferred — same as duel_1v1):
//   - chronicle ApplyDamage writes hp/alive; mask + scoring read hp/alive
//   - this surfaces as a `cycle in read/write graph` lower warning that
//     the build script tolerates (warning, not error)

event Tick { }

@replayable @gpu_amenable
event Damaged {
  source: AgentId,
  target: AgentId,
  amount: f32,
}

// Engine-side chronicle event written by the apply_ability dispatcher
// at hardcoded EventKindId 26 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// Task #138 follow-on (tactical_squad_5v5 port, 2026-05-07) — Strike
// (Tank) and Snipe (DPS) verb bodies now dispatch via apply_ability
// instead of inline `emit Damaged`. The dispatcher writes
// EffectDamageApplied records into the event ring; the new
// ApplyDamageFromChronicle physics rule (declared below near
// ApplyDamage) re-emits these records as `Damaged` so the rest of the
// cascade (ApplyDamage's per-agent hp decrement + Defeated emit) and
// the `damage_dealt` view fold keep working unchanged. Same chronicle
// re-emit pattern duel_abilities + duel_25v25 use.
//
// Heal stays on the existing `Healed` chronicle path (apply_ability
// swap for Heal is followup, not in this slice).
@replayable @gpu_amenable
event EffectDamageApplied {
  actor: AgentId,
  target: AgentId,
  amount: f32,
}

// ConcussiveBlow control-status proof (5v5 scale, 2026-05-07) —
// engine-side chronicle event written by the apply_ability dispatcher
// at hardcoded EventKindId 29 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`).
//
// The new `verb ConcussiveBlow` (added below near Snipe) is now
// `apply_ability 3 by self target target`, which the dispatcher
// translates to a kind=29 EffectStunApplied record with
// `expires_at_tick = world.tick + 20` (the dispatcher pre-computes
// the absolute tick from EffectOp::Stun{duration_ticks=20}). The new
// `physics ApplyStunFromChronicle @phase(post)` rule below drains
// these records straight into the per-agent `stun_expires_at_tick`
// SoA via `agents.set_stun_expires_at_tick(t, e)`. First non-Damage
// EffectOp in this fixture — proves control-status dispatch works at
// the same 5v5 pair-field scale Strike + Snipe operate at. Mirrors
// mass_battle_100v100's StunBolt third-site pattern (commit
// 67b61aa2).
@replayable @gpu_amenable
event EffectStunApplied {
  actor: AgentId,
  target: AgentId,
  expires_at_tick: u32,
}

// SquadHeal (single-target ally heal, 2026-05-07) — engine-side
// chronicle event written by the apply_ability dispatcher at hardcoded
// EventKindId 27 (see
// `dsl_ast::engine_events::engine_event_kind_id_for_name`). Same
// payload shape as EffectDamageApplied (kind=26) and EffectHealApplied
// in duel_25v25 (commit 049feb0c — third site of this pattern). The
// new ApplyHealFromChronicle physics rule below drains kind=27 records
// straight into a clamped `agents.set_hp(t, min(hp + amt, max_hp))`
// write.
//
// Fixture-shape note: tactical_squad_5v5 already has the legacy
// `Healed` chronicle event + `ApplyHeal` rule consumed by the existing
// Healer's `Heal` verb. SquadHeal sits ALONGSIDE that path on the new
// chronicle dispatcher arm — `Heal` keeps emitting Healed via the
// per-agent kernel; SquadHeal emits EffectHealApplied via the verb
// chronicle kernel and the `view healing_done` fold ignores kind=27
// (only sees Healed). Two independent paths share no SoA state.
@replayable @gpu_amenable
event EffectHealApplied {
  actor: AgentId,
  target: AgentId,
  amount: f32,
}

@replayable @gpu_amenable
event Healed {
  source: AgentId,
  target: AgentId,
  amount: f32,
}

@replayable @gpu_amenable
event Defeated {
  combatant: AgentId,
}

// Three role entities — declaration order pins the discriminant
// (Tank=0, Healer=1, Dps=2). The runtime writes each agent's
// creature_type slot to the appropriate index at spawn.
entity Tank   : Agent { pos: vec3, vel: vec3, }
entity Healer : Agent { pos: vec3, vel: vec3, }
entity Dps    : Agent { pos: vec3, vel: vec3, }

config combat {
  // Per-role attack / heal magnitudes. DPS hits hardest per shot
  // but on a longer cooldown; Tank chips steadily; Healer keeps the
  // front line up.
  tank_damage:    f32 = 10.0,
  dps_damage:     f32 = 22.0,
  heal_amount:    f32 = 18.0,
  // Cooldown gates expressed as `world.tick % N == 0` mod arms with
  // integer literals — per-verb cadences are co-located with the verb
  // bodies below for readability rather than centralised here as
  // `cooldown_*: u32` config fields. (Gap #3 of diplomacy_probe is
  // closed, so the canonical `world.tick % config.combat.cooldown_<v>`
  // shape lowers cleanly; a future tuning pass can lift the cadences
  // into the config block without compiler help.)
  // Tank fires every 3rd tick, DPS every 4th, Healer every 3rd.
}

// -------------------------------------------------------------------
// Strike — Tank's basic attack. Pair-field score `(100.0 - target.hp)`
// — picks the LOWEST-HP enemy, same shape as Snipe but with tank
// damage (lower per hit) and a tighter cooldown. Pair-field score is
// REQUIRED here even though Tank "any enemy in range" was the design
// intent: a constant score (`score 1.0`) leaves `best_target` at the
// `0xFFFFFFFFu` sentinel because the scoring kernel only writes
// `best_target` inside the per-pair-candidate inner loop, and
// constant scores don't trigger that loop. The Damaged event then
// emits with `target = 0xFFFFFFFF`, which the ApplyDamage chronicle
// dereferences as `agent_hp[0xFFFFFFFF]` — an out-of-bounds write
// that silently nulls the damage. (Discovered when Tank dmg_dealt
// view accumulated correctly but no agent's HP ever decremented from
// Strike.)
// -------------------------------------------------------------------
verb Strike(self, target: Agent) =
  action StrikeAction
  when (self.alive
        && target.alive
        && target != self
        && self.creature_type == Tank
        && target.level != self.level
        && (world.tick % 3 == 0))
  // Task #138 follow-on (tactical_squad_5v5 port, 2026-05-07) —
  // Strike was `emit Damaged { source: self, target: target, amount:
  // config.combat.tank_damage }`. The literal `1` is TankAttack's
  // AbilityId in the tactical_squad_5v5 AbilityRegistry built by
  // `crates/tactical_squad_5v5_runtime/src/binding_check.rs`
  // (TankAttack registers first → AbilityId(1); DpsAttack second →
  // AbilityId(2)). The dispatcher writes EffectDamageApplied
  // chronicle records (kind=26); ApplyDamageFromChronicle below
  // re-emits as Damaged so ApplyDamage's HP drain + Defeated emit
  // (and the `damage_dealt` fold) keep working unchanged.
  //
  // CONFIG → REGISTRY BRIDGE: the dispatcher's literal damage amount
  // is hardcoded in the runtime's hand-built program (10.0, matching
  // `config.combat.tank_damage = 10.0`). apply_ability's pack-time
  // literal API doesn't accept config refs, so the runtime mirrors
  // the config default. If `tank_damage` ever drifts, the
  // binding-check assertion in `binding_check.rs` flags the
  // divergence at startup.
  apply_ability 1 by self target target
  // Filter dead candidates: their hp is negative (driven down by
  // continued post-mortem damage when no alive-check happens), so a
  // dead target's `(C - target.hp)` term would dominate the argmax
  // (e.g. dead at hp=-718 gives score ~818, way above any alive
  // target). Multiply by `select(0.0, 1.0, target.alive)` to zero
  // out dead candidates' utility. The `select(false_val, true_val,
  // cond)` shape matches `cg::expr::CgExpr::Select` lowering (see
  // `cg::lower::expr::lower_select`).
  score (if target.alive { 100.0 - target.hp } else { -1000000.0 })

// -------------------------------------------------------------------
// Snipe — DPS picks the LOWEST-HP enemy. Pair-field score
// `(200.0 - target.hp)` — the per-pair argmax sees every (actor,
// candidate) pair, picks the candidate with the smallest hp value
// (largest score under inversion). This is THE CORE DIFFERENTIATOR
// of this sim from duel_1v1: with 5 enemies on the other team, the
// argmax actually picks one specific target out of multiple.
// -------------------------------------------------------------------
verb Snipe(self, target: Agent) =
  action SnipeAction
  when (self.alive
        && target.alive
        && target != self
        && self.creature_type == Dps
        && target.level != self.level
        && (world.tick % 4 == 0))
  // Task #138 follow-on (tactical_squad_5v5 port, 2026-05-07) —
  // Snipe was `emit Damaged { source: self, target: target, amount:
  // config.combat.dps_damage }`. The literal `2` is DpsAttack's
  // AbilityId in the tactical_squad_5v5 AbilityRegistry (TankAttack=1,
  // DpsAttack=2). Same chronicle re-emit shape as Strike above —
  // dispatcher writes EffectDamageApplied(kind=26),
  // ApplyDamageFromChronicle re-emits as Damaged.
  //
  // CONFIG → REGISTRY BRIDGE: damage amount hardcoded in the runtime
  // as 22.0 (matches `config.combat.dps_damage = 22.0`). Same
  // bridge caveat as Strike — pack-time literals don't accept config
  // refs today.
  apply_ability 2 by self target target
  // Same dead-target filter as Strike — without `target.alive` in the
  // score expression, post-mortem `target.hp` driven negative by
  // continued targeting would dominate the argmax forever.
  score (if target.alive { 200.0 - target.hp } else { -1000000.0 })

// -------------------------------------------------------------------
// ConcussiveBlow — DPS picks an enemy and stuns them for 20 ticks.
// FIRST non-Damage offensive verb in this fixture (control-status
// proof at 5v5 scale, 2026-05-07). Same role gate as Snipe (DPS,
// enemy-team) but at a slower cadence (`world.tick % 7 == 0` vs
// Snipe's `% 4 == 0`) so the two verbs interleave: on ticks where
// both gates pass (every 28 ticks), the scoring kernel's argmax picks
// ConcussiveBlow because its score base (300.0 - target.hp) sits
// above Snipe's (200.0 - target.hp) baseline. On non-overlapping
// ticks Snipe still fires (% 4 == 0 with % 7 != 0). On pure
// ConcussiveBlow ticks (% 7 == 0 with % 4 != 0, e.g. tick 7), only
// ConcussiveBlow is eligible for DPS actors and lands as their
// argmax pick uncontested.
//
// Body: `apply_ability 3 by self target target`. The literal `3` is
// ConcussiveBlow's AbilityId in the tactical_squad_5v5
// AbilityRegistry built by
// `crates/tactical_squad_5v5_runtime/src/binding_check.rs::
// build_tactical_squad_5v5_registry` (TankAttack=1, DpsAttack=2,
// ConcussiveBlow=3 in registration order). The dispatcher writes
// EffectStunApplied chronicle records (engine kind=29) carrying
// `expires_at_tick = world.tick + 20`; the new ApplyStunFromChronicle
// physics rule below (auto-fused with ApplyDamageFromChronicle by the
// lower pass) consumes them straight into the per-agent
// stun_expires_at_tick SoA via `agents.set_stun_expires_at_tick(t,
// e)`.
//
// COOLDOWN NOTE: same as Strike + Snipe — the registry-resident
// ConcussiveBlow program declares `cooldown_ticks: 0`; the per-tick
// gate stays in the verb-style `world.tick % 7 == 0` clause below
// since the GPU dispatcher does not consult program.cooldown_ticks
// at the apply_ability arm today.
// -------------------------------------------------------------------
verb ConcussiveBlow(self, target: Agent) =
  action ConcussiveBlowAction
  when (self.alive
        && target.alive
        && target != self
        && self.creature_type == Dps
        && target.level != self.level
        && (world.tick % 7 == 0))
  apply_ability 3 by self target target
  // Score base 300.0 sits above Snipe (200.0) so when ConcussiveBlow's
  // % 7 cadence overlaps with Snipe's % 4 cadence on shared DPS
  // actors (every 28 ticks), the argmax picks ConcussiveBlow and the
  // EffectStunApplied chronicle fires. Same dead-target filter as
  // Snipe — without `target.alive` in the score expression,
  // post-mortem `target.hp` driven negative by continued targeting
  // would dominate the argmax forever.
  score (if target.alive { 300.0 - target.hp } else { -1000000.0 })

// -------------------------------------------------------------------
// Heal — Healer picks the LOWEST-HP ally. Same pair-field score
// shape as Snipe but inverted target predicate (`target.level ==
// self.level` — same team). Targeting `self` is permitted so a
// solo healer can heal themselves; the "skip if all allies above
// 90%" gate is handled implicitly by the inverted score (high-HP
// allies score low — Heal still fires but on the lowest-HP ally
// regardless, because there's no urgency threshold gate today).
// -------------------------------------------------------------------
verb Heal(self, target: Agent) =
  action HealAction
  when (self.alive
        && target.alive
        && self.creature_type == Healer
        && target.level == self.level
        && (world.tick % 3 == 0))
  emit Healed { source: self, target: target, amount: config.combat.heal_amount }
  // Same dead-ally filter — once a healer's only ally drops below 0,
  // we don't want to keep healing the corpse. Once an ally's alive=0,
  // the score collapses to -infinity-ish and the next-lowest alive
  // ally takes over.
  score (if target.alive { 200.0 - target.hp } else { -1000000.0 })

// -------------------------------------------------------------------
// SquadHeal — apply_ability-dispatched ally heal (chronicle pipeline,
// 2026-05-07). FIFTH verb in the source-order, action_id=4 (Strike=0,
// Snipe=1, ConcussiveBlow=2, Heal=3, SquadHeal=4). Mirrors duel_25v25's
// HealPulse third-site pattern (commit 049feb0c) but at 5v5 pair-field
// scale — the score expression replaces duel_25v25's spatial walk.
//
// Cadence `world.tick % 7 == 0` matches ConcussiveBlow's, deliberately
// out-of-phase with TankAttack (`% 3`), DpsAttack (`% 4`), and Heal
// (`% 3`); ticks 0, 7, 14, 21 see SquadHeal fire while the existing
// damage cadence has by then drained some HP for it to recover. Body:
// `apply_ability 4 by self target target`. The literal `4` is
// SquadHeal's AbilityId in the tactical_squad_5v5 AbilityRegistry built
// by `crates/tactical_squad_5v5_runtime/src/binding_check.rs::
// build_tactical_squad_5v5_registry` (TankAttack=1, DpsAttack=2,
// ConcussiveBlow=3, SquadHeal=4 in registration order). The
// dispatcher writes EffectHealApplied chronicle records (engine
// kind=27) carrying `amount = 12.0`; the new
// ApplyHealFromChronicle physics rule below (auto-fused 3-way with
// ApplyDamageFromChronicle + ApplyStunFromChronicle by the lower
// pass) consumes them straight into the per-agent `hp` SoA via
// `agents.set_hp(t, min(hp + amt, max_hp))`.
//
// TARGET PREDICATE — same-TEAM friendly: `target.level == self.level
// && target != self`. The `target != self` filter prevents
// self-healing (the verb's argmax inner loop visits self as a
// candidate; without the inequality, a healthy caster healing itself
// would dominate the argmax over a low-HP teammate). No role gate —
// any alive agent on the team can cast (Tank, Healer, and DPS all
// compete to heal the most-injured ally), so 5 friendlies × 1 cadence
// gives more heal volume than the existing single-Healer `Heal` verb
// at `% 3`. Score `(200.0 - target.hp)` peaks for the lowest-HP ally,
// matching the existing Heal verb's argmax shape.
//
// COOLDOWN NOTE: same as Strike + Snipe + ConcussiveBlow + Heal — the
// registry-resident SquadHeal program declares `cooldown_ticks: 0`;
// the per-tick gate stays in the verb-style `world.tick % 7 == 0`
// clause since the GPU dispatcher does not consult
// program.cooldown_ticks at the apply_ability arm today.
// -------------------------------------------------------------------
verb SquadHeal(self, target: Agent) =
  action SquadHealAction
  when (self.alive
        && target.alive
        && target != self
        && target.level == self.level
        && (world.tick % 7 == 0))
  apply_ability 4 by self target target
  // Score peaks for the lowest-HP ally on the same team. Same
  // dead-target filter as Heal — without `target.alive` in the score
  // expression, post-mortem `target.hp` driven negative by continued
  // damage would dominate the argmax forever.
  score (if target.alive { 200.0 - target.hp } else { -1000000.0 })

// -------------------------------------------------------------------
// Task #138 follow-on (tactical_squad_5v5 port, 2026-05-07) — Strike
// (Tank) and Snipe (DPS) verb bodies now use `apply_ability N by self
// target target`. The dispatcher writes EffectDamageApplied chronicle
// records (engine-aliased to kind=26) instead of the source-declared
// Damaged event. This rule consumes those records and re-emits Damaged
// so the rest of the cascade (ApplyDamage's per-agent hp decrement +
// Defeated emit AND the `damage_dealt` view fold) keeps working
// unchanged. Mirrors the chronicle re-emit shape duel_abilities and
// duel_25v25 use.
//
// P6 caveat: this rule is PerEvent + emit-only (no AgentField writes)
// — does NOT trip P6, unlike ApplyDamage / ApplyHeal below.
// -------------------------------------------------------------------
@phase(post)
physics ApplyDamageFromChronicle {
  on EffectDamageApplied { actor: a, target: t, amount: amt } {
    emit Damaged { source: a, target: t, amount: amt }
  }
}

// ConcussiveBlow control-status proof (5v5 scale, 2026-05-07) —
// chronicle consumer for the kind=29 EffectStunApplied records the
// new ConcussiveBlow verb writes. The dispatcher pre-computes
// `expires_at_tick = world.tick + duration_ticks` at chronicle-write
// time (see Stun arm in `cg/emit/wgsl_body.rs`), so this rule ferries
// the absolute tick verbatim into the per-agent
// `stun_expires_at_tick` SoA slot via
// `agents.set_stun_expires_at_tick(t, e)`. Mirror of duel_25v25 +
// mass_battle_100v100 ApplyStunFromChronicle (commits 7a0a6ace,
// 67b61aa2 — third site of this pattern).
//
// AUTO-FUSION: this rule and ApplyDamageFromChronicle both run
// @phase(post) over the same event ring with non-overlapping kind
// tags (26 vs 29), so the lower pass folds them into ONE kernel
// (`physics_ApplyDamageFromChronicle_and_ApplyStunFromChronicle`) —
// same fusion duel_25v25 + mass_battle_100v100 surfaced.
//
// P6 caveat: this rule is PerEvent + writes an AgentField — TRIPS P6
// in the well_formed checker. tactical_squad_5v5's build.rs already
// tolerates lower diagnostics (matches `lower_compilation_to_cg` on
// `DriverOutcome::Err` and falls through with the partial program),
// so the rule lowers regardless. Same tolerance pattern duel_abilities
// + duel_25v25 + mass_battle_100v100 use for their AgentField writes
// from chronicle physics.
@phase(post)
physics ApplyStunFromChronicle {
  on EffectStunApplied { actor: _, target: t, expires_at_tick: e } {
    agents.set_stun_expires_at_tick(t, e);
  }
}

// -------------------------------------------------------------------
// SquadHeal (apply_ability ally heal, 2026-05-07) — chronicle consumer
// for the kind=27 EffectHealApplied records the new SquadHeal verb
// writes per cast. Direct-SoA-write shape (matches duel_25v25's
// ApplyHealFromChronicle, commit 049feb0c — third site of this
// pattern). Clamps overflow with `min(hp + amt, max_hp)` so a tick-7
// cast on a near-full-HP ally doesn't push hp above the per-agent
// max_hp ceiling.
//
// FUSION EXPECTATION (this is the 6th @phase(post) PerEvent site in
// tactical_squad_5v5): the lower pass already fused
// ApplyDamageFromChronicle (kind=26) +  ApplyStunFromChronicle
// (kind=29) into a 2-way `_and_` kernel
// (`physics_ApplyDamageFromChronicle_and_ApplyStunFromChronicle`).
// This rule should auto-include into a 3-way fusion: same
// @phase(post), PerEvent over the same event_ring, non-overlapping
// kind tag (27). The resulting kernel is
// `physics_ApplyDamageFromChronicle_and_ApplyHealFromChronicle_and_ApplyStunFromChronicle`
// (kernel-namer alphabetises). Same auto-fusion duel_25v25 surfaced
// when HealPulse joined the existing 2-way (commit 049feb0c).
// Binding count grows by `agent_hp` + `agent_max_hp` reads on top of
// the prior `agent_stun_expires_at_tick` write.
//
// P6 caveat: this rule is PerEvent + writes an AgentField (hp) — TRIPS
// P6 in the well_formed checker. tactical_squad_5v5's build.rs already
// tolerates lower diagnostics (matches `lower_compilation_to_cg` on
// `DriverOutcome::Err` and falls through with the partial program),
// so the rule lowers regardless.
@phase(post)
physics ApplyHealFromChronicle {
  on EffectHealApplied { actor: _, target: t, amount: amt } {
    agents.set_hp(t, min(agents.hp(t) + amt, agents.max_hp(t)));
  }
}

// -------------------------------------------------------------------
// ApplyDamage chronicle — same shape as duel_1v1. Reduces target HP
// per Damaged event; on HP <= 0 sets alive=false AND emits Defeated.
// -------------------------------------------------------------------
@phase(post)
physics ApplyDamage {
  on Damaged { source: _, target: t, amount: a } {
    let new_hp = agents.hp(t) - a;
    agents.set_hp(t, new_hp);
    if (new_hp <= 0.0) {
      agents.set_alive(t, false);
      emit Defeated { combatant: t }
    }
  }
}

// -------------------------------------------------------------------
// ApplyHeal chronicle — adds heal amount to target HP. No HP cap
// today (no MaxHp clamp wired); steady-state Healer can over-heal
// the tank, which is fine for the smoke run.
// -------------------------------------------------------------------
@phase(post)
physics ApplyHeal {
  on Healed { source: _, target: t, amount: a } {
    let new_hp = agents.hp(t) + a;
    agents.set_hp(t, new_hp);
  }
}

// -------------------------------------------------------------------
// Per-source observability views — `damage_dealt` totals per attacker,
// `healing_done` totals per healer. Same shape as duel_1v1.
// -------------------------------------------------------------------
@materialized(on_event = [Damaged])
view damage_dealt(source: Agent) -> f32 {
  initial: 0.0,
  on Damaged { source: s, target: _, amount: a } { self += a }
  clamp: [0.0, 1000000.0],
}

@materialized(on_event = [Healed])
view healing_done(source: Agent) -> f32 {
  initial: 0.0,
  on Healed { source: s, target: _, amount: a } { self += a }
  clamp: [0.0, 1000000.0],
}
