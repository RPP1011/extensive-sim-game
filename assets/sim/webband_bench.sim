verb Nap(self) =
  action NapAction
  when (self.alive
        && self.creature_type == config.wb.ct_colonist
        && self.downed == 0u
        && self.raid_on < 0.5
        && self.claimed_job == 0u
        && self.need_rest < config.wb.nap_threshold)
  emit Napped { who: self }
  score config.wb.band_nap

// ---------------------------------------------------------------------
// == S5/S5c: COMBAT VERBS == THE VERB CHOOSES THE TARGET; THE .ability
// PROGRAM RESOLVES THE BLOW. Each strike verb keeps its `emit Struck*`
// (the deed record the tallies and the cooldown stamp ride) AND
// dispatches an ability through `apply_ability`; the dispatcher writes
// EffectDamageApplied / EffectKnockbackApplied chronicle records, and
// ApplyEffectDamage / ApplyEffectKnockback below are the ONE place hp,
// death and the KO law are decided. Strikes stay phase-slotted (one
// writer of any hp cell per tick) and ALL damage still resolves through
// the same consumer regardless of the directive that steered the swing
// — deeds remain steering-agnostic by construction.

// The colonist's arm: WebbandPowerStrike (catalog power_strike — 46 dmg,
// cd 3 rounds -> 60 ticks, range 2.6; the numbers now live in the
// .ability file, the mask enforces the same reach/cadence).
// Directive biases: guard restricts the target pool to raiders pressing
// the ward (mask); focus boosts the named raider over every distance
// term; harry prefers the lowest hp. The score MUST read the target
// (the S3 self-row law) — every arm subtracts distance.
verb StrikeRaider(self, target: Agent) =
  action StrikeRaiderAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && self.downed == 0u
        && (target.creature_type == config.wb.ct_raider
            || target.creature_type == config.wb.ct_warlord)
        && target.raid_active == 1u
        && self.strike_cd_until <= world.tick
        && ((world.tick % 20) == ((self.stagger + 5u) % 20u))
        && (self.directive_kind != 1u || self.dir_live == 0u
            || distance(target.pos, self.dir_target_pos) < config.wb.guard_r)
        && distance(self.pos, target.pos) < config.wb.strike_range)
  emit StruckRaider { who: self, what: target }
  emit Swing { actor: self, target: target, ability: config.wb.ab_power_strike }
  score (if (((target.creature_type == config.wb.ct_raider) || (target.creature_type == config.wb.ct_warlord)) && (target.raid_active == 1u)) {
    config.wb.band_strike
    + (if ((self.directive_kind == 3u) && (self.dir_live == 1u) && (target.stagger == self.directive_target)) { config.wb.focus_bonus } else { 0.0 })
    + (if (self.directive_kind == 4u) { 0.0 - target.hp * config.wb.harry_hp_w } else { 0.0 })
    - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// The ranks' swing: the TROOPS basic strike, one .ability program per
// rank (11/17/24 — troop_strikes.ability), dispatched by the body's own
// `ability_id`, on the 40-tick target-parity slot cadence (S6b — see the
// header: one eligible body per (tick, target), every body a window
// every 20 ticks), range 2.8 (cleaving_blow's reach; its cone stays a
// documented drop — see the S5c header). Downed colonists are left where
// they fell — KO'd, never finished off; the law lives in this mask AND,
// since the sweep can spray them, in ApplyEffectDamage.
// S5c ADDS ONE CLAUSE: the ranks stand down on the warlord's exclusive
// residues (34-37 mod 40). The sweep's circle writes many colonist hp
// cells at once, so nothing else may write a colonist hp cell on a tick
// a warlord may swing. Cost, stated: the four ranks whose
// (stagger + 20) % 40 lands in 34..37 lose their SECOND window per
// 40-tick cycle (one swing per cycle instead of two) — 4 of 36 bodies,
// and only when the whole pool is fielded.
verb RaiderStrike(self, target: Agent) =
  action RaiderStrikeAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_raider
        && self.raid_active == 1u
        && target.creature_type == config.wb.ct_colonist
        && target.downed == 0u
        && self.strike_cd_until <= world.tick
        && ((world.tick % 40) == ((self.stagger + 20u * (target.stagger % 2u)) % 40u))
        && ((world.tick % 40) < config.wb.warlord_phase_lo
            || (world.tick % 40) > config.wb.warlord_phase_hi)
        && distance(self.pos, target.pos) < config.wb.raider_range)
  emit StruckColonist { who: self, what: target }
  emit Swing { actor: self, target: target, ability: self.ability_id }
  score (if ((target.creature_type == config.wb.ct_colonist) && (target.downed == 0u)) {
    config.wb.band_strike - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// The warlord's sweep: WebbandWarlordSweep — RESTORED AS A REAL CIRCLE
// AoE (S5c). `damage 40 in circle(3.5)` + `knockback 2 in circle(3.5)`
// at cooldown 3 rounds -> 60 ticks, range 3.5 (catalog.ts:90-93). The
// dispatcher's Path-B walk enumerates the 27-cell spatial neighbourhood
// around the AIMED TARGET and writes one chronicle record per body in
// the circle — which is Webband's own aiming convention (engine.ts
// centres a circle area on the target cell, not on the caster). Friend/
// foe filtering and the KO law are the consumer's, because the walk is
// geometric and knows nothing about teams.
// THE PHASE GATE IS DIFFERENT FROM THE RANKS' ON PURPOSE: a sweep
// sprays BOTH target parities, so the per-(tick, target) uniqueness the
// parity term buys is worthless to it. Warlords take
// `world.tick % 40 == stagger % 40` — four distinct residues for four
// bodies (slots 115-118), which the ranks are excluded from above. One
// warlord may swing per tick, and on that tick it is the only writer of
// any colonist hp cell in the colony.
// STILL DROPPED, and now for a sharper reason: `second_wind`
// (WebbandSecondWind, heal 45 when hp < 50 + shield 25). Its heal writes
// the WARLORD's own hp cell in the post phase, which is exactly the cell
// a colonist's power_strike may write in the same tick — and colonists
// occupy all 20 residues mod 20 by construction (20 bodies, 20 slots),
// so there is no tick on which a warlord can heal unopposed. Restoring
// it means re-deriving the colonist phase map at a measurable cost to
// colonist throughput, i.e. a balance change dressed as a fidelity fix.
verb WarlordStrike(self, target: Agent) =
  action WarlordStrikeAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_warlord
        && self.raid_active == 1u
        && target.creature_type == config.wb.ct_colonist
        && target.downed == 0u
        && self.strike_cd_until <= world.tick
        && ((world.tick % 40) == (self.stagger % 40u))
        && distance(self.pos, target.pos) < config.wb.warlord_range)
  emit StruckColonist { who: self, what: target }
  emit Swing { actor: self, target: target, ability: config.wb.ab_warlord_sweep }
  score (if ((target.creature_type == config.wb.ct_colonist) && (target.downed == 0u)) {
    config.wb.band_strike - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// Plunder: only when NOBODY stands (defenders is the raider's own
// materialized count of standing colonists — 0 means every colonist is
// downed, which is also what makes the store write race-free: no
// colonist verb can fire at all). Never on a dawn tick (the dawn
// un-down + DawnSpoil share it). The consumer drains value-order and
// turns the whole warband for home.
verb PlunderStore(self, target: Agent) =
  action PlunderStoreAction
  when (self.alive && target.alive
        && (self.creature_type == config.wb.ct_raider
            || self.creature_type == config.wb.ct_warlord)
        && self.raid_active == 1u
        && self.defenders < 0.5
        && (target.creature_type == config.wb.ct_store
            || target.creature_type == config.wb.ct_cache)
        && (target.inv_meal + target.inv_berries + target.inv_venison + target.inv_grain + target.inv_timber + target.inv_plank + target.inv_hide) > 0.5
        && target.plundered_at == 0u
        && ((world.tick % 600) != 0)
        && ((world.tick % 40) == ((self.stagger + 7u) % 40u))
        && distance(self.pos, target.pos) < config.wb.reach)
  emit Plundered { who: self, what: target }
  score (if (((target.creature_type == config.wb.ct_store) || (target.creature_type == config.wb.ct_cache)) && (target.plundered_at == 0u)) {
    config.wb.band_strike - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// ---------------------------------------------------------------------
// == MOVEMENT == (steering, not pathing — the engine law). Writes ONLY
// pos. Claimed -> job_site; carrying -> best sink for the carried item
// (mirrors the deliver masks); idle -> drift home when far out.
physics Steer @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == config.wb.ct_colonist
                    && self.downed == 0u) {
    let store_pull = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_store) {
        c.pos - self.pos
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    let bp_timber_pull = sum(c in agents where
      if (c.alive) && (c.built == 0u) && (c.need_timber > 0.5) {
        (c.pos - self.pos) / (length(c.pos - self.pos) * length(c.pos - self.pos) + 0.001)
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    let bp_plank_pull = sum(c in agents where
      if (c.alive) && (c.built == 0u) && (c.need_plank > 0.5) {
        (c.pos - self.pos) / (length(c.pos - self.pos) * length(c.pos - self.pos) + 0.001)
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    let bench_pull = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_bench) && (c.built == 1u) && (c.inv_timber < config.wb.bench_timber_cap) {
        c.pos - self.pos
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    let hearth_pull = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_hearth) && (c.built == 1u)
         && (((self.carry_kind == config.wb.it_berries) && (c.inv_berries < config.wb.hearth_food_cap))
             || ((self.carry_kind == config.wb.it_venison) && (c.inv_venison < config.wb.hearth_food_cap))
             || ((self.carry_kind == config.wb.it_grain) && (c.inv_grain < config.wb.hearth_food_cap))) {
        c.pos - self.pos
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    // S5 combat pulls: the raiding foe field (inverse-square), the
    // harry-weighted variant (wounded foes weigh more), the guard's
    // presser field (foes near the ward), and the tender's pull toward
    // downed hallmates (peacetime idle only).
    let foe_pull = sum(c in agents where
      if (c.alive) && ((c.creature_type == config.wb.ct_raider) || (c.creature_type == config.wb.ct_warlord)) && (c.raid_active == 1u) {
        (c.pos - self.pos) / (length(c.pos - self.pos) * length(c.pos - self.pos) + 0.001)
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    let harry_pull = sum(c in agents where
      if (c.alive) && ((c.creature_type == config.wb.ct_raider) || (c.creature_type == config.wb.ct_warlord)) && (c.raid_active == 1u) {
        (c.pos - self.pos) / ((length(c.pos - self.pos) * length(c.pos - self.pos) + 0.001) * (c.hp + 50.0))
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    let presser_pull = sum(c in agents where
      if (c.alive) && ((c.creature_type == config.wb.ct_raider) || (c.creature_type == config.wb.ct_warlord)) && (c.raid_active == 1u)
         && (distance(c.pos, self.dir_target_pos) < config.wb.guard_r) {
        (c.pos - self.pos) / (length(c.pos - self.pos) * length(c.pos - self.pos) + 0.001)
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    let downed_pull = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_colonist) && (c.downed == 1u) {
        (c.pos - self.pos) / (length(c.pos - self.pos) * length(c.pos - self.pos) + 0.001)
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    // S6: a CAMPED trader with a paying purse draws hide-only carriers
    // out to the rim (the sell detour). Dormant trader => zero vector =>
    // this pull and its branch are dead and Steer is byte-identical to
    // the S5 shape (the S3/S4/S5 runs never camp one).
    let trader_pull = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_trader) && (c.trader_active == 1u) && (c.purse >= config.wb.hide_sell) {
        c.pos - self.pos
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    let carrying = (self.carry_n > 0.5) || (self.carry_hide > 0.5);
    let dest = if (self.raid_on > 0.5) {
      // THE MUSTER: every standing colonist is a defender (all-hands,
      // the Webband defense rule), steered by their directive.
      if (self.directive_kind == 2u) {
        // hold: walk to the anchor, then STAND (the clamped empty walk).
        if (distance(self.pos, self.directive_pos) > config.wb.hold_r) {
          self.directive_pos - self.pos
        } else { vec3(0.0, 0.0, 0.0) }
      } else {
        if ((self.directive_kind == 3u) && (self.dir_live == 1u)) {
          self.dir_target_pos - self.pos
        } else {
          if ((self.directive_kind == 1u) && (self.dir_live == 1u)) {
            // guard: close on the ward first, then meet their pressers.
            if (distance(self.pos, self.dir_target_pos) > config.wb.guard_r * 0.75) {
              self.dir_target_pos - self.pos
            } else { presser_pull }
          } else {
            if (self.directive_kind == 4u) { harry_pull } else { foe_pull }
          }
        }
      }
    } else {
    if (self.claimed_job != 0u) {
      self.job_site - self.pos
    } else {
      if (carrying) {
        // S6: a hide-ONLY carrier (venison already dropped) walks the
        // hides to the camped trader before falling back to the store.
        if ((self.carry_n < 0.5) && (length(trader_pull) > 0.0001)) {
          trader_pull
        } else {
        if (self.carry_kind == config.wb.it_timber) {
          if (length(bp_timber_pull) > 0.0001) { bp_timber_pull } else {
            if (length(bench_pull) > 0.0001) { bench_pull } else { store_pull }
          }
        } else {
          if (self.carry_kind == config.wb.it_plank) {
            if (length(bp_plank_pull) > 0.0001) { bp_plank_pull } else { store_pull }
          } else {
            if (length(hearth_pull) > 0.0001) { hearth_pull } else { store_pull }
          }
        }
        }
      } else {
        // Idle: a hale hand walks to the downed (the tend hook needs
        // the tender within the 2u spatial cell); else drift back
        // toward the store when wandered far out.
        if ((length(downed_pull) > 0.0001) && (self.hp >= config.wb.tend_hp_well)) {
          downed_pull
        } else {
          if (length(store_pull) > 8.0) { store_pull } else { vec3(0.0, 0.0, 0.0) }
        }
      }
    }
    };
    // The arrive gate compares the DEST VECTOR LENGTH — for a claimed
    // walk dest is a plain difference (length = true distance, stop at
    // arrive), but the carrier/idle pulls are inverse-square SUMS whose
    // length is tiny even when far away (found at S3: every carrier
    // froze mid-field the moment its pull dipped under the gate). Pull
    // dests therefore use a near-zero gate and simply hover at their
    // sink, where the reach-gated deliver verbs fire.
    let d = length(dest);
    let gate = if (self.claimed_job != 0u) { config.wb.arrive } else { 0.02 };
    let new_pos = if (d > gate) {
      self.pos + (dest / d) * config.wb.walk_speed
    } else {
      self.pos
    };
    agents.set_pos(self, new_pos);
  }
}

// ---------------------------------------------------------------------
// == NEEDS == (per-tick drains + per-tick mood; dawn resolution below)
physics NeedsDrain @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == config.wb.ct_colonist) {
    agents.set_need_food(self, max(self.need_food - config.wb.food_drain, 0.0));
    agents.set_need_rest(self, max(self.need_rest - config.wb.rest_drain, 0.0));
  }
}

physics ThoughtSumDecay @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == config.wb.ct_colonist) {
    agents.set_thought_sum(self, self.thought_sum * config.wb.thought_decay);
  }
}

// mood = 40 + 25 food + 15 rest + 10 comfort + 10 cheer + thoughts
//        + company                       (needs.ts:121-132, S4-complete)
// company = 8 * avg(standing/32768) over the other 19 (needs.ts:122-128 +
// mind-port.ts /32768). The avg is CLAMPED to +-1: TS clamps each pair's
// standing to i16 at write (setStanding), which cannot lower here (S1
// defect a — no fold clamp), so the clamp moves to the read and mood's
// company envelope stays TS's +-8 exactly. THE ONE SANCTIONED BELIEF
// COUPLING — nothing else reads standing_sum.
physics MoodTick @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == config.wb.ct_colonist) {
    let company = 8.0 * clamp(self.standing_sum / config.wb.company_denom, -1.0, 1.0);
    let m = 40.0 + 25.0 * self.need_food + 15.0 * self.need_rest
          + 10.0 * self.need_comfort + 10.0 * self.need_cheer + self.thought_sum
          + company;
    agents.set_mood(self, clamp(m, 0.0, 100.0));
  }
}

// S4: standing_sum decays at the standing beliefs' exact rate so the field
// keeps mirroring the pair rows (0.982^(1/600) per tick).
physics StandingSumDecay @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == config.wb.ct_colonist) {
    agents.set_standing_sum(self, self.standing_sum * config.wb.standing_decay);
  }
}

// Demand materialization: masks cannot hold folds (fold prelude never
// reaches the mask kernel — S3 finding), so the store and the bench
// re-derive global material demand onto their own fields each tick and
// the haul/deliver masks read them target-locally.
physics DemandTick @phase(per_agent) {
  on Tick {} where (self.alive
                    && (self.creature_type == config.wb.ct_store
                        || self.creature_type == config.wb.ct_bench)) {
    let dt = sum(c in agents where
      if (c.alive) && (((c.built == 0u) && (c.need_timber > 0.5))
          || ((c.creature_type == config.wb.ct_bench) && (c.built == 1u) && (c.inv_timber < config.wb.bench_timber_cap))) {
        1.0
      } else {
        0.0
      });
    let dp = sum(c in agents where
      if (c.alive) && (c.built == 0u) && (c.need_plank > 0.5) { 1.0 } else { 0.0 });
    agents.set_demand_timber(self, dt);
    agents.set_demand_plank(self, dp);
  }
}

// == CLAIM LEASES == (janitors: a stale claim never outlives its lease)
physics LeaseColonist @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type == config.wb.ct_colonist
                    && self.claimed_job != 0u
                    && self.claim_until < world.tick) {
    agents.set_claimed_job(self, 0u);
  }
}

physics LeaseTarget @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type != config.wb.ct_colonist
                    && self.claimed == 1u
                    && self.claim_until < world.tick) {
    agents.set_claimed(self, 0u);
  }
}

// ---------------------------------------------------------------------
// == S5: THE RAID (per_agent senses + steering; ALL raid-state writes
// live in the post consumers below — per_agent cross-reads must only
// touch post-written or static fields, the determinism law extended).

// The colonist's raid sense (the DemandTick idiom: masks cannot fold,
// so the raid signal is materialized onto every colonist) + the
// directive resolver: directive_target is a STAGGER (slot-seeded,
// globally unique), resolved to a live agent's position each tick. A
// dead target drops dir_live — the colonist falls back to plain
// foe-chasing (TS directiveOf's self-cleaning read).
physics RaidSense @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == config.wb.ct_colonist) {
    let foes = sum(c in agents where
      if (c.alive) && ((c.creature_type == config.wb.ct_raider) || (c.creature_type == config.wb.ct_warlord)) && (c.raid_active == 1u) { 1.0 } else { 0.0 });
    agents.set_raid_on(self, foes);
    if (self.directive_kind != 0u) {
      let tpos = sum(c in agents where
        if (c.alive) && (c.stagger == self.directive_target) { c.pos } else { vec3(0.0, 0.0, 0.0) });
      let tcnt = sum(c in agents where
        if (c.alive) && (c.stagger == self.directive_target) { 1.0 } else { 0.0 });
      if (tcnt > 0.5) {
        agents.set_dir_target_pos(self, tpos);
        agents.set_dir_live(self, 1u);
      } else {
        agents.set_dir_live(self, 0u);
      }
    }
  }
}

// The drums, one day out: a raider whose muster is exactly 600 ticks
// away sounds the warning (chronicle counter = count_raid_warning; the
// RELIABLE pin is the post-stamped `warned` field — view folds ride
// the lossy delayed window, S4 finding 3).
physics RaidWarn @phase(per_agent) {
  on Tick {} where (self.alive
                    && ((self.creature_type == config.wb.ct_raider) || (self.creature_type == config.wb.ct_warlord))
                    && self.raid_active == 0u
                    && self.musters_at == world.tick + 600u) {
    emit RaidWarning { who: self }
  }
}

// The muster: raid_total is computed HERE (a self-write from the
// STATIC musters_at cohort — deterministic under the parallel phase);
// raid_active itself flips in the MustersNow consumer (post), so no
// per_agent reader ever sees a same-phase transition.
physics RaidMuster @phase(per_agent) {
  on Tick {} where (self.alive
                    && ((self.creature_type == config.wb.ct_raider) || (self.creature_type == config.wb.ct_warlord))
                    && self.raid_active == 0u
                    && self.musters_at != 0u
                    && self.musters_at == world.tick) {
    let cohort = sum(c in agents where
      if (c.alive) && ((c.creature_type == config.wb.ct_raider) || (c.creature_type == config.wb.ct_warlord)) && (c.musters_at == self.musters_at) { 1.0 } else { 0.0 });
    agents.set_raid_total(self, cohort);
    emit MustersNow { who: self }
  }
}

// The raider's read of the field: standing defenders (the plunder
// verb's gate) and the withdraw triggers — timeout (the task's
// ROUND_CAP-scaled 4800), losses beyond half the cohort (alive count
// is post-written, phase-stable), or the stores already stripped.
// Emit-only; the state flip is the consumer's.
physics RaiderBrain @phase(per_agent) {
  on Tick {} where (self.alive
                    && ((self.creature_type == config.wb.ct_raider) || (self.creature_type == config.wb.ct_warlord))
                    && self.raid_active == 1u) {
    let standing = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_colonist) && (c.downed == 0u) { 1.0 } else { 0.0 });
    agents.set_defenders(self, standing);
    let cohort_alive = sum(c in agents where
      if (c.alive) && ((c.creature_type == config.wb.ct_raider) || (c.creature_type == config.wb.ct_warlord)) && (c.musters_at == self.musters_at) { 1.0 } else { 0.0 });
    let plundered = sum(c in agents where
      if (c.alive) && ((c.creature_type == config.wb.ct_store) || (c.creature_type == config.wb.ct_cache)) && (c.plundered_at != 0u) { 1.0 } else { 0.0 });
    if ((world.tick > self.musters_at + config.wb.raid_timeout)
        || (cohort_alive * 2.0 < self.raid_total)
        || (plundered > 0.5)) {
      emit Withdraws { who: self }
    }
  }
}

// Raider steering: the stores draw them in (origin), a standing
// colonist inside engage_r pulls them into the fight, and BUILT walls
// repel — d^4 falloff inside wall_r plus a fixed-CCW tangential slide
// scaled by the repulsion, so the stream bends around the palisade
// instead of stalling on its symmetry axis. Withdrawing raiders (2)
// walk out with the same wall respect; past flee_r they are gone (3).
physics RaiderSteer @phase(per_agent) {
  on Tick {} where (self.alive
                    && ((self.creature_type == config.wb.ct_raider) || (self.creature_type == config.wb.ct_warlord))
                    && ((self.raid_active == 1u) || (self.raid_active == 2u))) {
    let engage_pull = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_colonist) && (c.downed == 0u)
         && (distance(c.pos, self.pos) < config.wb.engage_r) {
        (c.pos - self.pos) / (length(c.pos - self.pos) * length(c.pos - self.pos) + 0.001)
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    let wall_rep = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_wall) && (c.built == 1u)
         && (distance(c.pos, self.pos) < config.wb.wall_r) {
        (self.pos - c.pos) / (length(self.pos - c.pos) * length(self.pos - c.pos) * length(self.pos - c.pos) * length(self.pos - c.pos) + 0.001)
      } else {
        vec3(0.0, 0.0, 0.0)
      });
    let base = if (self.raid_active == 2u) {
      self.pos
    } else {
      if (length(engage_pull) > 0.0001) { engage_pull } else { vec3(0.0, 0.0, 0.0) - self.pos }
    };
    let bl = length(base);
    let bn = if (bl > 0.001) { base / bl } else { vec3(0.0, 0.0, 0.0) };
    let rep = wall_rep * config.wb.wall_w;
    let slide = vec3(0.0 - bn.y, bn.x, 0.0) * length(rep) * 0.7;
    let dest = bn + rep + slide;
    let dl = length(dest);
    if (dl > 0.05) {
      agents.set_pos(self, self.pos + (dest / dl) * config.wb.raider_speed);
    }
    if ((self.raid_active == 2u) && (length(self.pos) > config.wb.flee_r)) {
      emit RaiderGone { who: self }
    }
  }
}

// The scar: once the stores are stripped, built buildings on the rim
// beyond burn_r char (a radius threshold — the TS exact
// outermost-by-|q|+|r| top-2 sort is S7b's host-side math). Fires off
// the dawn tick by construction (plunder never lands on one).
physics BurnSweep @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type != config.wb.ct_colonist
                    && self.built == 1u
                    && self.burnt == 0u) {
    let plundered = sum(c in agents where
      if (c.alive) && ((c.creature_type == config.wb.ct_store) || (c.creature_type == config.wb.ct_cache)) && (c.plundered_at != 0u) { 1.0 } else { 0.0 });
    if ((plundered > 0.5) && (length(self.pos) > config.wb.burn_r)) {
      agents.set_burnt(self, 1u);
    }
  }
}

// ---------------------------------------------------------------------
// == DAWN == (world.tick % 600 == 0; day cadence systems. S4-S6 append
// their dawn systems into this section.)

// Colonist dawn: starvation-or-heal (the Webband rule: hp floor, never
// death), bed-cover rest/comfort, cheer drain + supper, rough-sleep
// thought. Self-writes only — no cross-agent races.
physics DawnColonist @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type == config.wb.ct_colonist
                    && (world.tick % 600 == 0)
                    && world.tick > 0) {
    let beds = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_bed) && (c.built == 1u) { 1.0 } else { 0.0 });
    let heads = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_colonist) { 1.0 } else { 0.0 });
    // S4: the mess table is real now — comfort's third term and the supper
    // cheer bonus re-key to it (needs.ts:113-115; the hearth stand-in and
    // the ate-a-meal supper gate retire).
    let tables = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_mess) && (c.built == 1u) { 1.0 } else { 0.0 });
    let cover = min(1.0, beds / max(heads, 1.0));
    let table_up = min(tables, 1.0);
    agents.set_need_rest(self, 0.7 + 0.3 * cover);
    agents.set_need_comfort(self, 0.4 + 0.3 * cover + 0.3 * table_up);
    // Dawn thought deltas fold into thought_sum INLINE (self-write,
    // deterministic): slept_rough and starving can land on the SAME
    // colonist in one tick, and two post consumers writing thought_sum
    // race last-write-wins by GPU scheduling (found as a 1-colonist
    // mood divergence between identical runs). The events still fire
    // for the per-thought views. S4: any new same-tick thought source
    // must follow this pattern.
    if (cover < 0.99) {
      emit ThoughtSleptRough { who: self }
      agents.set_thought_sum(self, self.thought_sum - 6.0);
    }
    let supper = if (table_up > 0.5) { 0.2 } else { 0.0 };
    agents.set_need_cheer(self, clamp(self.need_cheer - 0.15 + supper, 0.0, 1.0));
    // S5: the downed are laid up — spoon-fed (no starve arm, no free
    // dawn heal; TendSick's +10/day is their mending) and un-downed
    // once two tends have lifted them to recover_hp. When downed is 0
    // (every S3/S4 run) this branch is dead and the else arm is the
    // original dawn byte-for-byte.
    if (self.downed == 1u) {
      agents.set_need_food(self, config.wb.downed_food);
      if (self.hp >= config.wb.recover_hp) {
        agents.set_downed(self, 0u);
      }
    } else {
      if (self.need_food <= 0.02) {
        agents.set_hp(self, max(self.hp - config.wb.starve_hp, config.wb.starve_floor));
        agents.set_starving_days(self, self.starving_days + 1.0);
        emit ThoughtStarving { who: self }
        agents.set_thought_sum(self, self.thought_sum - 18.0);
      } else {
        agents.set_starving_days(self, 0.0);
        agents.set_hp(self, min(self.hp + config.wb.heal_per_day, 100.0));
      }
    }
  }
}

// Spoil sweep: spoiling stock decays by 1/spoilDays per dawn; a built
// store shed halves the loss (defs.ts spoilMult 2, made global).
physics DawnSpoil @phase(per_agent) {
  on Tick {} where (self.alive
                    && (self.creature_type == config.wb.ct_store
                        || self.creature_type == config.wb.ct_cache
                        || self.creature_type == config.wb.ct_hearth)
                    && (world.tick % 600 == 0)
                    && world.tick > 0) {
    let sheds = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_shed) && (c.built == 1u) { 1.0 } else { 0.0 });
    let shed_up = min(sheds, 1.0);
    let keep_b = config.wb.spoil_keep_berries + (1.0 - config.wb.spoil_keep_berries) * 0.5 * shed_up;
    let keep_m = config.wb.spoil_keep_meat + (1.0 - config.wb.spoil_keep_meat) * 0.5 * shed_up;
    let keep_g = config.wb.spoil_keep_grain + (1.0 - config.wb.spoil_keep_grain) * 0.5 * shed_up;
    agents.set_inv_berries(self, self.inv_berries * keep_b);
    agents.set_inv_venison(self, self.inv_venison * keep_m);
    agents.set_inv_meal(self, self.inv_meal * keep_m);
    agents.set_inv_grain(self, self.inv_grain * keep_g);
  }
}

// Growth tick: sown plots advance one day per dawn (regrowth of trees/
// bushes/game is lazy — the regrow_at compare in the claim masks).
physics DawnGrow @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type == config.wb.ct_plot
                    && self.sown == 1u
                    && (world.tick % 600 == 0)
                    && world.tick > 0) {
    agents.set_growth(self, self.growth + 1.0);
  }
}

// ---------------------------------------------------------------------
// == MINDS SUBSTRATE == (spike-preserved; S4 grows this section).
// Jostling colonists brawl at crowded ground every 20th tick, stopping
// at 5800 so the run's tail is a pure-decay window for the pair pin.
// The %20==10 OFFSET is load-bearing: dawn ticks are %600==0, and a
// brawl storm sharing the dawn tick starves the same-tick thought
// events out of the fold dispatch (S1 defect (b): per-event folds
// under-dispatch on ticks with more events than agents). Brawls and
// dawn systems must never share a tick.
physics Jostle @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type == config.wb.ct_colonist
                    && self.downed == 0u
                    && self.raid_on < 0.5
                    && (world.tick % config.wb.brawl_every == 10)
                    && world.tick < config.wb.brawl_stop_tick) {
    for other in spatial.nearby_jostle(self) {
      if (other != self
          && other.alive
          && other.creature_type == config.wb.ct_colonist
          && other.downed == 0u
          // THE QUARREL CIRCLE — the emission cap (2026-07-22 perf fix).
          // A colonist can only fall out with the handful of hall-mates
          // whose SLOT sits beside theirs: `stagger` is the spawn slot and
          // is globally unique, so this bounds the partner set at
          // 2*brawl_span agents NO MATTER how many people are standing on
          // the same ground. Emission is therefore O(pop), not O(pop^2).
          // Written additively (a + span >= b) so u32 never underflows.
          //
          // Why it had to change: the all-pairs form emitted a Brawl for
          // EVERY neighbouring pair, so its row count was quadratic in
          // local density — 616 chronicle rows on a storm tick at 20
          // colonists, 143 961 at 500 — and every serial-scan fold walks
          // its whole domain against every row. Measured storm tick:
          // 13 ms at pop 20, 10.4 SECONDS at pop 500 (perf slice,
          // 2026-07-22). Per-event consumer kernels also only cover ring
          // rows < agent_count, so past ~30-35 colonists the burst was
          // being silently TRUNCATED. Both ceilings are the same defect.
          //
          // What survives, and it is the load-bearing part: brawls still
          // only happen on crowded ground (the 2u jostle radius still
          // gates every emission), the storm still fires on %20==10 (never
          // a dawn tick — the S1 defect (b) law), and the pairing is
          // SYMMETRIC by construction — |stagger difference| <= span is
          // mutual, so both directions still emit and the mutual sour the
          // pair beliefs depend on is unchanged. What changes: in a knot
          // of ten, a colonist sours on their few slot-neighbours instead
          // of on all nine, so grudge/standing magnitudes accumulate more
          // slowly (the fixture's brawl volume, not its semantics).
          //
          // The rejected alternative was "nearest eligible neighbour
          // only", which is the semantically ideal cap; it needs a
          // reduction over agents nested inside the spatial `for`, and
          // that does not lower today — the emitted WGSL references the
          // enclosing loop's binder as an undeclared identifier
          // (`local_47`). Filed in the gaps list; the cap is what matters
          // for the ceiling and this shape gets it with proven forms.
          && (other.stagger + config.wb.brawl_span >= self.stagger)
          && (self.stagger + config.wb.brawl_span >= other.stagger)) {
        emit Brawl { aggressor: self, victim: other }
        // S4: foldIncident's brawl sour, folded INLINE on the mood-blend
        // field (the S3 same-tick-multi-delta law: a colonist in several
        // brawls this tick must not race two post consumers — the SELF
        // write here is single-writer by construction). standing_brawl's
        // fold is aggressor-perspective for exactly this reason: one
        // decrement here per emission corresponds to one fold on MY row
        // per landed copy of MY event — same direction, so the field
        // TRACKS the row sum (bounded, not exact: the delayed sorted
        // fold window can land a busy-tick row 0 or 2 times).
        agents.set_standing_sum(self, self.standing_sum - config.wb.sour_brawl);
      }
    }
  }
}

// S4: the sickbed tend (witness.ts foldIncident 'rescue' at colony scale).
// One tender per tick GLOBALLY (the stagger slot gate — 20 colonists hold
// 20 distinct slots), so ApplyTended's cross-agent writes can never race
// on one patient. Emit-only here; all mutation in the consumer.
physics TendSick @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type == config.wb.ct_colonist
                    && self.downed == 0u
                    && self.raid_on < 0.5
                    && self.hp >= config.wb.tend_hp_well
                    && ((world.tick % 20) == ((self.stagger + 9u) % 20u))) {
    for other in spatial.nearby_jostle(self) {
      if (other != self
          && other.alive
          && other.creature_type == config.wb.ct_colonist
          && other.hp < config.wb.tend_hp_sick
          && other.tended_at + 600u < world.tick
          && distance(self.pos, other.pos) < config.wb.reach) {
        emit Tended { target: other, actor: self }
      }
    }
  }
}

// S4: witnessed prowess — a hunter's kill (prowess_tick stamped at hunt
// completion) is seen by whoever stands beside them the next tick; the
// witness writes first-hand `repute` (foldIncident 'prowess',
// NOTORIETY_PER_LEVEL * 1). Emit-only; the belief fold is the consumer.
physics WitnessProwess @phase(per_agent) {
  on Tick {} where (self.alive && self.creature_type == config.wb.ct_colonist) {
    for other in spatial.nearby_jostle(self) {
      if (other != self
          && other.alive
          && other.creature_type == config.wb.ct_colonist
          && other.prowess_tick > 0u
          && other.prowess_tick + 1u == world.tick) {
        emit ProwessSeen { who: self, whom: other }
      }
    }
  }
}

// S4: supper at the BUILT mess table — every colonist tells tales (TS
// campGossip gathers the whole ready roster; presence is colony-wide by
// the same token). Each SupperTale triggers the repute merge broadcast.
// %600==580: never the dawn tick, never the brawl storm (%20==10).
physics SupperGather @phase(per_agent) {
  on Tick {} where (self.alive
                    && self.creature_type == config.wb.ct_colonist
                    && self.downed == 0u
                    && (world.tick % 600 == config.wb.supper_phase)) {
    let tables = sum(c in agents where
      if (c.alive) && (c.creature_type == config.wb.ct_mess) && (c.built == 1u) { 1.0 } else { 0.0 });
    if (tables > 0.5) {
      emit SupperTale { teller: self }
    }
  }
}

// ---------------------------------------------------------------------
// == CHRONICLE CONSUMERS == (all state mutation flows through these
// @phase(post) rules; serial within a tick, old-value guards where a
// same-tick race matters)

// -- claim grants (exclusive kinds guard BOTH sides) --
@phase(post)
physics ApplyClaimedChop {
  on ClaimedChop { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_chop);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedForage {
  on ClaimedForage { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_forage);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedHunt {
  on ClaimedHunt { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_hunt);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedBuild {
  on ClaimedBuild { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_build);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedCook {
  on ClaimedCook { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_cook);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedCraft {
  on ClaimedCraft { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_craft);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedSow {
  on ClaimedSow { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_sow);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedTend {
  on ClaimedTend { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_tend);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedHarvest {
  on ClaimedHarvest { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_harvest);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedHaulCache {
  on ClaimedHaulCache { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_haul_cache);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.haul_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.haul_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedHaulHearth {
  on ClaimedHaulHearth { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_haul_hearth);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.haul_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.haul_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedHaulBench {
  on ClaimedHaulBench { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_haul_bench);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.haul_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.haul_lease);
    }
  }
}

@phase(post)
physics ApplyClaimedHaulStore {
  on ClaimedHaulStore { who: w, what: t } {
    if (agents.claimed_job(w) == 0u && agents.claimed(t) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_haul_store);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.haul_lease);
      agents.set_claimed(t, 1u);
      agents.set_claim_until(t, world.tick + config.wb.haul_lease);
    }
  }
}

// Eat trips are shared — grant the colonist side only.
@phase(post)
physics ApplyClaimedEat {
  on ClaimedEat { who: w, what: t } {
    if (agents.claimed_job(w) == 0u) {
      agents.set_claimed_job(w, config.wb.jk_eat);
      agents.set_job_site(w, agents.pos(t));
      agents.set_claim_until(w, world.tick + config.wb.eat_lease);
    }
  }
}

// -- work minutes + completion (the single claimant makes these
// race-free by construction; the else-arm refreshes both leases) --
@phase(post)
physics ApplyWorkedChop {
  on WorkedChop { who: w, what: t } {
    let done = agents.work_done(t) + 1.0;
    if (done >= config.wb.work_chop) {
      agents.set_work_done(t, 0.0);
      agents.set_claimed(t, 0u);
      agents.set_regrow_at(t, world.tick + config.wb.tree_regrow);
      agents.set_claimed_job(w, 0u);
      agents.set_carry_kind(w, config.wb.it_timber);
      agents.set_carry_n(w, agents.carry_n(w) + config.wb.chop_yield);
    } else {
      agents.set_work_done(t, done);
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyWorkedForage {
  on WorkedForage { who: w, what: t } {
    let done = agents.work_done(t) + 1.0;
    if (done >= config.wb.work_forage) {
      agents.set_work_done(t, 0.0);
      agents.set_claimed(t, 0u);
      agents.set_regrow_at(t, world.tick + config.wb.bush_regrow);
      agents.set_claimed_job(w, 0u);
      agents.set_carry_kind(w, config.wb.it_berries);
      agents.set_carry_n(w, agents.carry_n(w) + config.wb.forage_yield);
    } else {
      agents.set_work_done(t, done);
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyWorkedHunt {
  on WorkedHunt { who: w, what: t } {
    let done = agents.work_done(t) + 1.0;
    if (done >= config.wb.work_hunt) {
      agents.set_work_done(t, 0.0);
      agents.set_claimed(t, 0u);
      agents.set_regrow_at(t, world.tick + config.wb.game_regrow);
      agents.set_claimed_job(w, 0u);
      agents.set_carry_kind(w, config.wb.it_venison);
      agents.set_carry_n(w, agents.carry_n(w) + config.wb.hunt_meat);
      agents.set_carry_hide(w, agents.carry_hide(w) + config.wb.hunt_hides);
      // S4: the kill is a deed worth seeing (WitnessProwess reads this
      // stamp next tick; exact-match, so it self-expires).
      agents.set_prowess_tick(w, world.tick);
    } else {
      agents.set_work_done(t, done);
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

// Build applies per-minute (structures rise while you watch) via
// work_left; completion flips built.
@phase(post)
physics ApplyWorkedBuild {
  on WorkedBuild { who: w, what: t } {
    if (agents.built(t) == 0u) {
      let left = agents.work_left(t) - 1.0;
      if (left <= 0.0) {
        agents.set_work_left(t, 0.0);
        agents.set_built(t, 1u);
        agents.set_claimed(t, 0u);
        agents.set_claimed_job(w, 0u);
      } else {
        agents.set_work_left(t, left);
        agents.set_claim_until(w, world.tick + config.wb.claim_lease);
        agents.set_claim_until(t, world.tick + config.wb.claim_lease);
      }
    }
  }
}

// Cook completion re-checks live ingredients (apply re-reads its own
// preconditions — the Webband law): venison first, then berries, then
// grain; consumes per the RECIPES table, +2 meals at the hearth.
@phase(post)
physics ApplyWorkedCook {
  on WorkedCook { who: w, what: t } {
    let done = agents.work_done(t) + 1.0;
    if (done >= config.wb.work_cook) {
      agents.set_work_done(t, 0.0);
      agents.set_claimed(t, 0u);
      agents.set_claimed_job(w, 0u);
      let ven = agents.inv_venison(t);
      let ber = agents.inv_berries(t);
      let gra = agents.inv_grain(t);
      if (ven >= 2.0) {
        agents.set_inv_venison(t, ven - 2.0);
        agents.set_inv_meal(t, agents.inv_meal(t) + 2.0);
      } else {
        if (ber >= 4.0) {
          agents.set_inv_berries(t, ber - 4.0);
          agents.set_inv_meal(t, agents.inv_meal(t) + 2.0);
        } else {
          if (gra >= 3.0) {
            agents.set_inv_grain(t, gra - 3.0);
            agents.set_inv_meal(t, agents.inv_meal(t) + 2.0);
          }
        }
      }
    } else {
      agents.set_work_done(t, done);
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

// Saw: 1 timber -> 2 planks at the bench (RECIPES saw_planks).
@phase(post)
physics ApplyWorkedCraft {
  on WorkedCraft { who: w, what: t } {
    let done = agents.work_done(t) + 1.0;
    if (done >= config.wb.work_craft) {
      agents.set_work_done(t, 0.0);
      agents.set_claimed(t, 0u);
      agents.set_claimed_job(w, 0u);
      let tim = agents.inv_timber(t);
      if (tim >= 1.0) {
        agents.set_inv_timber(t, tim - 1.0);
        agents.set_inv_plank(t, agents.inv_plank(t) + 2.0);
      }
    } else {
      agents.set_work_done(t, done);
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyWorkedSow {
  on WorkedSow { who: w, what: t } {
    let done = agents.work_done(t) + 1.0;
    if (done >= config.wb.work_sow) {
      agents.set_work_done(t, 0.0);
      agents.set_claimed(t, 0u);
      agents.set_claimed_job(w, 0u);
      agents.set_sown(t, 1u);
      agents.set_growth(t, 0.0);
    } else {
      agents.set_work_done(t, done);
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyWorkedTend {
  on WorkedTend { who: w, what: t } {
    let done = agents.work_done(t) + 1.0;
    if (done >= config.wb.work_tend) {
      agents.set_work_done(t, 0.0);
      agents.set_claimed(t, 0u);
      agents.set_claimed_job(w, 0u);
      agents.set_tended_at(t, world.tick);
    } else {
      agents.set_work_done(t, done);
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

@phase(post)
physics ApplyWorkedHarvest {
  on WorkedHarvest { who: w, what: t } {
    let done = agents.work_done(t) + 1.0;
    if (done >= config.wb.work_harvest) {
      agents.set_work_done(t, 0.0);
      agents.set_claimed(t, 0u);
      agents.set_claimed_job(w, 0u);
      agents.set_sown(t, 0u);
      agents.set_growth(t, 0.0);
      agents.set_carry_kind(w, config.wb.it_grain);
      agents.set_carry_n(w, agents.carry_n(w) + config.wb.harvest_yield);
    } else {
      agents.set_work_done(t, done);
      agents.set_claim_until(w, world.tick + config.wb.claim_lease);
      agents.set_claim_until(t, world.tick + config.wb.claim_lease);
    }
  }
}

// -- haul legs --
// Cache pickup: first nonzero item in fixed order (meal, berries,
// venison, grain, timber, plank; hides to the side pocket), up to
// HAUL_CAP. Releases both sides of the claim.
@phase(post)
physics ApplyPickedCache {
  on PickedCache { who: w, what: t } {
    if (agents.carry_n(w) < 0.5) {
      let meal = agents.inv_meal(t);
      let ber = agents.inv_berries(t);
      let ven = agents.inv_venison(t);
      let gra = agents.inv_grain(t);
      let tim = agents.inv_timber(t);
      let pla = agents.inv_plank(t);
      let hid = agents.inv_hide(t);
      if (meal >= 1.0) {
        let n = min(meal, config.wb.haul_cap);
        agents.set_inv_meal(t, meal - n);
        agents.set_carry_kind(w, config.wb.it_meal);
        agents.set_carry_n(w, n);
      } else {
        if (ber >= 1.0) {
          let n = min(ber, config.wb.haul_cap);
          agents.set_inv_berries(t, ber - n);
          agents.set_carry_kind(w, config.wb.it_berries);
          agents.set_carry_n(w, n);
        } else {
          if (ven >= 1.0) {
            let n = min(ven, config.wb.haul_cap);
            agents.set_inv_venison(t, ven - n);
            agents.set_carry_kind(w, config.wb.it_venison);
            agents.set_carry_n(w, n);
          } else {
            if (gra >= 1.0) {
              let n = min(gra, config.wb.haul_cap);
              agents.set_inv_grain(t, gra - n);
              agents.set_carry_kind(w, config.wb.it_grain);
              agents.set_carry_n(w, n);
            } else {
              if (tim >= 1.0) {
                let n = min(tim, config.wb.haul_cap);
                agents.set_inv_timber(t, tim - n);
                agents.set_carry_kind(w, config.wb.it_timber);
                agents.set_carry_n(w, n);
              } else {
                if (pla >= 1.0) {
                  let n = min(pla, config.wb.haul_cap);
                  agents.set_inv_plank(t, pla - n);
                  agents.set_carry_kind(w, config.wb.it_plank);
                  agents.set_carry_n(w, n);
                } else {
                  if (hid >= 1.0) {
                    let n = min(hid, config.wb.haul_cap);
                    agents.set_inv_hide(t, hid - n);
                    agents.set_carry_hide(w, agents.carry_hide(w) + n);
                  }
                }
              }
            }
          }
        }
      }
    }
    agents.set_claimed_job(w, 0u);
    agents.set_claimed(t, 0u);
  }
}

@phase(post)
physics ApplyPickedHearth {
  on PickedHearth { who: w, what: t } {
    if (agents.carry_n(w) < 0.5) {
      let meal = agents.inv_meal(t);
      if (meal >= 1.0) {
        let n = min(meal, config.wb.haul_cap);
        agents.set_inv_meal(t, meal - n);
        agents.set_carry_kind(w, config.wb.it_meal);
        agents.set_carry_n(w, n);
      }
    }
    agents.set_claimed_job(w, 0u);
    agents.set_claimed(t, 0u);
  }
}

@phase(post)
physics ApplyPickedBench {
  on PickedBench { who: w, what: t } {
    if (agents.carry_n(w) < 0.5) {
      let pla = agents.inv_plank(t);
      if (pla >= 1.0) {
        let n = min(pla, config.wb.haul_cap);
        agents.set_inv_plank(t, pla - n);
        agents.set_carry_kind(w, config.wb.it_plank);
        agents.set_carry_n(w, n);
      }
    }
    agents.set_claimed_job(w, 0u);
    agents.set_claimed(t, 0u);
  }
}

@phase(post)
physics ApplyPickedStore {
  on PickedStore { who: w, what: t } {
    if (agents.carry_n(w) < 0.5) {
      let tim = agents.inv_timber(t);
      if (tim >= 1.0) {
        let n = min(tim, config.wb.haul_cap);
        agents.set_inv_timber(t, tim - n);
        agents.set_carry_kind(w, config.wb.it_timber);
        agents.set_carry_n(w, n);
      }
    }
    agents.set_claimed_job(w, 0u);
    agents.set_claimed(t, 0u);
  }
}

// Deliveries: serial consumers re-read need/stock so same-tick double
// deliveries settle honestly (second carrier keeps the remainder).
@phase(post)
physics ApplyDeliveredSiteTimber {
  on DeliveredSiteTimber { who: w, what: t } {
    let need = agents.need_timber(t);
    let have = agents.carry_n(w);
    let give = min(need, have);
    if (give > 0.0) {
      agents.set_need_timber(t, need - give);
      agents.set_carry_n(w, have - give);
      if (have - give < 0.5) {
        agents.set_carry_kind(w, 0u);
        agents.set_carry_n(w, 0.0);
      }
    }
  }
}

@phase(post)
physics ApplyDeliveredSitePlank {
  on DeliveredSitePlank { who: w, what: t } {
    let need = agents.need_plank(t);
    let have = agents.carry_n(w);
    let give = min(need, have);
    if (give > 0.0) {
      agents.set_need_plank(t, need - give);
      agents.set_carry_n(w, have - give);
      if (have - give < 0.5) {
        agents.set_carry_kind(w, 0u);
        agents.set_carry_n(w, 0.0);
      }
    }
  }
}

@phase(post)
physics ApplyDeliveredHearthFood {
  on DeliveredHearthFood { who: w, what: t } {
    let have = agents.carry_n(w);
    let kind = agents.carry_kind(w);
    if (have >= 1.0) {
      if (kind == config.wb.it_berries) {
        agents.set_inv_berries(t, agents.inv_berries(t) + have);
      } else {
        if (kind == config.wb.it_venison) {
          agents.set_inv_venison(t, agents.inv_venison(t) + have);
        } else {
          if (kind == config.wb.it_grain) {
            agents.set_inv_grain(t, agents.inv_grain(t) + have);
          }
        }
      }
      agents.set_carry_kind(w, 0u);
      agents.set_carry_n(w, 0.0);
    }
  }
}

@phase(post)
physics ApplyDeliveredBenchTimber {
  on DeliveredBenchTimber { who: w, what: t } {
    let have = agents.carry_n(w);
    if (have >= 1.0 && agents.carry_kind(w) == config.wb.it_timber) {
      agents.set_inv_timber(t, agents.inv_timber(t) + have);
      agents.set_carry_kind(w, 0u);
      agents.set_carry_n(w, 0.0);
    }
  }
}

@phase(post)
physics ApplyDeliveredStore {
  on DeliveredStore { who: w, what: t } {
    let have = agents.carry_n(w);
    let kind = agents.carry_kind(w);
    if (have >= 1.0) {
      if (kind == config.wb.it_berries) {
        agents.set_inv_berries(t, agents.inv_berries(t) + have);
      } else {
        if (kind == config.wb.it_venison) {
          agents.set_inv_venison(t, agents.inv_venison(t) + have);
        } else {
          if (kind == config.wb.it_grain) {
            agents.set_inv_grain(t, agents.inv_grain(t) + have);
          } else {
            if (kind == config.wb.it_meal) {
              agents.set_inv_meal(t, agents.inv_meal(t) + have);
            } else {
              if (kind == config.wb.it_timber) {
                agents.set_inv_timber(t, agents.inv_timber(t) + have);
              } else {
                if (kind == config.wb.it_plank) {
                  agents.set_inv_plank(t, agents.inv_plank(t) + have);
                }
              }
            }
          }
        }
      }
      agents.set_carry_kind(w, 0u);
      agents.set_carry_n(w, 0.0);
    }
    let hides = agents.carry_hide(w);
    if (hides > 0.5) {
      agents.set_inv_hide(t, agents.inv_hide(t) + hides);
      agents.set_carry_hide(w, 0.0);
    }
  }
}

// S6 — the sale lands: one hide into the trader's packs, hide_sell out
// of the finite purse (trade.ts floor(4 * 0.6) = 2). The re-check
// guards the mask's stale read; the HOST reads the purse delta back at
// dawn and credits it to the guild's gold (the campaign side of the
// same coin — the purse never mutates anywhere else mid-day).
@phase(post)
physics ApplySoldHide {
  on SoldHide { who: w, what: t } {
    let hides = agents.carry_hide(w);
    if ((hides >= 1.0) && (agents.purse(t) >= config.wb.hide_sell) && (agents.trader_active(t) == 1u)) {
      agents.set_carry_hide(w, hides - 1.0);
      agents.set_inv_hide(t, agents.inv_hide(t) + 1.0);
      agents.set_purse(t, agents.purse(t) - config.wb.hide_sell);
    }
  }
}

// -- need verbs --
// Eat: meals first (nutrition 1), else raw per needs.ts's chain
// (2 berries / 2 venison / 4 grain), full-or-nothing. Raw adds the
// ate_raw thought; a meal stamps the supper tick.
@phase(post)
physics ApplyAteAt {
  on AteAt { who: w, what: t } {
    if (agents.need_food(w) < 0.9) {
      let meal = agents.inv_meal(t);
      if (meal >= 1.0) {
        agents.set_inv_meal(t, meal - 1.0);
        agents.set_need_food(w, 1.0);
        agents.set_ate_meal_tick(w, world.tick);
      } else {
        let ber = agents.inv_berries(t);
        if (ber >= 2.0) {
          agents.set_inv_berries(t, ber - 2.0);
          agents.set_need_food(w, 1.0);
          emit ThoughtAteRaw { who: w }
        } else {
          let ven = agents.inv_venison(t);
          if (ven >= 2.0) {
            agents.set_inv_venison(t, ven - 2.0);
            agents.set_need_food(w, 1.0);
            emit ThoughtAteRaw { who: w }
          } else {
            let gra = agents.inv_grain(t);
            if (gra >= 4.0) {
              agents.set_inv_grain(t, gra - 4.0);
              agents.set_need_food(w, 1.0);
              emit ThoughtAteRaw { who: w }
            }
          }
        }
      }
    }
    agents.set_claimed_job(w, 0u);
  }
}

@phase(post)
physics ApplyNapped {
  on Napped { who: w } {
    agents.set_need_rest(w, min(agents.need_rest(w) + 0.02, 1.0));
  }
}

// S4: the tend lands — mends a little, stamps the once-per-day gate, and
// warms the patient toward the tender (WARM_SAVED on the mood-blend
// field; the pair cell is the standing_tended fold's business). At most
// one Tended per (tick, patient) by the TendSick slot gate, and this
// post write can never race Jostle's per_agent write (phases are
// sequential within a tick).
@phase(post)
physics ApplyTended {
  on Tended { target: t, actor: a } {
    agents.set_hp(t, min(agents.hp(t) + config.wb.tend_heal, 100.0));
    agents.set_tended_at(t, world.tick);
    agents.set_standing_sum(t, agents.standing_sum(t) + config.wb.warm_tended);
  }
}

// -- S5 raid consumers (ALL raid-state mutation lives here: post-phase
// writes are the only ones per_agent cross-reads may depend on) --

@phase(post)
physics ApplyRaidWarning {
  on RaidWarning { who: w } {
    agents.set_warned(w, 1u);
  }
}

@phase(post)
physics ApplyMustersNow {
  on MustersNow { who: w } {
    agents.set_raid_active(w, 1u);
  }
}

// S5c — THE SWING IS NOW A DEED RECORD AND A COOLDOWN STAMP, NOTHING
// MORE. The blow itself travels as the dispatcher's EffectDamageApplied
// record (see ApplyEffectDamage). The striker's cooldown is their OWN
// cell, so these stay single-writer by the same phase construction they
// always had, and the Struck* tallies keep counting SWINGS — which is
// what a deed is. (With the warlord's circle a swing is no longer one
// hit: `count_struck_colonist` counts casts, `count_colonist_downed`
// counts people actually felled.)
@phase(post)
physics ApplyStruckRaider {
  on StruckRaider { who: w, what: _t } {
    agents.set_strike_cd_until(w, world.tick + config.wb.strike_cd);
  }
}

@phase(post)
physics ApplyStruckColonist {
  on StruckColonist { who: w, what: _t } {
    agents.set_strike_cd_until(w, world.tick + agents.atk_cd(w));
  }
}

// S5c — THE ONE `apply_ability` SITE IN THE FIXTURE. Everything a body
// swings arrives here as a registry slot and is handed to the engine's
// dispatcher, which reads the PROGRAM (amounts, shapes, per-effect
// areas) out of the compiled `.ability` corpus and writes one chronicle
// record per landed effect per body it catches. The fixture states WHO
// swings at WHOM; the catalog states WHAT a swing does. That split is
// the slice.
@phase(post)
physics DispatchSwing {
  on Swing { actor: a, target: t, ability: ab } {
    apply_ability ab by a target t
  }
}

// S5c — THE ABILITY DISPATCHER'S DAMAGE RECORD, AND THE ONE PLACE THE
// PORT'S COMBAT LAWS LIVE. Every blow in this fixture — the colonist's
// power_strike, each rank's TROOPS basic strike, and every body caught
// in the warlord's circle — arrives here as one record carrying the
// ability program's own `amount`.
//
// The dispatcher's AoE walk is GEOMETRY: it enumerates whatever stands
// inside the circle — trees, stores, other raiders, the caster. Teams
// are this rule's business, and the two gates below are Webband's own
// rules, not a workaround:
//   * an AoE catches ENEMIES only (engine.ts scores an area cast by the
//     enemies it catches), so a colonist-cast record only ever hurts a
//     raider and a raider-cast record only ever hurts a colonist. That
//     is also what keeps the sweep from cutting down its own warband.
//   * KO, NOT DEATH: a colonist floors at 0 hp and goes `downed`;
//     `alive` is NEVER set false for ct_colonist by any path in this
//     fixture. The already-downed are skipped outright — raiders do not
//     finish off the fallen, and with a circle AoE that law cannot live
//     in the strike mask alone (the mask only screens the AIMED body),
//     so it lives HERE, where every record must pass.
// Raiders DIE at 0 — enemies are the only combatants death may take.
@phase(post)
physics ApplyEffectDamage {
  on EffectDamageApplied { actor: a, target: t, amount: amt } {
    if ((agents.creature_type(a) == config.wb.ct_colonist)
        && ((agents.creature_type(t) == config.wb.ct_raider)
            || (agents.creature_type(t) == config.wb.ct_warlord))
        && (agents.raid_active(t) == 1u)) {
      let left = agents.hp(t) - amt;
      if (left <= 0.0) {
        agents.set_hp(t, 0.0);
        agents.set_alive(t, false);
        emit RaiderSlain { who: a, what: t }
      } else {
        agents.set_hp(t, left);
      }
    }
    if (((agents.creature_type(a) == config.wb.ct_raider)
         || (agents.creature_type(a) == config.wb.ct_warlord))
        && (agents.creature_type(t) == config.wb.ct_colonist)
        && (agents.downed(t) == 0u)) {
      let hurt = max(agents.hp(t) - amt, 0.0);
      agents.set_hp(t, hurt);
      if (hurt <= 0.5) {
        agents.set_downed(t, 1u);
        agents.set_claimed_job(t, 0u);
        emit ColonistDowned { who: t, what: a }
      }
    }
  }
}

// S5c — RESTORED WITH THE SWEEP: warlord_sweep's `knockback 2` (Webband
// gated it on the strike not being fully blocked; this engine has no
// block roll, so the gate is vacuously true — the S5-prep mapping).
// Pushed straight away from the caster, `amount` metres. Same team gate
// and same never-touch-the-downed law as the damage arm. Position is
// written in the POST phase here and in the PER_AGENT phase by Steer,
// which are sequential within a tick — never a race — and only one
// warlord may swing per tick, so no colonist's position has two writers.
@phase(post)
physics ApplyEffectKnockback {
  on EffectKnockbackApplied { actor: a, target: t, amount: amt } {
    if (((agents.creature_type(a) == config.wb.ct_raider)
         || (agents.creature_type(a) == config.wb.ct_warlord))
        && (agents.creature_type(t) == config.wb.ct_colonist)
        && (agents.downed(t) == 0u)) {
      let away = agents.pos(t) - agents.pos(a);
      let span = length(away);
      if (span > 0.001) {
        agents.set_pos(t, agents.pos(t) + (away / span) * amt);
      }
    }
  }
}

@phase(post)
physics ApplyWithdraws {
  on Withdraws { who: w } {
    if (agents.raid_active(w) == 1u) {
      agents.set_raid_active(w, 2u);
    }
  }
}

@phase(post)
physics ApplyRaiderGone {
  on RaiderGone { who: w } {
    if (agents.raid_active(w) == 2u) {
      agents.set_raid_active(w, 3u);
    }
  }
}

// The plunder: strips plunder_take units in ITEMS value order (hide 4 >
// meal 3 = plank 3 > venison 2 = timber 2 > berries 1 = grain 1 —
// fixed tie order; the per-stack food floor and exact take math are
// S7b's host-side port), stamps the scar, and turns the plunderer for
// home. Slot-gated to one plunder event per tick, and only reachable
// with zero standing defenders — no other writer of these cells can
// share the tick. PLUNDER-NOT-DEATH: no colonist cell is touched.
@phase(post)
physics ApplyPlundered {
  on Plundered { who: w, what: t } {
    if (agents.plundered_at(t) == 0u) {
      agents.set_plundered_at(t, world.tick);
      agents.set_raid_active(w, 2u);
      let hid = agents.inv_hide(t);
      let d_h = min(config.wb.plunder_take, hid);
      agents.set_inv_hide(t, hid - d_h);
      let take1 = config.wb.plunder_take - d_h;
      let mea = agents.inv_meal(t);
      let d_m = min(take1, mea);
      agents.set_inv_meal(t, mea - d_m);
      let take2 = take1 - d_m;
      let pla = agents.inv_plank(t);
      let d_p = min(take2, pla);
      agents.set_inv_plank(t, pla - d_p);
      let take3 = take2 - d_p;
      let ven = agents.inv_venison(t);
      let d_v = min(take3, ven);
      agents.set_inv_venison(t, ven - d_v);
      let take4 = take3 - d_v;
      let tim = agents.inv_timber(t);
      let d_t = min(take4, tim);
      agents.set_inv_timber(t, tim - d_t);
      let take5 = take4 - d_t;
      let ber = agents.inv_berries(t);
      let d_b = min(take5, ber);
      agents.set_inv_berries(t, ber - d_b);
      let take6 = take5 - d_b;
      let gra = agents.inv_grain(t);
      let d_g = min(take6, gra);
      agents.set_inv_grain(t, gra - d_g);
    }
  }
}

// -- thought folds into the blended mood coupling --
@phase(post)
physics ApplyThoughtAteRaw {
  on ThoughtAteRaw { who: w } {
    agents.set_thought_sum(w, agents.thought_sum(w) - 4.0);
  }
}

// ---------------------------------------------------------------------
// == THOUGHT VIEWS == (the needs.ts THOUGHTS table as decaying
// materialized views. Delta = the table's delta, decay = per-tick rate
// whose half-life equals the table's duration in days:
// 1d 0.998845, 2d 0.999422, 3d 0.999615, 4d 0.999711. `clamp:` is not
// lowered in folds (S1 defect a) — totals are bounded by construction
// (<= 1 emitter per colonist-day => |view| <= |delta| * 2 at steady
// state) and the Rust test pins them numerically.)

// Exact (non-decaying) counters for the three S3-emitted thoughts —
// they separate "events missing" from "decay math" in the pins.
@materialized(on_event = [ThoughtAteRaw])
view count_ate_raw(who: Agent) -> f32 {
  initial: 0.0,
  on ThoughtAteRaw { who: w } where (w == who) { self += 1.0 }
  clamp: [0.0, 1000000.0],
}

