  } else { -1000000000.0 })

verb EatCache(self, target: Agent) =
  action EatCacheAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_cache
        && self.downed == 0u
        && self.claimed_job == config.wb.jk_eat
        && ((world.tick % 20) == ((self.stagger + 3u) % 20u))
        && self.need_food < 0.9
        && (target.inv_meal >= 1.0 || target.inv_berries >= 2.0 || target.inv_venison >= 2.0 || target.inv_grain >= 4.0)
        && distance(self.pos, target.pos) < config.wb.reach)
  emit AteAt { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_cache)) {
