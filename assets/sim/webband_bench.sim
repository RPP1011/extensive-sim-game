                    || self.carry_kind == config.wb.it_hide)))
        && distance(self.pos, target.pos) < config.wb.reach
        && self.downed == 0u
        && ((world.tick % 20) == ((self.stagger + 19u) % 20u)))
  emit DeliveredStore { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_store)) {
    config.wb.band_deliver_store - distance(self.pos, target.pos)
  } else { -1000000000.0 })

