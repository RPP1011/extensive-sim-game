  } else { -1000000000.0 })

// Tend once per ~day per sown plot (590-tick cooldown stamp).
verb ClaimTend(self, target: Agent) =
  action ClaimTendAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_plot
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
        && ((world.tick % 20) == ((self.stagger + 7u) % 20u))
        && target.claimed == 0u
        && target.sown == 1u
        && target.growth < config.wb.grow_days
        && target.tended_at + 590u < world.tick)
  emit ClaimedTend { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_plot) && (target.claimed == 0u) && (target.sown == 1u) && (target.growth < config.wb.grow_days) && (target.tended_at + 590u < world.tick)) {
    config.wb.band_tend + self.pri_grow * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

verb ClaimHarvest(self, target: Agent) =
  action ClaimHarvestAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_plot
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
        && ((world.tick % 20) == ((self.stagger + 8u) % 20u))
        && target.claimed == 0u
        && target.sown == 1u
        && target.growth >= config.wb.grow_days)
  emit ClaimedHarvest { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_plot) && (target.claimed == 0u) && (target.sown == 1u) && (target.growth >= config.wb.grow_days)) {
    config.wb.band_harvest + self.pri_grow * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// Haul intents (exclusive: one hauler per holder at a time).
verb ClaimHaulCache(self, target: Agent) =
  action ClaimHaulCacheAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_cache
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
        && ((world.tick % 20) == ((self.stagger + 9u) % 20u))
        && target.claimed == 0u
        && (target.inv_meal + target.inv_berries + target.inv_venison + target.inv_grain + target.inv_timber + target.inv_plank + target.inv_hide) > 0.5)
  emit ClaimedHaulCache { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_cache) && (target.claimed == 0u) && ((target.inv_meal + target.inv_berries + target.inv_venison + target.inv_grain + target.inv_timber + target.inv_plank + target.inv_hide) > 0.5)) {
    config.wb.band_haul + self.pri_haul * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// Fetch cooked meals from the hearth to the store.
verb ClaimHaulHearth(self, target: Agent) =
  action ClaimHaulHearthAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_hearth
