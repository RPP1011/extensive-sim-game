// ---------------------------------------------------------------------
// == MINDS VIEWS == (spike-preserved: the S1 pair-domain dispatch pin
// lives on these three declarations — do not restructure without
// keeping the pair/single ratio + exact-decay assertions green)

// NOTE (S4 finding, decl untouched — the S1 pin lives here): despite the
// where-clause's victim-as-observer binding, the pair fold keys cells
// (first Agent field, second Agent field) = (aggressor, victim), so
// grudge[x][y] actually means "x aggressed on y". The S1 pins sum the
// whole domain and are direction-blind; per-cell readers must know.
@materialized(on_event = [Brawl], storage = pair_map)
@decay(rate = 0.99, per = tick)
belief grudge(observer: Agent, subject: Agent) -> f32 {
  initial: 0.0,
  on Brawl { aggressor: a, victim: v }
    where (v == observer) && (a == subject)
    { self += 10.0 }
  clamp: [0.0, 100.0],
}

@materialized(on_event = [Brawl])
@decay(rate = 0.99, per = tick)
view grudge_load(victim: Agent) -> f32 {
  initial: 0.0,
  on Brawl { aggressor: _, victim: v } where (v == victim) { self += 1.0 }
  clamp: [0.0, 100000.0],
}

@materialized(on_event = [Brawl])
view brawls_total(victim: Agent) -> f32 {
  initial: 0.0,
  on Brawl { aggressor: _, victim: v } where (v == victim) { self += 1.0 }
  clamp: [0.0, 1000000.0],
}

// ---------------------------------------------------------------------
// == S4 MINDS: PAIR STANDING + GOSSIP ==
// Effective standing(observer, subject) = standing_brawl + standing_tended
// (EXACT: same decay rate, decay is linear — split because multi-`on`
// fold views collide on kernel names, the S3 finding 5 law). Deltas are
// witness.ts foldIncident verbatim; decay is tuning.ts
// STANDING_RETAIN_BASE 0.982/day -> 0.9999697/tick (600 ticks/day). The
// clamp decls document TS's i16 range but do NOT lower (S1 defect a) —
// totals are pinned numerically instead, and mood clamps at read.
// NO merge clause on either standing belief or on grudge: STANDING AND
// GRUDGES NEVER GOSSIP (the gossip.ts law; the Rust test lints this).

// AGGRESSOR-perspective on purpose (observer = the one who threw the
// punch, souring on the one punched): foldIncident sours BOTH parties,
// and the mirrored jostle emission carries the other direction — but the
// spatial scan is NOT exactly symmetric (a cell-boundary neighbour can be
// enumerated twice one way and once the other, found by the engineered
// pin), so the fold direction must match the emitter-side standing_sum
// inline fold for field == row-sum to hold EXACTLY per event.
@materialized(on_event = [Brawl], storage = pair_map)
@decay(rate = 0.9999697, per = tick)
belief standing_brawl(observer: Agent, subject: Agent) -> f32 {
  initial: 0.0,
  // `+= -2100` NOT `-= 2100`: the Add op lowers as the full-domain
  // serial scan (the S1-fixed shape); `-=` lowers as a per-EVENT CAS
  // kernel guarded at agent_count, which drops ring rows past the cap
  // on heavy storm ticks (S1 defect (b) — brawl storms reach ~670
  // events/tick at colony scale, over the 512 cap).
  on Brawl { aggressor: a, victim: v }
    where (a == observer) && (v == subject)
    { self += -2100.0 }
  clamp: [-32768.0, 0.0],
}

@materialized(on_event = [Tended], storage = pair_map)
@decay(rate = 0.9999697, per = tick)
belief standing_tended(observer: Agent, subject: Agent) -> f32 {
  initial: 0.0,
  on Tended { target: t, actor: a }
    where (t == observer) && (a == subject)
    { self += 4000.0 }
  clamp: [0.0, 32767.0],
}

// The gossip carrier: notoriety (A_NOTORIETY). First-hand from witnessed
// prowess (+NOTORIETY_PER_LEVEL 1200); at supper every teller broadcasts
// and every listener adopts the HIGHER value (merge op max — atomicMax on
// non-negative f32 bit patterns is order-correct). RUMOUR_FADE x0.85 and
// hop counting are inexpressible in the atomic merge ops (documented in
// the header); ATTR_DECAY[A_NOTORIETY] 0.97/day is deliberately NOT
// applied — a decay kernel over the merge kernel's atomic storage is
// unproven, and an undecayed carrier keeps the max-merge monotone.
@materialized(on_event = [ProwessSeen], storage = pair_map)
belief repute(observer: Agent, subject: Agent) -> f32 {
  initial: 0.0,
  on ProwessSeen { who: w, whom: s }
    where (w == observer) && (s == subject)
    { self += 1200.0 }
  on SupperTale { teller: t } merge from t: max
  clamp: [0.0, 1000000000.0],
}

// Exact incident counters (the count_* idiom: separate "did the event
// land" from "is the decay right" in the pins).
@materialized(on_event = [Tended])
view count_tended(who: Agent) -> f32 {
  initial: 0.0,
  on Tended { target: t, actor: _ } where (t == who) { self += 1.0 }
  clamp: [0.0, 1000000.0],
}

@materialized(on_event = [SupperTale])
view count_supper(who: Agent) -> f32 {
