// webband_bench — BENCHMARK COPY of webband_colony.sim (perf slice,
// 2026-07-22). IDENTICAL to the production fixture in every rule, verb,
// view, belief and config — the ONLY edit is `spawn Colonist count 20`
// -> `count 500`. Live population is dialled at RUNTIME by writing
// agent_alive_buf (the S6 roster-pool idiom), so one build serves the
// whole population sweep. NOT a gameplay fixture: at >20 colonists the
// stagger%20 phase-slot construction (see the determinism law below)
// no longer gives one writer per (tick, cell), so runs above pop 20 are
// PERF PROXIES ONLY and are not determinism-faithful. Resources are
// deliberately NOT scaled with the roster, so the only variable across
// the sweep is the number of colonists.
//
// webband_colony — Webband's colony economy on the DSL engine (port slice S3).
//
// Grown from the S1/S2 spike: ~20 colonists run the RimWorld-style Webband
// colony loop — four needs -> mood, THOUGHTS as decaying views, items/stacks,
// recipes at stations, blueprint -> deliver -> build buildings, and jobs as
// utility-scored verbs with a TRUE claim reservation (S2 custom-fields
// verdict). Numbers port F:\MB\src\colony\{defs,needs,jobs}.ts via
// docs/superpowers/plans/webband-port-data.md. 1 tick = 1 Webband minute;
// 600 ticks = 1 day; dawn systems fire on world.tick % 600 == 0.
//
// == REPRESENTATION CHOICES (documented per the plan) =====================
//  * Resources/stations/buildings are DORMANT AGENTS discriminated by
//    creature_type (declaration order): Colonist=0 Tree=1 Bush=2 Game=3
//    Plot=4 Store=5 Cache=6 Hearth=7 Workbench=8 Bed=9 Shed=10 Wall=11.
//  * STACKS ARE POOLED INVENTORY FIELDS (inv_*) on holder agents (Store,
//    Cache, Hearth, Workbench), not per-stack agents. The founding cache is
//    one stray pile whose contents must be HAULED to the store — the
//    Webband teaching loop. Per-stack spoilDay stamps and stack merge/spill
//    cannot express over pooled counts; see simplifications.
//  * CLAIM PROTOCOL (the TRUE reservation): a Claim* verb fires from
//    anywhere (score = priority band + per-colonist pri field * scale −
//    distance); its @phase(post) consumer GRANTS the claim with old-value
//    guards (colonist still unclaimed AND target unclaimed) — consumers run
//    serially, so two same-tick claims on one target grant exactly once.
//    The grant writes colonist.claimed_job (kind) + colonist.job_site (the
//    target's position, vec3) and target.claimed = 1.
//    DETERMINISM LAW (S3 finding): @phase(post) consumers apply same-tick
//    events in PARALLEL with stale reads — any two same-tick events that
//    touch the same state resolve by GPU scheduling, which is run-to-run
//    NONDETERMINISTIC. Every verb family that could race therefore owns a
//    per-colonist PHASE SLOT: `world.tick % 20 == (stagger + N) % 20`,
//    N distinct per claim kind (0-15), pickups 17, delivers 16/18/19
//    (overlapping masks never share a phase), eat legs 1-3. Work verbs
//    stay unphased (single claimant = single writer). This replaces the
//    old %5 handling gates; handling now costs up to 20 min, and it is
//    what makes two identical runs bit-equal. Steering walks the
//    colonist to job_site; the Work* verb only fires in reach of a claimed
//    target of the matching kind whose position matches job_site (< 0.75u).
//    Completion (or the lease janitor) releases both sides. Job kinds
//    1..12 are EXCLUSIVE (chop forage hunt build cook craft sow tend
//    harvest haul_cache haul_hearth haul_bench); eat claims (13) are
//    deliberately shared (many may eat at once; consumers guard stock).
//  * WORK TAKES TIME via work-progress fields: each Work* event lands
//    +1 work-minute on the target's work_done (build decrements work_left);
//    completion triggers at the defs.ts work total. Pickup/drop/eat are
//    instant transfers gated to their owner's PHASE SLOT (see the
//    determinism law below) — handling costs up to one 20-tick phase
//    cycle, the port's stand-in for PICKUP/DROP 5 min.
//  * MOVEMENT IS STEERING (engine law): claimed -> walk to job_site;
//    carrying -> walk to the best sink for the carried item (blueprint
//    needing it > station wanting it > store); idle -> drift home.
//
// == HONEST SIMPLIFICATIONS (vs the TS originals) =========================
//  * Eat is a VERB at a food holder (store/cache/hearth), not a dawn batch:
//    need_food drains 1/day continuously; a colonist below 0.35 claims an
//    eat trip. Dawn only resolves STARVATION (never ate -> hp -15 floor 5,
//    starving_days += 1, `starving` thought — the Webband rule; no
//    starvation death). Meals-first then raw (berries 2 / venison 2 /
//    grain 4) matches needs.ts's chain, but full-or-nothing (no partial
//    nutrition mixing across items).
//  * Spoilage is a dawn sweep multiplying spoiling stock by (1 - 1/spoilDays)
//    — a continuous-fraction approximation of per-stack absolute spoilDay
//    stamps. A built store shed halves the loss GLOBALLY (defs.ts spoilMult
//    2 without the SHED_REACH=2 hex geometry).
//  * THOUGHTS: the full 11-entry table exists as decaying views (each
//    view's per-tick rate gives a half-life equal to the TS duration in
//    days — an exponential stand-in for the TS boxcar; `clamp:` is not
//    lowered in folds (S1 defect a) so totals are bounded by construction:
//    one emitter per colonist-day, geometric series). Only ate_raw /
//    slept_rough / starving have S3 emitters; the other 8 await S4-S6
//    events. Mood couples through a single blended thought_sum field
//    (1-day half-life) because physics cannot read views.
//  * slept_rough / rest / comfort use COLONY-AVERAGE bed cover
//    (built beds / colonists) rather than per-colonist bed ownership;
//    comfort's mess-table term is stood in by the hearth (no mess table in
//    the S3 building set). Supper cheer = ate a meal within the last day.
//  * Recipe ingredients live AT the station (hauled there by carriers),
//    consumed at completion with a live re-check — there is no store ->
//    station fetch; raw food parked at the store is eaten raw. FETCH's
//    flat 15 min is therefore priced as real hauling instead.
//  * The global KEEP_* bill gates (timber 30 / food-units 30) are dropped;
//    station keeps survive (cook while hearth meals < 12, saw while bench
//    planks < 16). Gathering is throttled by priority bands instead.
//  * Tend is once-per-~day make-work (590-tick cooldown stamp) and growth
//    advances at dawn unconditionally (jobs.ts's tend gate, simplified).
//  * healColonists: fed colonists regain 25 hp/day (cap 100); the
//    surgeon/cot/poultice ladder and injuryDays await S5 combat.
//  * Haul claim dogpiles: a claimed hauler who arrives to an emptied
//    holder idles until its short lease (120 ticks) frees it.
//  * workSpeedFor perk multipliers await S4+ progression (all hands 1.0).
//
// == PAIR-GRUDGE PIN (preserved from the spike / S1 fix) ==================
// Jostling colonists within 2u brawl every 20th tick until tick 5800; the
// pair-keyed `grudge` belief (+10/brawl, x0.99/tick) must track the
// single-key `grudge_load` (+1/brawl) at ratio ~10 and decay by exactly
// 0.99^N over the brawl-free tail — the S1 pair-domain dispatch pin.
//
// == S4: THE MINDS LAYER (foldIncident + gossip, F:\MB\src\minds\) =======
//  * PAIR STANDING as two same-rate beliefs (standing_brawl <= 0,
//    standing_tended >= 0; effective standing = their sum — exact, both
//    decay at the same rate and decay is linear). Deltas port witness.ts
//    foldIncident: brawl sours both parties SOUR_VICTIM*0.6 = 2100 (the
//    mutual sour is carried by the SYMMETRIC jostle emission — each side's
//    event writes the other direction's cell); a sickbed tend warms the
//    tended toward the tender WARM_SAVED = 4000. COLONIST GRUDGES NEVER
//    LATCH: there is no hostile-latch field at all (the witness.ts law —
//    every foldIncident sour passes latch=false; the stronger port is to
//    not represent the latch for allies). Witness-sour (SOUR_WITNESS*0.5),
//    the A_OWES debt ledger, sagas, and camp affinity are NOT ported (see
//    simplifications).
//  * DECAY per tuning.ts converted per-day -> per-tick (600 ticks/day):
//    STANDING_RETAIN_BASE 0.982^(1/600) = 0.9999697/tick. The value-keyed
//    span term (+0.018*|st|/32768/day — strong ties fade slower) is NOT
//    expressible in a constant-rate @decay; base-rate-only is the port
//    (documented; the Rust test asserts the conversion round-trips).
//  * standing_sum (colonist field) tracks the row sum of the two pair
//    beliefs (same events inline/consumer-folded, same decay rate) because
//    physics cannot read views — it exists ONLY to feed mood's company
//    term. TRACKS, not mirrors-exactly (S4 engine finding): view folds
//    consume the ring ONE TICK LATE over a radix-SORTED segment that the
//    next tick's emitters are already overwriting, so on busy ticks a
//    row can land 0 or 2 times in the folds while the inline/post field
//    write lands exactly once per emission. All serial-scan views read
//    the SAME sorted window, so view-vs-view stays exact (the count_*
//    normalization the pins use); field-vs-view is bounded, not exact.
//    THE EPISTEMIC SPLIT HOLDS: no verb mask or score reads
//    standing_sum, grudge, standing_*, or repute; mood is the one
//    sanctioned belief coupling (needs.ts company = 8 * avgStanding/32768,
//    clamped to +-1 here since per-subject i16 clamping cannot lower).
//  * GOSSIP: the mess_table (defs.ts: plank 6, work 90) joins the founding
//    blueprints; once BUILT, a supper window fires each evening (tick %600
//    == 580 — offset off dawn %600==0 AND off the brawl storm %20==10, the
//    S3 event-volume law) and every colonist tells tales: `repute`
//    (notoriety, NOTORIETY_PER_LEVEL = 1200 per witnessed hunt kill)
//    spreads via the belief `merge from` mechanism (op max). STANDING AND
//    GRUDGES NEVER GOSSIP — no merge clause exists on standing_brawl /
//    standing_tended / grudge (the Rust test lints the source for this).
//    RUMOUR_FADE x0.85/hop and hop caps are NOT expressible (merge ops are
//    atomic bit_or/max/min/replace — value adopted unfaded, documented).
//
// == S5: RAIDS, REAL-TIME, ON THE COLONY MAP (F:\MB\src\colony\raids.ts +
//    battle/engine.ts decide() directive biases) =========================
//  * RAIDER POOL, DORMANT: 40 raid agents (Raider ct 13 x36 in three
//    TROOPS ranks — looter hp 42/atk 11, bandit 72/17, raider 105/24 —
//    plus Warlord ct 14 x4, hp 340/atk 40 = warlord_sweep's amount) are
//    pre-spawned parked at the rim (rings 37-39.5, 12 to a ring — parked
//    bodies are not claim targets, so the same-ring spacing law does not
//    apply to them; every staged cohort is repositioned anyway),
//    raid_active = 0,
//    musters_at = 0 (never). ACTIVATION IS AN INJECTION SEAM (the S3
//    starvation-knob idiom): a test (later the S7c host) writes
//    musters_at = T on a cohort; the fixture then runs the dawn-warning
//    schedule itself — RaidWarn emits RaidWarning at T-600 (one day's
//    warning; ApplyRaidWarning stamps `warned`, the reliable pin — the
//    count view rides the lossy fold window), RaidMuster at T computes
//    raid_total over the cohort (same musters_at) and emits MustersNow,
//    whose consumer flips raid_active = 1. With musters_at = 0 the whole
//    layer is inert — the S3/S4 runs are undisturbed by construction.
//    CONVENTION: schedule musters_at at dawn+12 (never %600==0 — the
//    warning burst must not share the dawn tick's event volume, S3
//    finding 3 — and never %20==10, the brawl storm).
//  * RAID-STATE WRITES ARE POST-ONLY (the determinism law extended):
//    raid_active / downed / hp / alive / strike_cd_until / plundered_at
//    / burnt / warned are written ONLY by @phase(post) consumers, so
//    every per_agent cross-read (raid_on senses, cohort counts, brains)
//    sees the settled prior-phase value — never a same-phase racing
//    write. per_agent rules write only SELF caches (raid_on, defenders,
//    dir_* resolvers, raid_total at muster from STATIC musters_at) and
//    pos (the Steer precedent).
//  * COMBAT IS ON THE PORTED `.ability` PROGRAMS (S5c, 2026-07-22 —
//    this REPLACES S5's "apply_ability is blocked for this fixture"
//    paragraph, which was true until S5b fixed the event-kind
//    allocator). Webband's law "abilities are data, never code" now
//    holds on this engine: the fixture says WHO swings at WHOM, the
//    catalog at assets/ability_test/webband_colony/ says WHAT a swing
//    does. Every strike verb emits its deed record (StruckRaider /
//    StruckColonist, which the tallies and the cooldown stamps ride)
//    plus `Swing { actor, target, ability }`; `DispatchSwing` is the
//    fixture's ONE `apply_ability` site; the engine's dispatcher reads
//    the program and writes EffectDamageApplied / EffectKnockbackApplied
//    chronicle records; ApplyEffectDamage / ApplyEffectKnockback are the
//    only place hp, death, KO and friend/foe are decided.
//    BOUND KITS (S5-prep's README table + data.ts's TROOPS rows):
//      colonist  -> WebbandPowerStrike   46 dmg, cd 60t, range 2.6
//      looter    -> WebbandLooterStrike  11 dmg  (ability_id 1)
//      bandit    -> WebbandBanditStrike  17 dmg  (ability_id 2)
//      raider    -> WebbandRaiderStrike  24 dmg  (ability_id 3)
//      warlord   -> WebbandWarlordSweep  40 dmg IN circle(3.5)
//                                        + knockback 2 in circle(3.5)
//    Every number is the one S5 hardcoded; they now live in the
//    catalog, and `ability_registry_slots_are_pinned` asserts the
//    registry against them.
//    RESTORED BY THE MIGRATION: the warlord's CIRCLE AoE and its
//    knockback (S5 shipped the amount only, single-target — "AoE lives
//    in the blocked dispatcher"). Measured by
//    `warlord_sweep_is_a_real_circle_aoe`: one swing, three colonists,
//    exactly 40 each, each shoved ~2 m away, nothing to the raider
//    standing inside the same circle.
//    STILL DROPPED, with the reason sharpened rather than repeated:
//    second_wind (its self-heal writes the warlord's own hp cell in the
//    post phase, and a colonist strike may write that same cell in the
//    same tick — colonists occupy every residue mod 20 by construction,
//    so no unopposed tick exists without re-deriving the colonist phase
//    map, which is a balance change, not a fidelity fix); cleaving_blow's
//    CONE on the ranks (a rank cone would spray both target parities and
//    break the per-(tick,target) single-writer construction the ranks
//    depend on — the warlord's sweep is the AoE, and it pays for the
//    privilege with an exclusive residue window); projectile delivery
//    (visual-only in Webband anyway). The eight unbound catalog specs
//    are declared, validated and registry-resident — binding one is a
//    dispatch line, not new code.
//    STRIKES ARE PHASE-SLOTTED like claims. Colonist strikes fire on
//    (stagger+5)%20 — 20 colonists on 20 consecutive slots cover all 20
//    residues, so at most one colonist swings per tick and a raider's hp
//    cell has one writer. RAIDER-SIDE THE CYCLE IS 40 TICKS WITH A
//    TARGET-PARITY TERM (S6b, when the pool doubled): a raider may swing
//    at tick T against target t iff
//        T % 40 == (self.stagger + 20*(t.stagger % 2)) % 40
//    and the 40-body pool sits on 40 CONSECUTIVE slots, so the staggers
//    are distinct mod 40. For any (tick, target) exactly ONE pool body
//    is eligible — two raiders can never write one colonist's hp cell in
//    a tick — while each body still gets a window every 20 ticks (the
//    congruence has two solutions per 40-tick cycle, one per target
//    parity), which keeps the ported once-per-round cadence. The old
//    (stagger)%20 gate could not survive the resize: 40 bodies on 20
//    residues put two raiders on one hp cell, and post-consumer
//    read-modify-writes race non-deterministically (S3 finding 4).
//    Aggregate warband throughput also DOUBLES with the pool (2 swings/
//    tick at 40 bodies vs the old hard 1/tick), which is the direction
//    the escalation clock asks for. Plunder keeps the simple wide gate,
//    (stagger+7)%40: holders carry stagger 0, so one plunderer per tick.
//    S5c ADDS THE WARLORD'S EXCLUSIVE WINDOW. A circle AoE writes MANY
//    colonist hp cells from ONE cast, so the per-(tick, target) argument
//    above buys it nothing — the sweep sprays both target parities. The
//    four warlord bodies therefore take
//        T % 40 == self.stagger % 40
//    (residues 34..37 as the founding lays the pool out — four distinct
//    residues for four bodies, so one warlord per tick at most), and the
//    ranks add `T % 40 outside [warlord_phase_lo, warlord_phase_hi]`.
//    On a warlord tick the sweep is the ONLY writer of any colonist hp
//    cell in the colony; on every other tick the parity construction is
//    untouched. Cost, stated rather than hidden: the four ranks whose
//    (stagger + 20) % 40 lands in 34..37 lose their SECOND window per
//    cycle. `warlord_sweep_is_a_real_circle_aoe` reads the live staggers
//    back and asserts both halves of the exclusivity, so a pool resize
//    that broke it would fail loudly instead of going nondeterministic.
//  * KO, NOT DEATH: a colonist at hp <= 0 goes DOWNED (alive stays true,
//    downed = 1, claims/works/eats/nap/brawl/supper/tend-as-tender all
//    masked off, steering holds them where they fell). Raiders DIE
//    (set_alive false). Recovery: TendSick (S4) reaches hp < 20, so the
//    downed are its patients — idle hale colonists steer toward the
//    downed (Steer's downed_pull), each tend mends +10 once per patient
//    per day, and the dawn un-downs at hp >= 20 (then the ordinary +25
//    dawn heal resumes). Downed colonists are spoon-fed (need_food held
//    at 0.6, no starve arm, no larder debit — documented simplification).
//  * RAIDER STEERING: goal = the stores (origin); a standing colonist
//    within engage_r pulls the raider into the fight; BUILT walls repel
//    (inverse-square keepout ring + a fixed-CCW tangential slide so the
//    flow bends around the palisade instead of stalling on the symmetry
//    axis). Walls gate movement only — there is no line-of-sight system,
//    strikes reach over a wall, and colonist steering ignores walls
//    (documented). Four PRE-BUILT palisade posts join the founding
//    (built: 1 — inert to the economy: no claim mask targets a built
//    wall, DemandTick counts only blueprints) so raid tests can stand a
//    real wall line without touching the S3 build chain.
//  * WITHDRAW + PLUNDER (raids.ts): a raider withdraws (raid_active 2,
//    walks out, 3 = gone at the rim) on timeout (musters_at +
//    raid_timeout 4800 — the task's ROUND_CAP scaling), on losses
//    (alive cohort * 2 < raid_total), or once the stores are plundered.
//    PLUNDER fires only when defenders == 0 (every colonist downed —
//    which is also what makes the store write race-free: no colonist
//    verb can fire) and not on a dawn tick: drains plunder_take units
//    in ITEMS value order (hide 4 > meal 3 = plank 3 > venison 2 =
//    timber 2 > berries 1 = grain 1; fixed tie order, the per-stack
//    food floor is S7b's host-side math), stamps plundered_at, and the
//    BurnSweep dawn-free rule chars built buildings beyond burn_r
//    (radius threshold, not the TS exact top-2 sort — documented). NO
//    COLONIST DIES: defeat costs stock and standing, the warband MOVES
//    ON (plunder-not-death).
//  * DIRECTIVES (engine.ts decide() biases, injected per colonist via
//    directive_kind 0-4 / directive_target (a STAGGER value — staggers
//    are the stable cross-agent id, slot-seeded and unique) /
//    directive_pos): guard (1) restricts strike targets to raiders
//    within guard_r of the ward and pulls the guard to the ward; hold
//    (2) walks to the anchor and STANDS (the clamped-empty-walk rule —
//    strikes still fire at whatever closes to reach); focus (3) boosts
//    the named raider's strike score over every distance term and
//    steers at them; harry (4) biases score by -hp and weights the
//    chase toward the wounded. All directives bias MASKS/SCORES/
//    steering only — damage resolves through the same two events and
//    consumers whatever the steering said (deeds stay
//    steering-agnostic, the Webband law). A dead target self-cleans:
//    dir_live drops and the colonist falls back to plain foe-chasing.
//
// == S6: THE CAMPAIGN SEAMS (host-drives-fixture — the storyteller is
//    campaign-side, this colony is the sim; crates/sims/tests/
//    webband_campaign.rs is the bridge, webband_app the brain) ========
//  * THE FIXTURE STAYS STORYTELLER-BLIND: no director state, no gold,
//    no roster ids live here. The bridge steps 600 ticks, reads the
//    colony back (holder inv_* -> InventorySnapshot; mood/starving_days
//    per rostered slot), runs webband_app's dawn_fold, and writes the
//    resolved tropes back through the established injection seams:
//    raid -> musters_at on a comp-mapped cohort (the S5 seam, verbatim);
//    windfall -> inv drops on the RIM CACHE (slot 119 — the ordinary
//    haul economy carries them in); provisioner meals -> the yard
//    cache; festival -> need_cheer/thought_sum writes (no event, so
//    the thought_festival VIEW stays flat — documented); caravan ->
//    the Trader agent below.
//  * ROSTER IS THE SLOT POOL: campaign roster members map 1:1 onto
//    colonist slots (roster order -> slot order); slots beyond the
//    roster are DEACTIVATED at founding (alive=0 — the recruit pool).
//    A wanderer JOIN re-activates a pooled slot; a starvation EXODUS
//    deactivates one. Because pool slots are original colonist slots,
//    every activation inherits a UNIQUE stagger residue — the %20
//    phase-exclusivity construction survives roster churn BY
//    CONSTRUCTION (a 21st simultaneous colonist is impossible).
//  * THE CARAVAN (trade.ts at colony scale): Trader ct 15, dormant
//    (trader_active 0). The host camps it (active=1, purse = 60 +
//    rngInt(0,80)) for two days. IN-FIXTURE selling: a hide-only
//    carrier detours to the camp (Steer's trader_pull) and SoldHide
//    sells one hide per phase window at hide_sell = floor(4 * 0.6) = 2
//    from the finite purse; the host reads the purse delta back as
//    gold. HOST-side trading (the TS trade-panel seam, verdicts in
//    trade.ts): stored hides sold / wares bought at the 0.6/1.5 spread
//    as dawn-boundary buffer writes — purchases land on the rim cache
//    (caravanSpot's even-luck-makes-haul-work rule). Departure: host
//    zeroes trader_active/purse/inv_hide.
//  * RAID RESOLUTION IS HOST-FOLDED: victory = the cohort dead or
//    withdrawn with no holder plundered_at; defeat = the fixture's own
//    plunder (the campaign's apply_plunder then lands renown/relief
//    only — the fixture's drain IS the stock truth). After every
//    resolution the host RESETS the pool (alive/hp/raid_active/
//    musters_at/warned/plundered_at) — plundered_at MUST clear or the
//    next raid instant-withdraws on RaiderBrain's plundered check, and
//    a defeat's all-downed roster is un-downed at homecoming hp (TS
//    "everyone mends"; an all-downed colony has no tender left, so
//    organic recovery cannot start itself).

// PER-KERNEL TIMING (2026-07-22). This is the BENCH copy, so it is lowered
// at D3 — the compiler emits `dispatch::DebugTimings` + one
// `record_<kernel>_timing` helper per kernel, and (since the same day) the
// generated `step()` actually CALLS them. Nothing is allocated or timed
// unless the process sets `SIM_KERNEL_TIMINGS=1`; the depth affects only
// dispatch.rs, never a line of WGSL, so this fixture still computes exactly
// what `webband_colony` computes. Any other fixture can be raised the same
// way for one build with `SIM_DEBUG_DEPTH=3`.
debug {
  depth: kernel,
}

event Tick { }

// ---------------------------------------------------------------------
// == EVENTS ==
// Claim grants (verb -> consumer), one per exclusive kind + shared forms.
@replayable @gpu_amenable
event ClaimedChop { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedForage { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedHunt { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedBuild { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedCook { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedCraft { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedSow { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedTend { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedHarvest { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedHaulCache { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedHaulHearth { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedHaulBench { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedEat { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ClaimedHaulStore { who: AgentId, what: AgentId }

// Work minutes (one per tick at the face).
@replayable @gpu_amenable
event WorkedChop { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event WorkedForage { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event WorkedHunt { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event WorkedBuild { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event WorkedCook { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event WorkedCraft { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event WorkedSow { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event WorkedTend { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event WorkedHarvest { who: AgentId, what: AgentId }

// Haul legs (tick-gated instant transfers).
@replayable @gpu_amenable
event PickedCache { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event PickedHearth { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event PickedBench { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event PickedStore { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event DeliveredSiteTimber { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event DeliveredSitePlank { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event DeliveredHearthFood { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event DeliveredBenchTimber { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event DeliveredStore { who: AgentId, what: AgentId }

// Need verbs.
@replayable @gpu_amenable
event AteAt { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event Napped { who: AgentId }

// THOUGHTS — the needs.ts table's event vocabulary. S3 emits the first
// three; the rest are declared for S4-S6 to emit into the same views.
@replayable @gpu_amenable
event ThoughtAteRaw { who: AgentId }
@replayable @gpu_amenable
event ThoughtSleptRough { who: AgentId }
@replayable @gpu_amenable
event ThoughtStarving { who: AgentId }
@replayable @gpu_amenable
event ThoughtHungryRoad { who: AgentId }
@replayable @gpu_amenable
event ThoughtAshes { who: AgentId }
@replayable @gpu_amenable
event ThoughtFestival { who: AgentId }
@replayable @gpu_amenable
event ThoughtVictory { who: AgentId }
@replayable @gpu_amenable
event ThoughtDefeat { who: AgentId }
@replayable @gpu_amenable
event ThoughtGoalServed { who: AgentId }
@replayable @gpu_amenable
event ThoughtHomeServed { who: AgentId }
@replayable @gpu_amenable
event ThoughtHomeRefused { who: AgentId }

// Minds substrate (spike-preserved).
@replayable @gpu_amenable
event Brawl { aggressor: AgentId, victim: AgentId }

// S4 minds vocabulary: incidents + gossip.
// FIELD ORDER IS LOAD-BEARING (S4 engine finding): a pair fold's cell is
// ALWAYS keyed (first Agent field) * cap + (second Agent field) — the
// where-clause's observer/subject binding does not reorder it. Tended
// puts the TARGET first so the warmth row belongs to the tended one
// (standing rows are observer-major everywhere).
@replayable @gpu_amenable
event Tended { target: AgentId, actor: AgentId }
@replayable @gpu_amenable
event ProwessSeen { who: AgentId, whom: AgentId }
@replayable @gpu_amenable
event SupperTale { teller: AgentId }

// S5 raid vocabulary — APPENDED so every prior event keeps its
// sequential kind id (Brawl = 46, Tended = 47: the diag test and the
// pair-fold keying depend on declaration order).
// S5c NOTE, correcting the S5-era comment that stood here: the engine's
// alias range is NO LONGER off limits to this fixture. S5b fixed the
// allocator (`dsl_ast::engine_events::assign_event_kind_ids`) so user
// events SKIP every reserved discriminant and aliased names keep theirs
// — which is what unblocked `apply_ability` here. The two Effect*
// events this fixture now declares live at the bottom of this block.
@replayable @gpu_amenable
event RaidWarning { who: AgentId }
@replayable @gpu_amenable
event MustersNow { who: AgentId }
@replayable @gpu_amenable
event StruckRaider { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event StruckColonist { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event RaiderSlain { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event ColonistDowned { who: AgentId, what: AgentId }
@replayable @gpu_amenable
event Withdraws { who: AgentId }
@replayable @gpu_amenable
event RaiderGone { who: AgentId }
@replayable @gpu_amenable
event Plundered { who: AgentId, what: AgentId }

// S6 trade vocabulary — APPENDED (same rule as the S5 block: prior
// events keep their sequential ids).
@replayable @gpu_amenable
event SoldHide { who: AgentId, what: AgentId }

// == S5c: THE SWING — ONE DISPATCH SEAM FOR EVERY COMBATANT ===========
// Each strike verb emits its own deed record (StruckRaider /
// StruckColonist, which the tallies and the cooldown stamps ride) AND
// this: the ability the body swung, by registry slot. `DispatchSwing`
// is the single `apply_ability` site in the fixture and the only thing
// that reads `ability`.
// WHY ONE SITE AND NOT THREE (a measured decision, not taste): with an
// AoE-shaped program anywhere in the corpus the lowerer turns on Path-B
// dispatch fixture-wide, and the Path-B dispatcher body carries the
// full 46-arm chronicle chain once per supported area shape (circle /
// cone / line / box / sphere / ring) plus the nested-effect walk — a
// ~2 MB WGSL kernel PER `apply_ability` STATEMENT. Measured on this
// host with `cargo run -p sims --example webband_s8_probe`: three
// statements cost ~117 s of shader compilation per `GeneratedRuntime::
// try_new`, one costs ~68 s. Routing every combatant through one
// statement is worth an extra chronicle hop (verb -> Swing ->
// dispatcher -> Effect* -> law consumer), and that hop is a shape the
// corpus already runs — hill_raid chains ApplyDamageFromChronicle ->
// ApplyDamage the same way. The ring-order validator (S10) checks the
// ordering on every build.
@replayable @gpu_amenable
event Swing { actor: AgentId, target: AgentId, ability: u32 }

// == S5c: THE ABILITY DISPATCHER'S OWN CHRONICLE RECORDS ==============
// These two names are ENGINE-ALIASED (`dsl_ast::engine_events`:
// EffectDamageApplied = 26, EffectKnockbackApplied = 49). Declaring
// them is how a fixture SUBSCRIBES to what `apply_ability` writes: the
// dispatcher stamps those hardcoded kind ids on the records it appends,
// and since S5b the allocator hands aliased names their discriminant
// and pushes every sequential user id clear of the reserved block, so
// no user event can squat on them (`PickedBench` used to BE kind 26 —
// that collision is what locked this fixture out of the ability system
// through S5). Payload shapes are the dispatcher's, not ours:
// actor / target / f32 amount for both families (see
// `EFFECT_KIND_TO_EVENT_KIND_ID` + `emit_chronicle_arm_chain` in
// crates/dsl_compiler/src/cg/emit/wgsl_body.rs).
@replayable @gpu_amenable
event EffectDamageApplied { actor: AgentId, target: AgentId, amount: f32 }
@replayable @gpu_amenable
event EffectKnockbackApplied { actor: AgentId, target: AgentId, amount: f32 }

// ---------------------------------------------------------------------
// == ENTITIES == (declaration order fixes creature_type ordinals; must
// match config discriminants below AND the Rust test's CT_* constants)
entity Colonist  : Agent { pos: vec3, vel: vec3 }
entity Tree      : Agent { pos: vec3, vel: vec3 }
entity Bush      : Agent { pos: vec3, vel: vec3 }
entity Game      : Agent { pos: vec3, vel: vec3 }
entity Plot      : Agent { pos: vec3, vel: vec3 }
entity Store     : Agent { pos: vec3, vel: vec3 }
entity Cache     : Agent { pos: vec3, vel: vec3 }
entity Hearth    : Agent { pos: vec3, vel: vec3 }
entity Workbench : Agent { pos: vec3, vel: vec3 }
entity Bed       : Agent { pos: vec3, vel: vec3 }
entity Shed      : Agent { pos: vec3, vel: vec3 }
entity Wall      : Agent { pos: vec3, vel: vec3 }
entity MessTable : Agent { pos: vec3, vel: vec3 }  // S4 — APPENDED so 0-11 keep their ordinals
entity Raider    : Agent { pos: vec3, vel: vec3 }  // S5 — ct 13 (looter/bandit/raider ranks by hp/atk)
entity Warlord   : Agent { pos: vec3, vel: vec3 }  // S5 — ct 14 (the elite: hp 340, warlord_sweep 40)
entity Trader    : Agent { pos: vec3, vel: vec3 }  // S6 — ct 15 (the caravan camp; dormant until the host camps it)

// ---------------------------------------------------------------------
// == CUSTOM FIELDS == (S2 verdict: first-class; zero-initialized)
// Colonist-side:
field need_food:     f32   // 0..1, drains 1/day, restored by eating
field need_rest:     f32   // 0..1, dawn-resolved by bed cover
field need_comfort:  f32   // 0..1, dawn-resolved
field need_cheer:    f32   // 0..1, dawn drain + supper bonus
field mood:          f32   // needs.ts formula, recomputed per tick
field thought_sum:   f32   // blended active-thought total (mood coupling)
field starving_days: f32   // consecutive unfed dawns
field ate_meal_tick: u32   // tick of last MEAL eaten (supper gate)
field carry_kind:    u32   // 0 none, else item id (see config it_*)
field carry_n:       f32   // units carried of carry_kind
field carry_hide:    f32   // hide side-pocket (hunt's dual yield)
field claimed_job:   u32   // 0 none, else job kind (see config jk_*)
field job_site:      vec3  // claimed target's position (steering + match)
field claim_until:   u32   // lease expiry tick (both sides refresh)
field pri_chop:      f32   // per-colonist priority table: additive score
field pri_forage:    f32   // offsets (0 = default band). Seedable from
field pri_hunt:      f32   // the test via agent_pri_*_buf.
field pri_build:     f32
field pri_cook:      f32
field pri_craft:     f32
field pri_haul:      f32
field pri_grow:      f32
field standing_sum:  f32   // S4: sum of my standing toward everyone (the
                           // mood company term's blend — mirrors the
                           // standing_brawl + standing_tended row sums;
                           // physics cannot read views). NEVER read by any
                           // verb mask/score (the epistemic split).
field prowess_tick:  u32   // S4: tick of my last witnessed-worthy deed
                           // (hunt kill); neighbours who see it fresh
                           // write first-hand `repute`.
field stagger:       u32   // slot index (seeded at spawn): exclusive claim
                           // verbs fire only on world.tick % 20 == stagger
                           // % 20 -- post consumers apply same-tick events
                           // in PARALLEL with stale reads (found at S3:
                           // two same-tick claims on one tree BOTH
                           // granted), so exclusivity must be won by
                           // construction: at most one colonist may emit
                           // a claim on any given tick.
// Target-side (trees/bushes/game/plots/buildings/holders):
field claimed:       u32   // reservation flag (exclusive jobs)
field work_done:     f32   // accumulated work minutes on this target
field regrow_at:     u32   // tick at which resource is available again
field built:         u32   // buildings: 0 blueprint/raising, 1 built
field work_left:     f32   // build minutes remaining (defs.ts work)
field need_timber:   f32   // undelivered material (defs.ts cost)
field need_plank:    f32
field inv_berries:   f32   // pooled stack contents (holders + stations)
field inv_venison:   f32
field inv_grain:     f32
field inv_meal:      f32
field inv_timber:    f32
field inv_plank:     f32
field inv_hide:      f32
field sown:          u32   // plots: 0 fallow, 1 sown
field growth:        f32   // plots: days grown (grain crop, growDays 12)
field tended_at:     u32   // plots: last tend tick (once-per-day gate)
// Demand signals, recomputed per tick by DemandTick on store + bench.
// Verb masks may NOT hold folds (the fold prelude never reaches the
// mask kernel — found at S3, naga rejects `local_0`), so global demand
// is materialized onto target-local fields the masks can read.
field demand_timber: f32   // blueprint timber need + bench intake room
field demand_plank:  f32   // blueprint plank need
// -- S5 raid fields ---------------------------------------------------
// Colonist-side (downed + directives + the raid sense cache):
field downed:         u32  // KO flag: alive stays 1, all verbs masked off
field raid_on:        f32  // materialized count of raid_active==1 foes
                           // (masks cannot fold — the DemandTick idiom)
field directive_kind: u32  // 0 none / 1 guard / 2 hold / 3 focus / 4 harry
field directive_target: u32 // the STAGGER of the ward (guard) / foe (focus)
field directive_pos:  vec3 // hold anchor
field dir_target_pos: vec3 // resolved position of directive_target
field dir_live:       u32  // 1 while directive_target resolves to a live agent
field strike_cd_until: u32 // next tick this agent may strike (both sides)
// Raider-side:
field raid_active:    u32  // 0 dormant / 1 raiding / 2 withdrawing / 3 gone
field musters_at:     u32  // activation tick (0 = never; the injection seam)
field warned:         u32  // RaidWarning landed (post-stamped, the reliable pin)
field raid_total:     f32  // cohort headcount at muster (withdraw-on-losses)
field atk_cd:         u32  // strike cooldown ticks (ranks 20, warlord 60)
field ability_id:     u32  // S5c: the registry slot this body swings —
                           // THE FIELD THAT REPLACED `atk`. Damage is no
                           // longer a per-agent stat this fixture carries:
                           // it is an amount inside an .ability program, and
                           // the body only says WHICH program. Seeded per
                           // rank at spawn (looter 1 / bandit 2 / raider 3 —
                           // assets/ability_test/webband_colony/
                           // troop_strikes.ability) and dispatched as
                           // `apply_ability self.ability_id`. Colonists and
                           // warlords name their ability SYMBOLICALLY in the
                           // verb, so they need no seed. (The old `atk` f32
                           // column is GONE: nothing read it once the blow
                           // moved into the catalog, and the bridge has
                           // always identified ranks by spawn hp, not atk.)
field defenders:      f32  // materialized standing-colonist count (plunder gate)
// Holder/building-side:
field plundered_at:   u32  // tick the stores were stripped (0 = never)
field burnt:          u32  // charred outer building (defeat's scar)
// -- S6 campaign fields (the caravan seam) ----------------------------
field trader_active:  u32  // 0 dormant / 1 camped — HOST-written (the
                           // storyteller's caravan trope camps/breaks it);
                           // gates the sell verb and the Steer detour
field purse:          f32  // the trader's FINITE purse — host-seeded at
                           // arrival (60 + rngInt(0,80)); the SoldHide
                           // consumer pays hide_sell out of it per hide;
                           // the host reads the delta back as guild gold

config wb {
  // Creature-type discriminants (declaration-order ordinals).
  ct_colonist: u32 = 0,
  ct_tree:     u32 = 1,
  ct_bush:     u32 = 2,
  ct_game:     u32 = 3,
  ct_plot:     u32 = 4,
  ct_store:    u32 = 5,
  ct_cache:    u32 = 6,
  ct_hearth:   u32 = 7,
  ct_bench:    u32 = 8,
  ct_bed:      u32 = 9,
  ct_shed:     u32 = 10,
  ct_wall:     u32 = 11,
  ct_mess:     u32 = 12,

  // Job kinds (claimed_job codes). 1..12 exclusive, 13 shared.
  jk_chop:        u32 = 1,
  jk_forage:      u32 = 2,
  jk_hunt:        u32 = 3,
  jk_build:       u32 = 4,
  jk_cook:        u32 = 5,
  jk_craft:       u32 = 6,
  jk_sow:         u32 = 7,
  jk_tend:        u32 = 8,
  jk_harvest:     u32 = 9,
  jk_haul_cache:  u32 = 10,
  jk_haul_hearth: u32 = 11,
  jk_haul_bench:  u32 = 12,
  jk_eat:         u32 = 13,
  jk_haul_store:  u32 = 15,

  // Item ids (carry_kind codes).
  it_berries: u32 = 1,
  it_venison: u32 = 2,
  it_grain:   u32 = 3,
  it_meal:    u32 = 4,
  it_timber:  u32 = 5,
  it_plank:   u32 = 6,
  it_hide:    u32 = 7,

  // The day. 1 tick = 1 Webband minute (jobs.ts WORK_DAY = 600).
  day_ticks: u32 = 600,

  // Movement / interaction.
  reach:      f32 = 2.5,
  walk_speed: f32 = 0.6,
  site_match: f32 = 0.75,
  arrive:     f32 = 1.2,

  // Claim leases (ticks). Work claims refresh per work minute.
  claim_lease: u32 = 900,
  eat_lease:   u32 = 120,
  haul_lease:  u32 = 120,

  // Work totals in minutes (jobs.ts).
  work_chop:    f32 = 60.0,
  work_forage:  f32 = 80.0,
  work_hunt:    f32 = 100.0,
  work_cook:    f32 = 30.0,
  work_craft:   f32 = 20.0,
  work_sow:     f32 = 8.0,
  work_tend:    f32 = 10.0,
  work_harvest: f32 = 15.0,

  // Yields (jobs.ts) + recipe keeps (defs.ts).
  chop_yield:    f32 = 2.0,
  forage_yield:  f32 = 3.0,
  hunt_meat:     f32 = 4.0,
  hunt_hides:    f32 = 1.0,
  harvest_yield: f32 = 3.0,
  keep_meals:    f32 = 12.0,
  keep_planks:   f32 = 16.0,
  haul_cap:      f32 = 30.0,

  // Regrowth in ticks (jobs.ts days x 600).
  tree_regrow: u32 = 15000,
  bush_regrow: u32 = 3600,
  game_regrow: u32 = 4800,

  // Crop: grain, growDays 12 (defs.ts CROPS).
  grow_days: f32 = 12.0,

  // Needs rates (needs.ts, converted per-tick).
  food_drain:    f32 = 0.001667,
  rest_drain:    f32 = 0.0005,
  eat_threshold: f32 = 0.35,
  nap_threshold: f32 = 0.45,
  starve_hp:     f32 = 15.0,
  starve_floor:  f32 = 5.0,
  heal_per_day:  f32 = 25.0,

  // thought_sum blended decay: 1-day half-life per tick.
  thought_decay: f32 = 0.998845,

  // Spoil keep-fractions per dawn: 1 - 1/spoilDays (defs.ts spoilDays).
  spoil_keep_berries: f32 = 0.8,
  spoil_keep_meat:    f32 = 0.6667,
  spoil_keep_grain:   f32 = 0.975,

  // Priority bands (argmax utility). Distance subtracts inside a band;
  // pri_* fields add at pri_scale per point.
  pri_scale:          f32 = 200.0,
  band_work:          f32 = 6500.0,
  band_deliver_site:  f32 = 6300.0,
  band_deliver_stn:   f32 = 6250.0,
  band_pickup:        f32 = 6200.0,
  band_deliver_store: f32 = 6100.0,
  band_eat:           f32 = 6000.0,
  band_nap:           f32 = 5500.0,
  band_haul:          f32 = 4000.0,
  band_cook:          f32 = 3800.0,
  band_build:         f32 = 3600.0,
  band_craft:         f32 = 3400.0,
  band_chop:          f32 = 3200.0,
  band_forage:        f32 = 3000.0,
  band_hunt:          f32 = 2800.0,
  band_harvest:       f32 = 2700.0,
  band_sow:           f32 = 2600.0,
  band_tend:          f32 = 2500.0,

  // Station intake caps (deliver gates).
  hearth_food_cap: f32 = 8.0,
  bench_timber_cap: f32 = 24.0,

  // Brawls (spike-preserved): jostle every 20th tick until 5800 so the
  // last 200 ticks of a 6000-tick run are a pure-decay window.
  brawl_every:     u32 = 20,
  brawl_stop_tick: u32 = 5800,
  // THE QUARREL CIRCLE (2026-07-22 perf fix — see the Jostle rule): a
  // colonist only brawls with hall-mates whose spawn SLOT is within this
  // many places of their own, so a storm tick emits at most
  // 2*brawl_span rows per colonist however dense the ground gets.
  // 3 keeps the working colony quarrelsome (the 10-day pin wants brawls
  // in the hundreds) while cutting the pop-500 storm burst ~24x.
  brawl_span:      u32 = 19,

  // S4 minds (witness.ts foldIncident magnitudes + tuning.ts converted).
  sour_brawl:     f32 = 2100.0,    // SOUR_VICTIM 3500 * 0.6 (witness.ts:225)
  warm_tended:    f32 = 4000.0,    // WARM_SAVED (witness.ts:236)
  standing_decay: f32 = 0.9999697, // STANDING_RETAIN_BASE 0.982^(1/600)/tick
                                   // — MUST equal the @decay literal on the
                                   // standing_* beliefs below
  company_denom:  f32 = 622592.0,  // 32768 * (20 - 1): needs.ts company =
                                   // 8 * (sum standing/32768) / (roster-1)
  tend_hp_sick:   f32 = 20.0,      // sickbed gate (a tend lifts them out)
  tend_hp_well:   f32 = 80.0,      // only the hale tend
  tend_heal:      f32 = 10.0,      // the tend's own mending
  supper_phase:   u32 = 580,       // evening supper: %600==580 (never the
                                   // dawn tick, never the brawl storm)

  // S5 raids (raids.ts + the S5-prep catalog conversion + engine.ts
  // decide() radii; hex radii ported at ~2 m/hex).
  ct_raider:      u32 = 13,
  ct_warlord:     u32 = 14,
  strike_dmg:     f32 = 46.0,      // power_strike amount (catalog.ts:24-27)
  strike_cd:      u32 = 60,        // 3 rounds -> 60 ticks (S5-prep: 1 round = 2 s)
  strike_range:   f32 = 2.6,       // power_strike range, meters verbatim
  raider_range:   f32 = 2.8,       // cleaving_blow's reach (the rank's arm)
  warlord_range:  f32 = 3.5,       // warlord_sweep range
  raider_speed:   f32 = 0.6,       // rim walk, matches colonist walk_speed
  engage_r:       f32 = 4.0,       // a standing colonist this close pulls the raider in
  raid_timeout:   u32 = 4800,      // task-scaled ROUND_CAP bound (losses/plunder end raids long before)
  flee_r:         f32 = 36.0,      // withdrawn raiders vanish past this radius
  wall_r:         f32 = 3.5,       // built-wall repulsion reach
  wall_w:         f32 = 9.0,       // repulsion weight (steering flows around, never through)
  plunder_take:   f32 = 26.0,      // 10 + tier*8 at tier 2 (raids.ts:184; exact math is S7b host-side)
  burn_r:         f32 = 9.0,       // built buildings beyond this radius char on a plunder
  band_strike:    f32 = 6600.0,    // above band_work: a foe in reach outranks the tree
  guard_r:        f32 = 6.0,       // GUARD_R = 3 hexes (engine.ts)
  hold_r:         f32 = 4.0,       // HOLD_R = 2 hexes (engine.ts)
  focus_bonus:    f32 = 300.0,     // dominates every distance term on the board
  harry_hp_w:     f32 = 1.0,       // harry: score -hp (lowest-hp preference)
  recover_hp:     f32 = 20.0,      // dawn un-downs at this hp (two tends from the floor)
  downed_food:    f32 = 0.6,       // the downed are spoon-fed (no starve arm)

  // S5c — the warlord's EXCLUSIVE strike residues. The sweep is a real
  // circle AoE, so one cast writes MANY colonist hp cells; the 40-tick
  // target-parity gate that keeps rank strikes single-writer per
  // (tick, target) cannot cover it (the circle sprays BOTH parities).
  // The four warlord bodies sit on the pool's last slots (114-117 as
  // the founding lays out today), i.e. stagger % 40 = 34..37, so those
  // four residues are handed to the warlords alone and the ranks stand
  // down on them. The rank staggers cover 38, 39 and 0..33, so nothing
  // is taken from anyone's FIRST window; the four ranks whose
  // (stagger + 20) % 40 lands in 34..37 lose their SECOND. MEASURED,
  // NOT ASSUMED: `warlord_sweep_is_a_real_circle_aoe` reads the live
  // staggers back and asserts both halves of the exclusivity.
  warlord_phase_lo: u32 = 34,
  warlord_phase_hi: u32 = 37,

  // S5c — REGISTRY SLOTS for the two abilities no per-agent field
  // carries. `build_registry` assigns 1-based ids in input order:
  // the corpus directory sorted by filename, then each file's decls in
  // declaration order. troop_strikes.ability holds 1/2/3 (looter /
  // bandit / raider — seeded per body as `ability_id`), and
  // webband_catalog.ability follows: PowerStrike 4, CripplingShot 5,
  // FieldDressing 6, ShieldWall 7, Whirlwind 8, CleavingBlow 9,
  // Lunge 10, SecondWind 11, WarlordSweep 12, BallistaBolt 13.
  // Numbers rather than the `apply_ability <Name>` symbolic surface
  // because the single dispatcher takes its slot from the Swing
  // payload — so `ability_registry_slots_are_pinned` in
  // crates/sims/tests/webband_colony.rs BUILDS THE REAL REGISTRY from
  // the corpus and asserts these two constants name-by-name. A rename,
  // a reorder or a new file fails that test instead of silently
  // dispatching the wrong program.
  ab_power_strike:  u32 = 4,
  ab_warlord_sweep: u32 = 12,

  // S6 trade (trade.ts:20-31 — the caravan's sell spread).
  ct_trader:      u32 = 15,
  hide_sell:      f32 = 2.0,       // floor(hide value 4 * SELL_MULT 0.6)
}

// ---------------------------------------------------------------------
// == FOUNDING == (the Webband teaching set: a resource cache as stray
// stock + hearth & workbench blueprints; bed/shed/wall plans give the
// plank chain somewhere to land. Slot 0 is the AgentId sentinel; spawns
// fill 1..=73 in declaration order.)
// SPACING IS STRUCTURAL: ring() rolls a random angle per (seed, slot),
// so two same-kind targets on ONE ring can land arbitrarily close (a
// 24-seed scan found min gaps of 0.001-0.76u — no seed passes). Every
// claimable target therefore gets its OWN ring radius, radii >= 1.0
// apart WITHIN a kind: worst-case same-kind spacing equals the radius
// gap regardless of angle, which keeps job_site -> target resolution
// unambiguous (site_match 0.75) for every seed. Cross-kind overlap is
// harmless (work masks are kind-exact).
init {
  spawn Colonist count 500 { hp: 100.0, stagger: slot, need_food: 1.0, need_rest: 1.0, need_comfort: 0.5, need_cheer: 0.5, mood: 60.0, pos: scatter(10.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(13.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(14.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(15.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(16.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(17.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(18.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(19.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(20.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(21.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(22.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(23.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(24.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(25.0) }
  spawn Tree count 1 { hp: 1.0, pos: ring(26.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(9.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(10.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(11.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(12.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(13.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(14.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(15.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(16.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(17.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(18.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(19.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(20.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(21.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(22.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(23.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(24.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(25.0) }
  spawn Bush count 1 { hp: 1.0, pos: ring(26.0) }
  spawn Game count 1 { hp: 1.0, pos: ring(16.5) }
  spawn Game count 1 { hp: 1.0, pos: ring(17.5) }
  spawn Game count 1 { hp: 1.0, pos: ring(18.5) }
  spawn Game count 1 { hp: 1.0, pos: ring(19.5) }
  spawn Game count 1 { hp: 1.0, pos: ring(20.5) }
  spawn Game count 1 { hp: 1.0, pos: ring(21.5) }
  spawn Game count 1 { hp: 1.0, pos: ring(22.5) }
  spawn Game count 1 { hp: 1.0, pos: ring(23.5) }
  spawn Game count 1 { hp: 1.0, pos: ring(24.5) }
  spawn Game count 1 { hp: 1.0, pos: ring(25.5) }
  spawn Plot count 1 { hp: 1.0, pos: ring(6.0) }
  spawn Plot count 1 { hp: 1.0, pos: ring(7.0) }
  spawn Plot count 1 { hp: 1.0, pos: ring(8.0) }
  spawn Store count 1 { hp: 1.0, pos: origin }
  spawn Cache count 1 { hp: 1.0, inv_meal: 60.0, inv_berries: 30.0, inv_timber: 16.0, pos: ring(2.5) }
  spawn Hearth count 1 { hp: 1.0, need_timber: 4.0, work_left: 40.0, pos: ring(4.0) }
  spawn Workbench count 1 { hp: 1.0, need_timber: 6.0, work_left: 60.0, pos: ring(5.5) }
  spawn Bed count 1 { hp: 1.0, need_plank: 2.0, work_left: 40.0, pos: ring(7.5) }
  spawn Shed count 1 { hp: 1.0, need_plank: 9.0, work_left: 120.0, pos: ring(9.5) }
  spawn Wall count 1 { hp: 1.0, need_timber: 1.0, work_left: 15.0, pos: ring(11.5) }
  // S4 — the mess table blueprint (defs.ts: plank 6, work 90), APPENDED so
  // slots 1..=73 keep their (seed, slot) ring angles. Ring 12.5 keeps the
  // >= 1.0 gap within the buildings claim group (wall 11.5); the 0.5 gap to
  // the bush/tree rings is cross-kind (masks are kind-exact) and cannot
  // coincide (different radii).
  spawn MessTable count 1 { hp: 1.0, need_plank: 6.0, work_left: 90.0, pos: ring(12.5) }
  // S5 — the palisade posts (PRE-BUILT walls, slots 75-78): inert to the
  // economy (no claim mask targets a built wall; DemandTick counts only
  // blueprints) but real to raider steering. Radii 14.2-17.8 keep the
  // >= 1.0 within-kind gap the spacing law asks of the buildings group;
  // raid tests reposition them into a line (buffer writes — the
  // injection seam), which is why their founding angles don't matter.
  spawn Wall count 1 { hp: 1.0, built: 1, pos: ring(14.2) }
  spawn Wall count 1 { hp: 1.0, built: 1, pos: ring(15.4) }
  spawn Wall count 1 { hp: 1.0, built: 1, pos: ring(16.6) }
  spawn Wall count 1 { hp: 1.0, built: 1, pos: ring(17.8) }
  // S5/S6b — the dormant raid pool (slots 79-118: 12 looters, 12
  // bandits, 12 raiders, 4 warlords — three TROOPS ranks + the elite),
  // parked at the rim, musters_at 0 = never. Slots 79..118 are
  // 40 CONSECUTIVE values, so stagger%40 covers all 40 residues exactly
  // once — with the 40-tick target-parity strike gate that gives every
  // body a private (tick, target) window (the determinism law) at the
  // ported once-per-20-tick cadence. atk/atk_cd are the TROOPS rows
  // (data.ts:26-46); the warlord's 40 is warlord_sweep's amount at its
  // 60-tick cooldown.
  // WHY 40 AND NOT 20 (S6b): the escalation clock (raidBudget = 2 +
  // colonists*2 + wealth*0.005 + day*0.25) outgrew a 20-body pool inside
  // the pinned 60-day soak — a day-56 comp wanted 21 bodies and the
  // bridge silently dropped one. 40 is 2x the measured peak; the bridge
  // now PANICS rather than truncating, so the cap can never go quiet
  // again.
  // THE POOL GREW BY COUNT, NOT BY NEW SPAWN STATEMENTS, AND THAT IS
  // LOAD-BEARING (S6b engine finding — a whole debug cycle): adding four
  // FURTHER `spawn Raider/Warlord` statements silently killed S4's
  // supper gossip. Spawn statements are ops, so a new one renumbers the
  // op graph, and topological_sort_best_effort's cycle-stall pick then
  // forces BeliefSocialMerge ahead of PhysicsSupperGather again — the
  // exact S5 finding-1 failure its narrow fix was meant to end (the fix
  // holds for the case it was cut for, not for OpId churn in general).
  // Bumping `count` on the EXISTING four statements leaves the op graph
  // identical and gossip green — proven both ways by running
  // supper_gossip_moves_repute_never_standing against each shape. Any
  // future pool growth must do the same, or re-verify gossip.
  // S5c: `ability_id` is the registry slot each rank swings —
  // 1 WebbandLooterStrike (11) / 2 WebbandBanditStrike (17) /
  // 3 WebbandRaiderStrike (24), the TROOPS rows carried as DATA in
  // assets/ability_test/webband_colony/troop_strikes.ability. The
  // warlord names WebbandWarlordSweep symbolically in its own verb.
  spawn Raider count 12 { hp: 42.0, atk_cd: 20, ability_id: 1, stagger: slot, pos: ring(37.0) }
  spawn Raider count 12 { hp: 72.0, atk_cd: 20, ability_id: 2, stagger: slot, pos: ring(38.0) }
  spawn Raider count 12 { hp: 105.0, atk_cd: 20, ability_id: 3, stagger: slot, pos: ring(39.0) }
  spawn Warlord count 4 { hp: 340.0, atk_cd: 60, stagger: slot, pos: ring(39.5) }
  // S6 — the campaign's drop points, APPENDED (slots 119-120; all prior
  // (seed, slot) ring angles preserved). The RIM CACHE is the windfall/
  // caravan-purchase landing ground: the storyteller's bundles are
  // host-written onto it and the ordinary ClaimHaulCache/PickupCache
  // economy hauls them in (even good luck makes haul work — the Webband
  // rule). Ring 28.0 keeps the >= 1.0 within-kind gap to the yard cache
  // (2.5). The TRADER is the caravan camp: dormant (trader_active 0,
  // purse 0) until the host camps it; ring 30.0 sits outside every
  // economy ring and inside the raid parking (37+).
  spawn Cache count 1 { hp: 1.0, pos: ring(28.0) }
  spawn Trader count 1 { hp: 1.0, pos: ring(30.0) }
}

// Spatial neighbourhood for the jostle/brawl rule only.
@spatial(radius = 2.0, kind = [Agent])
spatial_query nearby_jostle(self: AgentId, candidate: AgentId) =
  candidate != self

// ---------------------------------------------------------------------
// == JOBS: CLAIM VERBS == (walk intents; the consumer grants)
// Score shape: band + pri * scale - distance, sentinel-armed (-1e9) off
// wrong-kind/unavailable candidates (wave_defense pattern).

verb ClaimChop(self, target: Agent) =
  action ClaimChopAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_tree
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
        && ((world.tick % 20) == (self.stagger % 20u))
        && target.claimed == 0u
        && target.regrow_at <= world.tick)
  emit ClaimedChop { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_tree) && (target.claimed == 0u) && (target.regrow_at <= world.tick)) {
    config.wb.band_chop + self.pri_chop * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

verb ClaimForage(self, target: Agent) =
  action ClaimForageAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_bush
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
        && ((world.tick % 20) == ((self.stagger + 1u) % 20u))
        && target.claimed == 0u
        && target.regrow_at <= world.tick)
  emit ClaimedForage { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_bush) && (target.claimed == 0u) && (target.regrow_at <= world.tick)) {
    config.wb.band_forage + self.pri_forage * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

verb ClaimHunt(self, target: Agent) =
  action ClaimHuntAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_game
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
        && ((world.tick % 20) == ((self.stagger + 2u) % 20u))
        && target.claimed == 0u
        && target.regrow_at <= world.tick)
  emit ClaimedHunt { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_game) && (target.claimed == 0u) && (target.regrow_at <= world.tick)) {
    config.wb.band_hunt + self.pri_hunt * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// Build: any blueprint whose materials are fully delivered. work_left > 0
// only ever holds on building agents, so no creature_type test is needed.
verb ClaimBuild(self, target: Agent) =
  action ClaimBuildAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
        && ((world.tick % 20) == ((self.stagger + 3u) % 20u))
        && target.claimed == 0u
        && target.built == 0u
        && target.work_left > 0.5
        && target.need_timber < 0.5
        && target.need_plank < 0.5)
  emit ClaimedBuild { who: self, what: target }
  score (if ((target.claimed == 0u) && (target.built == 0u) && (target.work_left > 0.5) && (target.need_timber < 0.5) && (target.need_plank < 0.5)) {
    config.wb.band_build + self.pri_build * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// Cook at a built hearth: ingredients present + meal keep (defs.ts 12).
verb ClaimCook(self, target: Agent) =
  action ClaimCookAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_hearth
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
        && ((world.tick % 20) == ((self.stagger + 4u) % 20u))
        && target.claimed == 0u
        && target.built == 1u
        && target.inv_meal < config.wb.keep_meals
        && (target.inv_venison >= 2.0 || target.inv_berries >= 4.0 || target.inv_grain >= 3.0))
  emit ClaimedCook { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_hearth) && (target.claimed == 0u) && (target.built == 1u) && (target.inv_meal < config.wb.keep_meals) && ((target.inv_venison >= 2.0) || (target.inv_berries >= 4.0) || (target.inv_grain >= 3.0))) {
    config.wb.band_cook + self.pri_cook * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// Saw planks at a built workbench: timber present + plank keep (16).
verb ClaimCraft(self, target: Agent) =
  action ClaimCraftAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_bench
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
        && ((world.tick % 20) == ((self.stagger + 5u) % 20u))
        && target.claimed == 0u
        && target.built == 1u
        && target.inv_timber >= 1.0
        && target.inv_plank < config.wb.keep_planks)
  emit ClaimedCraft { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_bench) && (target.claimed == 0u) && (target.built == 1u) && (target.inv_timber >= 1.0) && (target.inv_plank < config.wb.keep_planks)) {
    config.wb.band_craft + self.pri_craft * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

verb ClaimSow(self, target: Agent) =
  action ClaimSowAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_plot
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
