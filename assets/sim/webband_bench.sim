verb DeliverStorePlank(self, target: Agent) =
  action DeliverStorePlankAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_store
        && self.carry_kind == config.wb.it_plank
        && self.carry_n >= 1.0
        && distance(self.pos, target.pos) < config.wb.reach
        && self.downed == 0u
        && ((world.tick % 20) == ((self.stagger + 19u) % 20u))
        && target.demand_plank < 0.5)
  emit DeliveredStore { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_store)) {
    config.wb.band_deliver_store - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// S6 — the caravan sell (trade.ts SELL_MULT 0.6 on the hide's value 4):
// a hide-carrying colonist at the CAMPED trader's fire sells ONE hide
// per phase window while the purse still pays (the finite-purse law —
// the consumer is the only purse writer between the host's dawn writes).
// Phase 18 is shared with the two station delivers, which is SAFE by the
// overlapping-masks law: their write sets are disjoint (they touch
// carry_kind/carry_n + station inv; this touches carry_hide + trader
// cells), reach gates make them spatially exclusive anyway, and only one
// colonist holds phase 18 on any tick — one writer of the purse per tick.
verb DeliverTraderHide(self, target: Agent) =
  action DeliverTraderHideAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_trader
        && target.trader_active == 1u
        && target.purse >= config.wb.hide_sell
        && self.carry_hide >= 1.0
        && distance(self.pos, target.pos) < config.wb.reach
        && self.downed == 0u
        && ((world.tick % 20) == ((self.stagger + 18u) % 20u)))
  emit SoldHide { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_trader) && (target.trader_active == 1u) && (target.purse >= config.wb.hide_sell)) {
    config.wb.band_deliver_stn - distance(self.pos, target.pos)
  } else { -1000000000.0 })

