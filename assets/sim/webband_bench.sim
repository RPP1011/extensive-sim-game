  emit ClaimedHaulHearth { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_hearth) && (target.claimed == 0u) && (target.built == 1u) && (target.inv_meal >= 2.0)) {
    config.wb.band_haul + self.pri_haul * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// Fetch sawn planks — only while some blueprint still wants planks
// (a fold gate; without it a plank carrier could strand jobless).
verb ClaimHaulBench(self, target: Agent) =
  action ClaimHaulBenchAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_bench
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
        && ((world.tick % 20) == ((self.stagger + 11u) % 20u))
        && target.claimed == 0u
        && target.built == 1u
        && target.inv_plank >= 1.0
        && target.demand_plank > 0.5)
  emit ClaimedHaulBench { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_bench) && (target.claimed == 0u) && (target.built == 1u) && (target.inv_plank >= 1.0)) {
    config.wb.band_haul + self.pri_haul * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// Restock the saw from the store: timber stranded at the store while a
// demand stands (found at S3: everything chopped during the bench's own
// raising window parks at the store — the deliver gate reads `built` —
// and with the trees felled the bench starves without this flow).
verb ClaimHaulStore(self, target: Agent) =
  action ClaimHaulStoreAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_store
        && self.claimed_job == 0u
        && self.downed == 0u && self.raid_on < 0.5
        && self.carry_n < 0.5 && self.carry_hide < 0.5
        && ((world.tick % 20) == ((self.stagger + 12u) % 20u))
        && target.claimed == 0u
        && target.inv_timber >= 1.0
        && target.demand_timber > 0.5)
  emit ClaimedHaulStore { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_store) && (target.claimed == 0u) && (target.inv_timber >= 1.0) && (target.demand_timber > 0.5)) {
    config.wb.band_haul + self.pri_haul * config.wb.pri_scale - distance(self.pos, target.pos)
  } else { -1000000000.0 })

// Eat intents — shared (never exclusive), one per food holder type.
verb ClaimEatStore(self, target: Agent) =
  action ClaimEatStoreAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_store
        && self.claimed_job == 0u
        && ((world.tick % 20) == ((self.stagger + 13u) % 20u))
        && self.downed == 0u && self.raid_on < 0.5
        && self.need_food < config.wb.eat_threshold
        && (target.inv_meal >= 1.0 || target.inv_berries >= 2.0 || target.inv_venison >= 2.0 || target.inv_grain >= 4.0))
  emit ClaimedEat { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_store) && ((target.inv_meal >= 1.0) || (target.inv_berries >= 2.0) || (target.inv_venison >= 2.0) || (target.inv_grain >= 4.0))) {
    config.wb.band_eat - distance(self.pos, target.pos)
  } else { -1000000000.0 })

verb ClaimEatHearth(self, target: Agent) =
  action ClaimEatHearthAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_hearth
        && self.claimed_job == 0u
        && ((world.tick % 20) == ((self.stagger + 14u) % 20u))
        && self.downed == 0u && self.raid_on < 0.5
        && self.need_food < config.wb.eat_threshold
        && target.built == 1u
        && (target.inv_meal >= 1.0 || target.inv_berries >= 2.0 || target.inv_venison >= 2.0 || target.inv_grain >= 4.0))
  emit ClaimedEat { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_hearth) && (target.built == 1u) && ((target.inv_meal >= 1.0) || (target.inv_berries >= 2.0) || (target.inv_venison >= 2.0) || (target.inv_grain >= 4.0))) {
    config.wb.band_eat - distance(self.pos, target.pos)
  } else { -1000000000.0 })

