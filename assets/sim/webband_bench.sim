// ---------------------------------------------------------------------
// == JOBS: WORK VERBS == (at the claimed face; 1 work-minute per tick;
// the job_site position match makes the reservation target-exact)
// EVERY TARGETED VERB'S SCORE MUST READ THE TARGET (here: - distance):
// a constant score lowers as a SELF-ROW and the argmax never binds the
// winning candidate — ActionSelected then carries target 0xFFFFFFFF and
// every consumer write lands out-of-bounds (silently dropped). Found at
// S3 by ring dump; the claims only worked because their scores already
// subtracted distance.

verb WorkChop(self, target: Agent) =
  action WorkChopAction
  when (self.alive && target.alive
        && self.creature_type == config.wb.ct_colonist
        && target.creature_type == config.wb.ct_tree
        && self.downed == 0u
        && self.claimed_job == config.wb.jk_chop
        && target.claimed == 1u
        && distance(target.pos, self.job_site) < config.wb.site_match
        && distance(self.pos, target.pos) < config.wb.reach)
  emit WorkedChop { who: self, what: target }
  score (if ((target.creature_type == config.wb.ct_tree) && (target.claimed == 1u)) {
    config.wb.band_work - distance(self.pos, target.pos)
  } else { -1000000000.0 })

