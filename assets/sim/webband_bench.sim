// Colony palette for the generic play binary.
render {
  arena_radius 40.0
  camera observer
  agent when creature_type is Colonist { color (240, 220, 160) }
  agent when creature_type is Tree { color (40, 120, 60) }
  agent when creature_type is Bush { color (80, 190, 90) }
  agent when creature_type is Game { color (170, 120, 80) }
  agent when creature_type is Plot { color (120, 90, 50) }
  agent when creature_type is Store { color (210, 160, 40) }
  agent when creature_type is Cache { color (200, 200, 90) }
  agent when creature_type is Hearth { color (220, 90, 50) }
  agent when creature_type is Workbench { color (150, 150, 220) }
  agent when creature_type is Bed { color (220, 220, 240) }
  agent when creature_type is Shed { color (160, 130, 90) }
  agent when creature_type is Wall { color (120, 120, 120) }
  agent when creature_type is MessTable { color (200, 170, 110) }
  agent when creature_type is Raider { color (170, 40, 40) }
  agent when creature_type is Warlord { color (120, 20, 60) }
  agent when creature_type is Trader { color (230, 200, 60) }
}
