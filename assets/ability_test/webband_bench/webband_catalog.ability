// Webband ability catalog — the 10-spec representative subset ported from
// F:\MB\src\battle\abilities\catalog.ts (Webband port, slice S5-prep).
//
// THIS IS THE PER-FIXTURE RUNTIME CORPUS (slice S5c): `webband_colony`'s
// generated runtime parses every `.ability` in this directory at
// `try_new` and `crates/sims/build.rs` builds the same registry at build
// time, which is what makes `apply_ability <Name>` resolvable from the
// `.sim`. The file is a verbatim copy of
// `dataset/abilities/webband/webband_catalog.ability` (the port's
// REFERENCE catalog, which no crate loads) apart from this note — keep
// the two in step.
//
// BOUND IN THE FIXTURE (see the S5c section of assets/sim/webband_colony.sim):
//   * WebbandPowerStrike  — every colonist's arm (46 / cd 60t / range 2.6)
//   * WebbandWarlordSweep — the elite's sweep, AS A REAL CIRCLE AoE
//     (40 in circle(3.5) + knockback 2 in circle(3.5), cd 60t)
// The other eight are declared, validated and registry-resident but
// unbound: the fixture has no ranged/healer/shield kit to hang them on
// yet, and binding an ability nobody casts would be decoration. They are
// kept here because the catalog is DATA — adding a kit is a one-line
// dispatch change, not new code.
//
// Conversion declared for this port: 1 Webband ROUND = 2 SECONDS.
// Webband cooldowns/durations are rounds (turn-based, ROUND_CAP = 40);
// this engine is real-time (10 Hz ticks; cooldown_ticks = ceil(ms/100)).
// Ranges and area radii stay in meters, verbatim (Webband kept them
// metric between hex centers on purpose — catalog.ts was never
// re-quantized to hexes).
//
// Names are prefixed `Webband` to avoid registry collisions with the
// existing corpus (ShieldWall/Whirlwind/Lunge/SecondWind already exist
// in dataset/abilities). README.md in this directory maps each ability
// back to its Webband spec id and documents every mapping decision and
// gap. Original numbers are cited per ability below.

// ---------------------------------------------------------------------
// power_strike (catalog.ts:24-27) — the basic melee nuke.
// Original: target enemy, range 2.6, cooldown 3r -> 6s, damage 46.
ability WebbandPowerStrike {
    target: enemy, range: 2.6
    cooldown: 6s
    hint: damage

    damage 46
}

// ---------------------------------------------------------------------
// crippling_shot (catalog.ts:50-53) — the projectile.
// Original: target enemy, range 10, cooldown 2r -> 4s, delivery projectile,
// damage 28 + slow x0.5 for 2r -> 4s when on_hit.
// Webband's `when: 'on_hit'` maps onto the deliver on_hit hook — same
// intent (the rider lands only if the shot connects). speed/width are
// engine-side delivery params with no Webband IR counterpart (Webband
// projectile speed was visual-only, ir.ts:41); 12 m/s per the corpus
// convention (tier6 PiercingArrow).
ability WebbandCripplingShot {
    target: enemy, range: 10.0
    cooldown: 4s
    hint: damage

    deliver projectile { speed: 12.0, width: 0.3 } {
        on_hit {
            damage 28
            slow 0.5 for 4s
        }
    }
}

// ---------------------------------------------------------------------
// field_dressing (catalog.ts:54-57) — the heal; the founders' healer marker.
// Original: target ally, range 6, cooldown 2r -> 4s, heal 40.
ability WebbandFieldDressing {
    target: ally, range: 6.0
    cooldown: 4s
    hint: heal

    heal 40
}

// ---------------------------------------------------------------------
// shield_wall (catalog.ts:62-65) — the shield.
// Original: target self, cooldown 4r -> 8s, shield 35 for 4r -> 8s.
// `shield N for dur` lowers to TimedShield (variant 22) — Webband
// shields expire after their dur, so the timed variant is the faithful
// one (bare Shield, variant 2, never decays).
ability WebbandShieldWall {
    target: self
    cooldown: 8s
    hint: defense

    shield 35 for 8s
}

// ---------------------------------------------------------------------
// whirlwind (catalog.ts:32-35) — the circle AoE.
// Original: target enemy, range 3.2, cooldown 4r -> 8s, area circle 3.2,
// damage 30 + knockback 2 when on_hit.
// Webband gated the knockback on the strike not being fully blocked
// (h.dmg > 0 after the block roll, engine.ts:1102); this engine has no
// block roll on Damage, so the gate is vacuously true -> unconditional.
ability WebbandWhirlwind {
    target: enemy, range: 3.2
    cooldown: 8s
    hint: damage

    damage 30 in circle(3.2)
    knockback 2.0 in circle(3.2)
}

// ---------------------------------------------------------------------
// cleaving_blow (catalog.ts:40-43) — the cone.
// Original: target enemy, range 2.8, cooldown 3r -> 6s, area cone
// areaR 2.8 areaDeg 100 (full opening), damage 38.
// ARG ORDER: the engine's shipped cone apply reads args[0] as the
// HALF-angle in degrees and args[1] as the range (apply.rs:955-958 +
// the in-crate cone test), despite spec §9.1's `cone(radius, angle)`
// surface. Authored to the apply convention: half-angle 50 = Webband's
// 100° full opening (Webband also halves: cosHalf, engine.ts:1041).
ability WebbandCleavingBlow {
    target: enemy, range: 2.8
    cooldown: 6s
    hint: damage

    damage 38 in cone(50.0, 2.8)
}

// ---------------------------------------------------------------------
// lunge (catalog.ts:28-31) — the dash.
// Original: target enemy, range 7, cooldown 3r -> 6s, dash 7 + damage 34.
// Webband resolves the dash pre-strike (the caster closes the gap, then
// hits — engine.ts:1096); effect order preserved. `dash 7.0` keeps the
// original magnitude (= the cast range, so the caster always arrives);
// `dash to_target` (INFINITY sentinel) would be the intent-first
// alternative.
ability WebbandLunge {
    target: enemy, range: 7.0
    cooldown: 6s
    hint: damage

    dash 7.0
    damage 34
}

// ---------------------------------------------------------------------
// second_wind (catalog.ts:36-39) — the conditional self-heal.
// Original: target self, cooldown 6r -> 12s, heal 45 when caster_hp_below
// + shield 25 for 3r -> 6s.
// Webband's caster_hp_below trigger is FRACTIONAL: hp < 0.5 * maxHp
// (SELF_CAST_HP_FRAC = 0.5, engine.ts:94). This engine's when-vocab is
// `<binder>.<field> <op> <literal>` with absolute literals only (no
// hp_pct field, no field-vs-field) — approximated as hp < 50, i.e.
// 50% of the ~100-hp Webband companion frame. See README gap list.
ability WebbandSecondWind {
    target: self
    cooldown: 12s
    hint: defense

    heal 45 when self.hp < 50
    shield 25 for 6s
}

// ---------------------------------------------------------------------
// warlord_sweep (catalog.ts:90-93) — the warlord kit signature.
// Original: target enemy, range 3.5, cooldown 3r -> 6s, area circle 3.5,
// damage 40 + knockback 2 when on_hit (vacuous here — see whirlwind).
ability WebbandWarlordSweep {
    target: enemy, range: 3.5
    cooldown: 6s
    hint: damage

    damage 40 in circle(3.5)
    knockback 2.0 in circle(3.5)
}

// ---------------------------------------------------------------------
// ballista_bolt (catalog.ts:82-85) — the line; the engineer grant.
// Original: target enemy, range 11, cooldown 3r -> 6s, area line 11,
// delivery projectile, damage 32.
// Ported INSTANT with the line shape rather than as a deliver block:
// Webband's projectile delivery is visual-only (effects land the same
// turn), while the line AoE is load-bearing (everyone in the lane is
// hit) — and hook-stmt `in <shape>` modifiers are silently dropped by
// the lowerer today (program.rs Delivery::Method doc), so a projectile
// port would LOSE the line. Width 1.8 = Webband's fixed line half-width
// 0.9 doubled (engine.ts:1056; engine line args[1] is full width).
ability WebbandBallistaBolt {
    target: enemy, range: 11.0
    cooldown: 6s
    hint: damage

    damage 32 in line(11.0, 1.8)
}
