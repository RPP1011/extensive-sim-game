// mass_battle_100v100's StunBolt — single-target Stun(20 ticks = 2s @
// 100ms tick), the first non-Damage EffectOp in this fixture. Proves
// the apply_ability dispatcher emits kind=29 EffectStunApplied
// chronicle records at production scale (200 agents × pair-field
// scoring).
//
// Lowers to AbilityProgram { gate: { cooldown_ticks: 0, hostile_only: true },
//                            area: SingleTarget { range: 999.0 },
//                            effects: [EffectOp::Stun { duration_ticks: 20 }] }.

ability StunBolt {
    target: enemy
    range: 999
    cooldown: 0

    stun 2s
}
