#!/usr/bin/env bash
# .githooks/pre-commit
# (1) cargo check — quick build sanity. Each runtime crate's build.rs
#     compiles its `assets/sim/*.sim` source, so DSL parse / lower /
#     emit errors surface here too — no separate `compile-dsl --check`
#     pass needed (the standalone xtask was retired in the Phase 7
#     wolf-sim wipe; runtimes self-compile via build.rs into OUT_DIR).
# (2) // GENERATED header rule — files in engine_rules/ engine_data/
#     engine_gpu_rules/ must carry the marker; files elsewhere must
#     not. Per Spec B' §7.
#
# DISABLED 2026-04-29: critic-verdict gate. The dispatch-critics
# system was producing more drag than signal across many sessions
# (compile-clean ≠ runtime-clean was a real failure mode the critics
# happily PASS'd through). Re-enable by restoring the block from git
# history (commit before the disable).

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] Running cargo check..."
cargo check

# === Spec B' §7 header rule: files staged in engine_rules/, engine_data/, or
# engine_gpu_rules/ require // GENERATED.
for f in $(git diff --cached --name-only --diff-filter=AM \
           | grep -E '^crates/(engine_rules|engine_data|engine_gpu_rules)/src/.*\.rs$' \
           | grep -v '/lib\.rs$'); do
    # Allowlist: engine_data has 3 hand-written exceptions per Task 16's build.rs sentinel.
    case "$f" in
        crates/engine_data/src/ids.rs|crates/engine_data/src/types.rs|crates/engine_data/src/id_serde.rs)
            continue
            ;;
    esac
    if ! head -5 "$f" | grep -q "// GENERATED by dsl_compiler"; then
        echo "ABORT: $f is in a generated crate but lacks the // GENERATED header." >&2
        echo "Edit the DSL source under assets/sim/ and rebuild (\`cargo check\` / \`cargo build\`)." >&2
        exit 1
    fi
done

# === Spec B' §7 inverse rule: files staged outside generated crates must NOT carry the marker.
for f in $(git diff --cached --name-only --diff-filter=AM \
           | grep -E '\.rs$' \
           | grep -vE '^crates/(engine_rules|engine_data|engine_gpu_rules)/'); do
    # Allowlist: engine has one documented exception (event_like_impl.rs) per Task 17's build.rs.
    if [ "$f" = "crates/engine/src/event_like_impl.rs" ]; then continue; fi
    # Allowlist: dsl_compiler/src/ emitters write "// GENERATED" into their output strings;
    # the marker appears in string literals inside the emitter source, not as a file header.
    if echo "$f" | grep -q "^crates/dsl_compiler/src/"; then continue; fi
    # Allowlist: dsl_compiler/tests/ smoke tests assert against the
    # `// GENERATED` header that emitters produce (via assertions
    # like `src.starts_with("// GENERATED by dsl_compiler")`). The
    # marker appears in a string literal, not as a file header —
    # same rationale as the dsl_compiler/src/ allowlist above.
    if echo "$f" | grep -q "^crates/dsl_compiler/tests/"; then continue; fi
    if grep -q "// GENERATED by dsl_compiler" "$f" 2>/dev/null; then
        echo "ABORT: $f contains // GENERATED marker but is not in a generated crate." >&2
        echo "Either move the file to engine_rules/, engine_data/, or engine_gpu_rules/, or remove the marker." >&2
        exit 1
    fi
done

# === The Spec B' §7 stale-output check (compile-dsl --check) was retired
# along with the xtask binary in the Phase 7 wolf-sim wipe (2026-05-02).
# Each runtime crate's build.rs now self-compiles its DSL source into
# OUT_DIR (ephemeral, rebuilt every `cargo build`), so there are no
# checked-in generated dirs to drift relative to .sim source. The
# `cargo check` at the top of this hook surfaces DSL parse/lower/emit
# errors via build.rs failures.

echo "[pre-commit] OK"
exit 0
